package main

import (
	"database/sql"
	"fmt"
	stdhttp "net/http"
	"os"
	"strconv"
	"time"
	_ "modernc.org/sqlite"
	orm "gpp/orm"
	http "gpp/http"
)

class PageError {
	Code int
	Message string
	Path string
}

class HomePage {
	Query string
	Listings []Listing
}

class ListingPage {
	Listing *Listing
	Seller User
}

class ListingFormPage {
	Listing *Listing
	Categories []Category
	Error string
}

class User : orm.Model @{orm.Table("users")} {
	Id int64 @{orm.Column("id"), orm.PK}
	Name string @{orm.Column("name")}
	Email string @{orm.Column("email")}
	CreatedAt string @{orm.Column("created_at")}

	func Validate(exec orm.SQLExecutor) error {
		if this.Name.Blank() {
			return fmt.Errorf("name is required")
		}
		if !this.Email.Contains("@") {
			return fmt.Errorf("a valid email is required")
		}
		return nil
	}

	func BeforeCreate(exec orm.SQLExecutor) error {
		this.Name = this.Name.TrimSpace()
		this.Email = this.Email.TrimSpace().ToLower()
		this.CreatedAt = time.Now().UTC().Format(time.RFC3339)
		return nil
	}
}

class Category : orm.Model @{orm.Table("categories")} {
	Id int64 @{orm.Column("id"), orm.PK}
	Name string @{orm.Column("name")}
	Slug string @{orm.Column("slug")}

	func Validate(exec orm.SQLExecutor) error {
		if this.Name.Blank() || this.Slug.Blank() {
			return fmt.Errorf("category name and slug are required")
		}
		return nil
	}
}

class Listing : orm.Model @{orm.Table("listings")} {
	Id int64 @{orm.Column("id"), orm.PK}
	SellerId int64 @{orm.Column("seller_id")}
	CategoryId int64 @{orm.Column("category_id")}
	Title string @{orm.Column("title")}
	Description string @{orm.Column("description")}
	Price float64 @{orm.Column("price")}
	Location string @{orm.Column("location")}
	Status string @{orm.Column("status")}
	CreatedAt string @{orm.Column("created_at")}
	UpdatedAt string @{orm.Column("updated_at")}

	func Validate(exec orm.SQLExecutor) error {
		if this.Title.Blank() {
			return fmt.Errorf("title is required")
		}
		if len(this.Title) > 120 {
			return fmt.Errorf("title must be 120 characters or fewer")
		}
		if this.Price < 0 {
			return fmt.Errorf("price cannot be negative")
		}
		if this.SellerId == 0 || this.CategoryId == 0 {
			return fmt.Errorf("seller and category are required")
		}
		return nil
	}

	func BeforeCreate(exec orm.SQLExecutor) error {
		now := time.Now().UTC().Format(time.RFC3339)
		this.Title = this.Title.TrimSpace()
		this.Location = this.Location.TrimSpace()
		this.Status = "active"
		this.CreatedAt = now
		this.UpdatedAt = now
		return nil
	}

	func BeforeUpdate(exec orm.SQLExecutor) error {
		this.Title = this.Title.TrimSpace()
		this.Location = this.Location.TrimSpace()
		this.UpdatedAt = time.Now().UTC().Format(time.RFC3339)
		return nil
	}
}

class App : http.Server @{http.IP("127.0.0.1")} {
	DB *sql.DB

	func ErrorTemplate() string {
		return "ErrorPage"
	}

	func Error(ctx *http.Context, code int, cause error) error {
		if cause != nil {
			fmt.Printf("classifieds request %s %s failed: %v\n", ctx.Request.Method, ctx.Request.URL.Path, cause)
		}
		return ctx.Template(code, "ErrorPage", PageError(Code: code, Message: stdhttp.StatusText(code), Path: ctx.Request.URL.Path))
	}

	func AfterListen() error {
		fmt.Println("classifieds listening on", this.HTTPServer.Addr)
		return nil
	}

	func errorPage(ctx *http.Context, code int, message string) error {
		return ctx.Template(code, "ErrorPage", PageError(Code: code, Message: message, Path: ctx.Request.URL.Path))
	}

	func Home(ctx *http.Context) error @{http.GET("/")} {
		query := ctx.Query("q").TrimSpace()
		where := "status = $1 ORDER BY created_at DESC"
		args := []any{"active"}
		if query != "" {
			where = "status = $1 AND (title LIKE $2 OR description LIKE $2) ORDER BY created_at DESC"
			args = []any{"active", "%%{{query}}%%"}
		}
		listings := []Listing{}
		this.DB.Select(&listings, where, args...)
		return ctx.Template("Home", HomePage(Query: query, Listings: listings))
	}

	func ShowListing(ctx *http.Context) error @{http.GET("/listings/{id}")} {
		var err error
		try {
			listing := this.listing(ctx)
			seller := User()
			this.DB.Get(&seller, "id = $1", listing.SellerId)
			err = ctx.Template("ListingDetail", ListingPage(Listing: listing, Seller: seller))
		} catch *strconv.NumError {
			err = this.errorPage(ctx, 404, "Listing not found")
		} catch e {
			if e == sql.ErrNoRows {
				err = this.errorPage(ctx, 404, "Listing not found")
			} else {
				throw
			}
		}
		return err
	}

	func NewListing(ctx *http.Context) error @{http.GET("/listings/new")} {
		categories := this.categories()
		return ctx.Template("NewListing", ListingFormPage(Categories: categories, Error: ""))
	}

	func CreateListing(ctx *http.Context) error @{http.POST("/listings")} {
		title := ctx.Request.FormValue("title").TrimSpace()
		description := ctx.Request.FormValue("description").TrimSpace()
		location := ctx.Request.FormValue("location").TrimSpace()
		price := strconv.ParseFloat(ctx.Request.FormValue("price"), 64) ?? -1
		categoryId := strconv.ParseInt(ctx.Request.FormValue("category_id"), 10, 64) ?? 0
		listing := Listing(
			Id: this.nextId(),
			SellerId: 1,
			CategoryId: categoryId,
			Title: title,
			Description: description,
			Price: price,
			Location: location,
		)
		created := false
		var err error
		try {
			this.DB.Insert(&listing)
			created = true
		} catch e {
			categories := this.categories()
			err = ctx.Template(422, "NewListing", ListingFormPage(Categories: categories, Error: e.Error()))
		}
		if !created {
			return err
		}
		ctx.Redirect("/listings/{{listing.Id}}", stdhttp.StatusSeeOther)
		return nil
	}

	func EditListing(ctx *http.Context) error @{http.GET("/listings/{id}/edit")} {
		var err error
		try {
			listing := this.listing(ctx)
			categories := this.categories()
			err = ctx.Template("EditListing", ListingFormPage(Listing: listing, Categories: categories, Error: ""))
		} catch *strconv.NumError {
			err = this.errorPage(ctx, 404, "Listing not found")
		} catch e {
			if e == sql.ErrNoRows {
				err = this.errorPage(ctx, 404, "Listing not found")
			} else {
				throw
			}
		}
		return err
	}

	func UpdateListing(ctx *http.Context) error @{http.POST("/listings/{id}/edit")} {
		var err error
		var listing *Listing
		try {
			listing = this.listing(ctx)
			listing.Title = ctx.Request.FormValue("title")
			listing.Description = ctx.Request.FormValue("description")
			listing.Location = ctx.Request.FormValue("location")
			categoryId := strconv.ParseInt(ctx.Request.FormValue("category_id"), 10, 64) ?? 0
			listing.CategoryId = categoryId
			price := -1.0
			try {
				price = strconv.ParseFloat(ctx.Request.FormValue("price"), 64)
			} catch *strconv.NumError {}
			listing.Price = price
			this.DB.Update(listing)
			ctx.Redirect("/listings/{{listing.Id}}", stdhttp.StatusSeeOther)
		} catch e {
			if listing == nil {
				throw
			}
			categories := this.categories()
			err = ctx.Template(422, "EditListing", ListingFormPage(Listing: listing, Categories: categories, Error: e.Error()))
		}
		if err != nil {
			return err
		}
		return nil
	}

	func DeleteListing(ctx *http.Context) error @{http.POST("/listings/{id}/delete")} {
		var err error
		var listing *Listing
		try {
			listing = this.listing(ctx)
			this.DB.Delete(listing)
			ctx.Redirect("/", stdhttp.StatusSeeOther)
		} catch *strconv.NumError {
			err = this.errorPage(ctx, 404, "Listing not found")
		} catch e {
			if e == sql.ErrNoRows {
				err = this.errorPage(ctx, 404, "Listing not found")
			} else {
				throw
			}
		}
		return err
	}

	func Health(ctx *http.Context) error @{http.GET("/healthz")} {
		var err error
		try {
			this.DB.Ping()
			err = ctx.JSON(record(OK: true, Service: "classifieds"))
		} catch error {
			err = ctx.JSON(503, map[string]any{"ok": false, "error": "database unavailable"})
		}
		return err
	}

	func listing(ctx *http.Context) *Listing {
		id := strconv.ParseInt(ctx.Param("id"), 10, 64)
		listing := Listing()
		this.DB.Get(&listing, "id = $1 AND status = $2", id, "active")
		return &listing
	}

	func categories() []Category {
		categories := []Category{}
		this.DB.Select(&categories, "1 = $1 ORDER BY name", 1)
		return categories
	}

	func nextId() int64 {
		try {
			row := this.DB.QueryRow("SELECT COALESCE(MAX(id), 0) + 1 FROM listings")
			var id int64
			row.Scan(&id)
			return id
		} catch error {
			return time.Now().UnixNano()
		}
	}
}

const schema = `
PRAGMA foreign_keys = ON;

CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS categories (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    slug TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS listings (
    id INTEGER PRIMARY KEY,
    seller_id INTEGER NOT NULL REFERENCES users(id),
    category_id INTEGER NOT NULL REFERENCES categories(id),
    title TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    price REAL NOT NULL,
    location TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS listings_status_created_idx ON listings(status, created_at DESC);
CREATE INDEX IF NOT EXISTS listings_category_idx ON listings(category_id);
`

func env(name string, fallback string) string {
	value := os.Getenv(name).TrimSpace()
	if value.Empty() {
		return fallback
	}
	return value
}

func openDatabase(path string) (*sql.DB, error) {
	db := sql.Open("sqlite", "{{path}}?_pragma=busy_timeout(5000)&_pragma=foreign_keys(1)")
	try {
		db.Exec(schema)
		seedDatabase(db)
	} catch error {
		db.Close()
		throw
	}
	return db, nil
}

func seedDatabase(db *sql.DB) error {
	var count int
	db.QueryRow("SELECT COUNT(*) FROM users").Scan(&count)
	if count > 0 {
		return nil
	}
	category := Category(Id: 1, Name: "Bicycles", Slug: "bicycles")
	db.Insert(&category)
	user := User(Id: 1, Name: "Demo Seller", Email: "seller@example.com")
	db.Insert(&user)
	listing := Listing(
		Id: 1,
		SellerId: 1,
		CategoryId: 1,
		Title: "Touring bicycle in excellent condition",
		Description: "Lightly used touring bicycle with rear rack and dynamo lights.",
		Price: 450,
		Location: "Bengaluru",
	)
	db.Insert(&listing)
	return nil
}

func main() {
	try {
		db := openDatabase(env("CLASSIFIEDS_DB", "classifieds.db"))
		defer db.Close()

		app := App(DB: db)
		try {
			app.Listen()
		} catch e {
			if e != stdhttp.ErrServerClosed {
				throw
			}
		}
	} catch e {
		panic(e)
	}
}
