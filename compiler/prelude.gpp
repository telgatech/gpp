package prelude

import (
	"cmp"
	"errors"
	"io"
	"math/rand"
	"regexp"
	"sort"
	"strings"
)

class Pair[A, B] {
	First A
	Second B
}

	extend []T {
	func Append(values ...T) []T {
		return append(this, values...)
	}

	func Prepend(values ...T) []T {
		result := make([]T, 0, len(values)+len(this))
		result = append(result, values...)
		return append(result, this...)
	}

	func Pop() (T, []T, bool) {
		if len(this) == 0 {
			var zero T
			return zero, this, false
		}
		lastIndex := len(this) - 1
		last := this[lastIndex]
		var zero T
		this[lastIndex] = zero
		return last, this[:lastIndex], true
	}

	func Shuffle() {
		rand.Shuffle(len(this), func(left, right int) {
			this[left], this[right] = this[right], this[left]
		})
	}

	func Sample(n int = 1) []T {
		if n <= 0 || len(this) == 0 {
			return []T{}
		}
		result := append([]T{}, this...)
		rand.Shuffle(len(result), func(left, right int) {
			result[left], result[right] = result[right], result[left]
		})
		if n < len(result) {
			return result[:n]
		}
		return result
	}

	func Each(fn func(T)) {
		for _, value := range this {
			fn(value)
		}
	}

	func Each(fn func(T) error) error {
		for _, value := range this {
			if err := fn(value); err != nil {
				return err
			}
		}
		return nil
	}

	func Any(fn func(T) bool) bool {
		for _, value := range this {
			if fn(value) {
				return true
			}
		}
		return false
	}

	func All(fn func(T) bool) bool {
		for _, value := range this {
			if !fn(value) {
				return false
			}
		}
		return true
	}

	func Find(fn func(T) bool) (T, bool) {
		for _, value := range this {
			if fn(value) {
				return value, true
			}
		}
		var zero T
		return zero, false
	}

	func Filter(fn func(T) bool) []T {
		result := []T{}
		for _, value := range this {
			if fn(value) {
				result = append(result, value)
			}
		}
		return result
	}

	func Reduce[A](initial A, fn func(A, T) A) A {
		result := initial
		for _, value := range this {
			result = fn(result, value)
		}
		return result
	}

	func FlatMap[R](fn func(T) []R) []R {
		result := []R{}
		for _, value := range this {
			result = append(result, fn(value)...)
		}
		return result
	}

	func Partition(predicate func(T) bool) ([]T, []T) {
		matched := []T{}
		unmatched := []T{}
		for _, value := range this {
			if predicate(value) {
				matched = append(matched, value)
			} else {
				unmatched = append(unmatched, value)
			}
		}
		return matched, unmatched
	}

	func GroupBy[K comparable](key func(T) K) [][]T {
		groups := [][]T{}
		var previousKey K
		hasGroup := false
		for _, value := range this {
			currentKey := key(value)
			if !hasGroup || currentKey != previousKey {
				groups = append(groups, []T{})
				previousKey = currentKey
				hasGroup = true
			}
			last := len(groups) - 1
			groups[last] = append(groups[last], value)
		}
		return groups
	}

	func Zip[U](other []U) []Pair[T, U] {
		length := len(this)
		if len(other) < length {
			length = len(other)
		}
		result := make([]Pair[T, U], 0, length)
		for index := 0; index < length; index++ {
			result = append(result, Pair[T, U](First: this[index], Second: other[index]))
		}
		return result
	}

	func ZipWith[U, R](other []U, fn func(T, U) R) []R {
		length := len(this)
		if len(other) < length {
			length = len(other)
		}
		result := make([]R, 0, length)
		for index := 0; index < length; index++ {
			result = append(result, fn(this[index], other[index]))
		}
		return result
	}

	func TakeWhile(predicate func(T) bool) []T {
		end := 0
		for end < len(this) && predicate(this[end]) {
			end++
		}
		return append([]T{}, this[:end]...)
	}

	func DropWhile(predicate func(T) bool) []T {
		start := 0
		for start < len(this) && predicate(this[start]) {
			start++
		}
		return append([]T{}, this[start:]...)
	}

	func Scan[A](initial A, fn func(A, T) A) []A {
		result := make([]A, 1, len(this)+1)
		result[0] = initial
		for _, value := range this {
			result = append(result, fn(result[len(result)-1], value))
		}
		return result
	}

	func DeleteBy(predicate func(T) bool) []T {
		result := make([]T, 0, len(this))
		for _, value := range this {
			if !predicate(value) {
				result = append(result, value)
			}
		}
		return result
	}

	func First() T {
		if len(this) == 0 {
			var zero T
			return zero
		}
		return this[0]
	}

	func Last() T {
		if len(this) == 0 {
			var zero T
			return zero
		}
		return this[len(this)-1]
	}

	func IsEmpty() bool {
		return len(this) == 0
	}

	func NotEmpty() bool {
		return len(this) != 0
	}

	func Take(n int) []T {
		if n <= 0 {
			return []T{}
		}
		if n >= len(this) {
			return append([]T{}, this...)
		}
		return append([]T{}, this[:n]...)
	}

	func Drop(n int) []T {
		if n <= 0 {
			return append([]T{}, this...)
		}
		if n >= len(this) {
			return []T{}
		}
		return append([]T{}, this[n:]...)
	}

	func Map[R](fn func(T) R) []R {
		result := make([]R, 0, len(this))
		for _, value := range this {
			result = append(result, fn(value))
		}
		return result
	}

	func Reverse() {
		for left, right := 0, len(this)-1; left < right; left, right = left+1, right-1 {
			this[left], this[right] = this[right], this[left]
		}
	}

	func Sort(less func(T, T) bool) {
		sort.Slice(this, func(left, right int) bool {
			return less(this[left], this[right])
		})
	}

	func SortBy[K cmp.Ordered](key func(T) K) {
		sort.Slice(this, func(left, right int) bool {
			return key(this[left]) < key(this[right])
		})
	}

	func ReverseBy[K cmp.Ordered](key func(T) K) {
		sort.Slice(this, func(left, right int) bool {
			return key(this[left]) > key(this[right])
		})
	}
}

extend []T where T comparable {
	func Contains(value T) bool {
		for _, candidate := range this {
			if candidate == value {
				return true
			}
		}
		return false
	}

	func Index(value T) int {
		for index, candidate := range this {
			if candidate == value {
				return index
			}
		}
		return -1
	}

	func Unique() []T {
		seen := map[T]struct{}{}
		result := make([]T, 0, len(this))
		for _, value := range this {
			if _, exists := seen[value]; exists {
				continue
			}
			seen[value] = struct{}{}
			result = append(result, value)
		}
		return result
	}
}

extend []T where T cmp.Ordered {
	func Sort() {
		sort.Slice(this, func(left, right int) bool {
			return this[left] < this[right]
		})
	}

	func SortDesc() {
		sort.Slice(this, func(left, right int) bool {
			return this[left] > this[right]
		})
	}

	func Min() (T, bool) {
		if len(this) == 0 {
			var zero T
			return zero, false
		}
		result := this[0]
		for _, value := range this[1:] {
			if value < result {
				result = value
			}
		}
		return result, true
	}

	func Max() (T, bool) {
		if len(this) == 0 {
			var zero T
			return zero, false
		}
		result := this[0]
		for _, value := range this[1:] {
			if value > result {
				result = value
			}
		}
		return result, true
	}
}

extend string {
	func CompileRegex() (*regexp.Regexp, error) {
		value, err := regexp.Compile(this)
		return value, err
	}

	func Trim(cutset string) string {
		return strings.Trim(this, cutset)
	}

	func TrimLeft(cutset string) string {
		return strings.TrimLeft(this, cutset)
	}

	func TrimRight(cutset string) string {
		return strings.TrimRight(this, cutset)
	}

	func TrimSpace() string {
		return strings.TrimSpace(this)
	}

	func ToLower() string {
		return strings.ToLower(this)
	}

	func ToUpper() string {
		return strings.ToUpper(this)
	}

	func Contains(substr string) bool {
		return strings.Contains(this, substr)
	}

	func HasPrefix(prefix string) bool {
		return strings.HasPrefix(this, prefix)
	}

	func HasSuffix(suffix string) bool {
		return strings.HasSuffix(this, suffix)
	}

	func Replace(old string, new string, n int) string {
		return strings.Replace(this, old, new, n)
	}

	func ReplaceAll(old string, new string) string {
		return strings.ReplaceAll(this, old, new)
	}

	func Split(sep string) []string {
		return strings.Split(this, sep)
	}

	func Fields() []string {
		return strings.Fields(this)
	}

	func Index(substr string) int {
		return strings.Index(this, substr)
	}

	func LastIndex(substr string) int {
		return strings.LastIndex(this, substr)
	}

	func Count(substr string) int {
		return strings.Count(this, substr)
	}

	func Repeat(count int) string {
		return strings.Repeat(this, count)
	}

	func EqualFold(other string) bool {
		return strings.EqualFold(this, other)
	}

	func IsBlank() bool {
		return len(strings.TrimSpace(this)) == 0
	}

	func Empty() bool {
		return len(this) == 0
	}

	func Blank() bool {
		return len(strings.TrimSpace(this)) == 0
	}

	func Lines() []string {
		value := strings.ReplaceAll(this, "\r\n", "\n")
		value = strings.ReplaceAll(value, "\r", "\n")
		return strings.Split(value, "\n")
	}

	func Words() []string {
		return strings.Fields(this)
	}
}

extend map[K]V {
	func Keys() []K {
		result := make([]K, 0, len(this))
		for key := range this {
			result = append(result, key)
		}
		return result
	}

	func Values() []V {
		result := make([]V, 0, len(this))
		for _, value := range this {
			result = append(result, value)
		}
		return result
	}

	func Has(key K) bool {
		_, ok := this[key]
		return ok
	}

	func GetOr(key K, fallback V) V {
		value, ok := this[key]
		if !ok {
			return fallback
		}
		return value
	}

	func IsEmpty() bool {
		return len(this) == 0
	}

	func NotEmpty() bool {
		return len(this) != 0
	}

	func Clone() map[K]V {
		result := make(map[K]V, len(this))
		for key, value := range this {
			result[key] = value
		}
		return result
	}
}

extend error {
	func Is(target error) bool {
		return errors.Is(this, target)
	}

	func Unwrap() error {
		return errors.Unwrap(this)
	}

	func As[T any]() T {
		var target T
		errors.As(this, &target)
		return target
	}
}

extend io.Reader {
	func ReadAll() ([]byte, error) {
		value, err := io.ReadAll(this)
		return value, err
	}
}

extend io.Writer {
	func WriteString(value string) (int, error) {
		count, err := io.WriteString(this, value)
		return count, err
	}
}
