package gpp.http

import (
	stdjson "encoding/json"
	"fmt"
	stdFS "io/fs"
	stdhttp "net/http"
	"reflect"
	"sort"
	"strings"
)

embed (
	// Swagger UI 5.11.10, vendored for offline single-binary serving.
	swaggerFiles "assets/swagger/"
)

type gppOpenAPIRoute struct {
	Path    string
	Method  string
	Handler string
}

var gppOpenAPIRouteAnnotations = []struct {
	Name   string
	Method string
}{
	{Name: "gpp.http.GET", Method: "GET"},
	{Name: "gpp.http.POST", Method: "POST"},
	{Name: "gpp.http.PUT", Method: "PUT"},
	{Name: "gpp.http.PATCH", Method: "PATCH"},
	{Name: "gpp.http.DELETE", Method: "DELETE"},
}

func gppOpenAPIAnnotationPath(owner any, name string) string {
	arguments := gppAnnotationArgs(owner, name)
	if len(arguments) == 0 {
		return ""
	}
	return strings.TrimSpace(fmt.Sprint(arguments[0]))
}

func gppOpenAPIJoinPath(prefix, routePath string) string {
	if prefix == "" {
		return routePath
	}
	return strings.TrimRight(prefix, "/") + "/" + strings.TrimLeft(routePath, "/")
}

func gppOpenAPIRoutes(descriptor any, prefix string) []gppOpenAPIRoute {
	value := gppOpenAPIDeref(reflect.ValueOf(descriptor))
	if !value.IsValid() {
		return nil
	}
	methods := value.FieldByName("Methods")
	if !methods.IsValid() || methods.Kind() != reflect.Slice {
		return nil
	}
	result := []gppOpenAPIRoute{}
	for index := 0; index < methods.Len(); index++ {
		method := methods.Index(index)
		name := gppOpenAPIStringField(method, "Name")
		for _, route := range gppOpenAPIRouteAnnotations {
			arguments := gppAnnotationArgs(method.Interface(), route.Name)
			if len(arguments) == 0 {
				continue
			}
			path := strings.TrimSpace(fmt.Sprint(arguments[0]))
			if path == "" {
				continue
			}
			result = append(result, gppOpenAPIRoute{
				Path:    gppOpenAPIJoinPath(prefix, path),
				Method:  route.Method,
				Handler: name,
			})
		}
	}
	sort.Slice(result, func(left, right int) bool {
		if result[left].Path != result[right].Path {
			return result[left].Path < result[right].Path
		}
		if result[left].Method != result[right].Method {
			return result[left].Method < result[right].Method
		}
		return result[left].Handler < result[right].Handler
	})
	return result
}

func gppOpenAPIHasRoute(routes []gppOpenAPIRoute, method, path string) bool {
	for _, route := range routes {
		if route.Method == method && route.Path == path {
			return true
		}
	}
	return false
}

func gppOpenAPIPathOwnedByMount(path, mount string) bool {
	path = strings.TrimRight(path, "/")
	mount = strings.TrimRight(mount, "/")
	if path == "" {
		path = "/"
	}
	if mount == "" {
		mount = "/"
	}
	return path == mount || (mount != "/" && strings.HasPrefix(path, mount+"/"))
}

func gppOpenAPIHasRouteUnderMount(routes []gppOpenAPIRoute, mount string) bool {
	for _, route := range routes {
		if route.Path == strings.TrimRight(mount, "/") && route.Method == "GET" {
			return true
		}
		if route.Path != strings.TrimRight(mount, "/") && gppOpenAPIPathOwnedByMount(route.Path, mount) {
			return true
		}
	}
	return false
}

func gppOpenAPIIsJSONMediaType(value any) bool {
	contentType := strings.ToLower(strings.TrimSpace(fmt.Sprint(value)))
	if separator := strings.Index(contentType, ";"); separator >= 0 {
		contentType = strings.TrimSpace(contentType[:separator])
	}
	return contentType == "application/json" || strings.HasSuffix(contentType, "+json")
}

func gppOpenAPIHasJSONContract(descriptor any, handlerName string) bool {
	method := gppOpenAPIMethodDescriptor(descriptor, handlerName)
	if !method.IsValid() {
		return false
	}
	for _, annotation := range gppAnnotationValues(method.Interface(), "gpp.http.RequestBody") {
		if len(annotation) > 0 && gppOpenAPIIsJSONMediaType(annotation[0]) {
			return true
		}
	}
	for _, annotation := range gppAnnotationValues(method.Interface(), "gpp.http.ResponseBody") {
		if len(annotation) > 2 && gppOpenAPIIsJSONMediaType(annotation[2]) {
			return true
		}
	}
	return false
}

func gppSwaggerMountPath(path string) string {
	path = strings.TrimRight(strings.TrimSpace(path), "/")
	if path == "" {
		return "/"
	}
	if !strings.HasPrefix(path, "/") {
		return "/" + path
	}
	return path
}

func gppRegisterOpenAPIRoutes(mux *stdhttp.ServeMux, app any, descriptor any, prefix string) error {
	hasOpenAPI := len(gppAnnotationArgs(descriptor, "gpp.http.OpenAPI")) > 0
	hasSwagger := len(gppAnnotationArgs(descriptor, "gpp.http.Swagger")) > 0
	openAPIPath := gppOpenAPIAnnotationPath(descriptor, "gpp.http.OpenAPI")
	swaggerPath := gppOpenAPIAnnotationPath(descriptor, "gpp.http.Swagger")
	if !hasOpenAPI && !hasSwagger {
		return nil
	}
	if hasOpenAPI && openAPIPath == "" {
		return fmt.Errorf("http.OpenAPI path must not be empty")
	}
	if hasSwagger && swaggerPath == "" {
		return fmt.Errorf("http.Swagger path must not be empty")
	}
	if hasSwagger && !hasOpenAPI {
		return fmt.Errorf("http.Swagger requires http.OpenAPI")
	}
	if hasOpenAPI && !strings.HasPrefix(openAPIPath, "/") {
		return fmt.Errorf("http.OpenAPI path must start with /")
	}
	if hasSwagger && !strings.HasPrefix(swaggerPath, "/") {
		return fmt.Errorf("http.Swagger path must start with /")
	}

	routes := gppOpenAPIRoutes(descriptor, prefix)
	openAPIPath = gppOpenAPIJoinPath(prefix, openAPIPath)
	swaggerPath = gppSwaggerMountPath(gppOpenAPIJoinPath(prefix, swaggerPath))
	if hasOpenAPI && gppOpenAPIHasRoute(routes, "GET", openAPIPath) {
		return fmt.Errorf("GET %s conflicts with http.OpenAPI", openAPIPath)
	}
	if hasSwagger && gppOpenAPIHasRouteUnderMount(routes, swaggerPath) {
		return fmt.Errorf("GET %s conflicts with http.Swagger", swaggerPath)
	}
	if hasSwagger && gppOpenAPIPathOwnedByMount(openAPIPath, swaggerPath) {
		return fmt.Errorf("http.OpenAPI route %s conflicts with http.Swagger mount %s", openAPIPath, swaggerPath)
	}
	if hasOpenAPI && hasSwagger && gppOpenAPIPathOwnedByMount(swaggerPath, openAPIPath) {
		return fmt.Errorf("http.Swagger route %s conflicts with http.OpenAPI", swaggerPath)
	}

	document, err := gppBuildOpenAPIDocument(app, descriptor, prefix)
	if err != nil {
		return err
	}
	if hasOpenAPI {
		payload := append([]byte(nil), document...)
		if err := gppRegisterGeneratedGET(mux, app, openAPIPath, func(ctx *Context) error {
			ctx.Response.Header().Set("Content-Type", "application/json")
			if !ctx.Written {
				ctx.Response.WriteHeader(stdhttp.StatusOK)
				ctx.Status = stdhttp.StatusOK
				ctx.Written = true
			}
			_, err := ctx.Response.Write(payload)
			return err
		}); err != nil { return err }
	}
	if hasSwagger {
		payload := gppSwaggerPage(openAPIPath, swaggerPath)
		if err := gppRegisterGeneratedGET(mux, app, swaggerPath, func(ctx *Context) error {
			ctx.Response.Header().Set("Content-Type", "text/html; charset=utf-8")
			if !ctx.Written {
				ctx.Response.WriteHeader(stdhttp.StatusOK)
				ctx.Status = stdhttp.StatusOK
				ctx.Written = true
			}
			_, err := ctx.Response.Write(payload)
			return err
		}); err != nil { return err }
		if swaggerPath != "/" {
			if err := gppRegisterGeneratedGET(mux, app, swaggerPath+"/", func(ctx *Context) error {
				ctx.Response.Header().Set("Content-Type", "text/html; charset=utf-8")
				if !ctx.Written {
					ctx.Response.WriteHeader(stdhttp.StatusOK)
					ctx.Status = stdhttp.StatusOK
					ctx.Written = true
				}
				_, err := ctx.Response.Write(payload)
				return err
			}); err != nil { return err }
		}
		for _, asset := range gppSwaggerAssetDefinitions {
			asset := asset
			assetPath := strings.TrimRight(swaggerPath, "/") + "/" + asset.Name
			if err := gppRegisterGeneratedGET(mux, app, assetPath, func(ctx *Context) error {
				data, err := stdFS.ReadFile(swaggerFiles, asset.Name)
				if err != nil {
					return err
				}
				ctx.Response.Header().Set("Content-Type", asset.ContentType)
				ctx.Response.Header().Set("Cache-Control", "public, max-age=31536000, immutable")
				if !ctx.Written {
					ctx.Response.WriteHeader(stdhttp.StatusOK)
					ctx.Status = stdhttp.StatusOK
					ctx.Written = true
				}
				_, err = ctx.Response.Write(data)
				return err
			}); err != nil { return err }
		}
	}
	return nil
}

func gppRegisterGeneratedGET(mux *stdhttp.ServeMux, app any, path string, handler func(*Context) error) error {
	return gppRegisterMuxHandler(mux, "GET "+path, func(w stdhttp.ResponseWriter, r *stdhttp.Request) {
		if r.Method != stdhttp.MethodGet {
			w.WriteHeader(stdhttp.StatusMethodNotAllowed)
			return
		}
		ctx := Context(Response: w, Request: r, Values: map[string]any{})
		if err := gppCallHook(app, "BeforeRequest", ctx); err != nil {
			gppCallError(app, ctx, stdhttp.StatusInternalServerError, err)
			return
		}
		routeErr := handler(ctx)
		afterErr := gppCallHook(app, "AfterRequest", ctx)
		if routeErr != nil && !ctx.Written {
			gppCallError(app, ctx, stdhttp.StatusInternalServerError, routeErr)
			return
		}
		if afterErr != nil && !ctx.Written {
			gppCallError(app, ctx, stdhttp.StatusInternalServerError, afterErr)
		}
	})
}

func gppBuildOpenAPIDocument(app any, descriptor any, prefix string) ([]byte, error) {
	schemas := map[string]any{}
	paths := map[string]any{}
	usedOperationIDs := map[string]bool{}
	for _, route := range gppOpenAPIRoutes(descriptor, prefix) {
		if !gppOpenAPIHasJSONContract(descriptor, route.Handler) {
			continue
		}
		operation, err := gppOpenAPIOperation(app, descriptor, route, schemas, usedOperationIDs)
		if err != nil {
			return nil, err
		}
		pathItem, ok := paths[route.Path].(map[string]any)
		if !ok {
			pathItem = map[string]any{}
			paths[route.Path] = pathItem
		}
		pathItem[strings.ToLower(route.Method)] = operation
	}

	name := gppOpenAPIDescriptorName(descriptor)
	if name == "" {
		name = "Go++"
	}
	document := map[string]any{
		"openapi": "3.0.3",
		"info": map[string]any{
			"title":   name + " API",
			"version": "0.0.0",
		},
		"paths": paths,
	}
	if len(schemas) > 0 {
		document["components"] = map[string]any{"schemas": schemas}
	}
	return stdjson.MarshalIndent(document, "", "  ")
}

func gppOpenAPIOperation(app any, descriptor any, route gppOpenAPIRoute, schemas map[string]any, usedOperationIDs map[string]bool) (map[string]any, error) {
	operationID := route.Handler
	if operationID == "" {
		operationID = strings.ToLower(route.Method) + "_operation"
	}
	if usedOperationIDs[operationID] {
		operationID += "_" + strings.ToLower(route.Method)
	}
	for usedOperationIDs[operationID] {
		operationID += "_2"
	}
	usedOperationIDs[operationID] = true

	operation := map[string]any{
		"operationId": operationID,
	}
	method := gppOpenAPIMethodDescriptor(descriptor, route.Handler)
	if method.IsValid() {
		if arguments := gppAnnotationArgs(method.Interface(), "gpp.http.Summary"); len(arguments) > 0 {
			operation["summary"] = strings.TrimSpace(fmt.Sprint(arguments[0]))
		}
		if arguments := gppAnnotationArgs(method.Interface(), "gpp.http.Description"); len(arguments) > 0 {
			operation["description"] = strings.TrimSpace(fmt.Sprint(arguments[0]))
		}
		tags := []string{}
		for _, annotation := range gppAnnotationValues(method.Interface(), "gpp.http.Tags") {
			for _, argument := range annotation {
				name := strings.TrimSpace(fmt.Sprint(argument))
				if name != "" && name != "<nil>" {
					tags = append(tags, name)
				}
			}
		}
		if len(tags) > 0 {
			operation["tags"] = tags
		}
	}
	responses := map[string]any{}
	if method.IsValid() {
		for _, annotation := range gppAnnotationValues(method.Interface(), "gpp.http.ResponseBody") {
			if len(annotation) < 4 {
				continue
			}
			status := gppOpenAPIInteger(annotation[0])
			if status < 100 || status > 599 {
				continue
			}
			response := map[string]any{"description": strings.TrimSpace(fmt.Sprint(annotation[1]))}
			contentType := strings.TrimSpace(fmt.Sprint(annotation[2]))
			example := annotation[3]
			if example != nil && contentType != "" {
				response["content"] = map[string]any{
					contentType: map[string]any{
						"schema":  gppOpenAPISchemaForReflectType(reflect.TypeOf(example), schemas),
						"example": example,
					},
				}
			}
			responses[fmt.Sprint(status)] = response
		}
	}
	if len(responses) == 0 {
		responses["200"] = map[string]any{"description": "Successful response"}
		if method.IsValid() {
			resultType := gppOpenAPIResultType(app, route.Handler)
			if resultType != nil {
				response := responses["200"].(map[string]any)
				response["content"] = map[string]any{"application/json": map[string]any{
					"schema": gppOpenAPISchemaForReflectType(resultType, schemas),
				}}
			}
		}
	}
	operation["responses"] = responses

	parameters := []any{}
	boundPathParameters := map[string]bool{}
	bodyParameter := map[string]any(nil)
	if method.IsValid() {
		parameterValues := method.FieldByName("Parameters")
		for index := 0; index < parameterValues.Len(); index++ {
			parameter := parameterValues.Index(index)
			name := gppOpenAPIStringField(parameter, "Name")
			typeName := gppOpenAPITypeName(parameter.FieldByName("Type"))
			if name == "" || strings.EqualFold(name, "ctx") || strings.Contains(typeName, "Context") {
				continue
			}
			schema := gppOpenAPISchemaForTypeName(typeName, schemas)
			if gppOpenAPIPathParameter(route.Path, name) {
				parameters = append(parameters, map[string]any{
					"name":     name,
					"in":       "path",
					"required": true,
					"schema":   schema,
				})
				boundPathParameters[name] = true
				continue
			}
			if route.Method == "GET" || route.Method == "DELETE" {
				parameters = append(parameters, map[string]any{
					"name":     name,
					"in":       "query",
					"required": false,
					"schema":   schema,
				})
				continue
			}
			bodyParameter = map[string]any{"content": map[string]any{
				"application/json": map[string]any{"schema": schema},
			}}
		}
	}
	for _, name := range gppOpenAPIPathParameters(route.Path) {
		if boundPathParameters[name] {
			continue
		}
		parameters = append(parameters, map[string]any{
			"name":     name,
			"in":       "path",
			"required": true,
			"schema":   map[string]any{"type": "string"},
		})
	}
	if len(parameters) > 0 {
		operation["parameters"] = parameters
	}
	requestBody := bodyParameter
	if method.IsValid() {
		if arguments := gppAnnotationArgs(method.Interface(), "gpp.http.RequestBody"); len(arguments) >= 3 {
			contentType := strings.TrimSpace(fmt.Sprint(arguments[0]))
			description := strings.TrimSpace(fmt.Sprint(arguments[1]))
			example := arguments[2]
			if contentType != "" && example != nil {
				requestBody = map[string]any{
					"description": description,
					"required":   true,
					"content": map[string]any{
						contentType: map[string]any{
							"schema":  gppOpenAPISchemaForReflectType(reflect.TypeOf(example), schemas),
							"example": example,
						},
					},
				}
			}
		}
	}
	if requestBody != nil {
		operation["requestBody"] = requestBody
	}

	return operation, nil
}

func gppOpenAPIInteger(value any) int {
	if value == nil {
		return 0
	}
	reflected := reflect.ValueOf(value)
	switch reflected.Kind() {
	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
		return int(reflected.Int())
	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
		return int(reflected.Uint())
	default:
		return 0
	}
}

func gppOpenAPIPathParameter(path, name string) bool {
	for _, value := range gppOpenAPIPathParameters(path) {
		if value == name {
			return true
		}
	}
	return false
}

func gppOpenAPIPathParameters(path string) []string {
	result := []string{}
	for index := 0; index < len(path); {
		start := strings.Index(path[index:], "{")
		if start < 0 {
			break
		}
		start += index
		end := strings.Index(path[start+1:], "}")
		if end < 0 {
			break
		}
		name := strings.TrimSpace(path[start+1 : start+1+end])
		if name != "" {
			result = append(result, name)
		}
		index = start + end + 2
	}
	return result
}

func gppOpenAPIMethodDescriptor(descriptor any, name string) reflect.Value {
	value := gppOpenAPIDeref(reflect.ValueOf(descriptor))
	if !value.IsValid() {
		return reflect.Value{}
	}
	methods := value.FieldByName("Methods")
	if !methods.IsValid() || methods.Kind() != reflect.Slice {
		return reflect.Value{}
	}
	for index := 0; index < methods.Len(); index++ {
		method := methods.Index(index)
		if gppOpenAPIStringField(method, "Name") == name {
			return method
		}
	}
	return reflect.Value{}
}

func gppOpenAPIResultType(app any, methodName string) reflect.Type {
	method := reflect.ValueOf(app).MethodByName(methodName)
	if !method.IsValid() {
		return nil
	}
	typeOfMethod := method.Type()
	for index := 0; index < typeOfMethod.NumOut(); index++ {
		candidate := typeOfMethod.Out(index)
		if candidate.Implements(reflect.TypeOf((*error)(nil)).Elem()) {
			continue
		}
		return candidate
	}
	return nil
}

func gppOpenAPITypeName(value reflect.Value) string {
	value = gppOpenAPIDeref(value)
	if !value.IsValid() {
		return ""
	}
	name := value.FieldByName("Name")
	if !name.IsValid() || name.Kind() != reflect.String {
		return ""
	}
	return name.String()
}

func gppOpenAPIStringField(value reflect.Value, name string) string {
	value = gppOpenAPIDeref(value)
	if !value.IsValid() {
		return ""
	}
	field := value.FieldByName(name)
	if !field.IsValid() || field.Kind() != reflect.String {
		return ""
	}
	return field.String()
}

func gppOpenAPIDescriptorName(descriptor any) string {
	return gppOpenAPIStringField(reflect.ValueOf(descriptor), "Name")
}

func gppOpenAPIDeref(value reflect.Value) reflect.Value {
	for value.IsValid() && (value.Kind() == reflect.Pointer || value.Kind() == reflect.Interface) {
		if value.IsNil() {
			return reflect.Value{}
		}
		value = value.Elem()
	}
	return value
}

func gppOpenAPISchemaForTypeName(typeName string, schemas map[string]any) map[string]any {
	typeName = strings.TrimSpace(strings.TrimPrefix(typeName, "*"))
	if strings.HasPrefix(typeName, "[]") {
		return map[string]any{"type": "array", "items": gppOpenAPISchemaForTypeName(typeName[2:], schemas)}
	}
	if strings.HasPrefix(typeName, "map[string]") {
		return map[string]any{"type": "object", "additionalProperties": gppOpenAPISchemaForTypeName(typeName[len("map[string]"):], schemas)}
	}
	switch typeName {
	case "string", "rune", "byte":
		return map[string]any{"type": "string"}
	case "bool":
		return map[string]any{"type": "boolean"}
	case "int", "int8", "int16", "int32", "int64", "uint", "uint8", "uint16", "uint32", "uint64", "uintptr":
		return map[string]any{"type": "integer"}
	case "float32", "float64":
		return map[string]any{"type": "number"}
	case "any", "interface{}", "error", "":
		return map[string]any{}
	case "time.Time":
		return map[string]any{"type": "string", "format": "date-time"}
	}
	if strings.HasPrefix(typeName, "__gpp_record_") {
		return map[string]any{"type": "object"}
	}
	name := typeName
	if dot := strings.LastIndex(name, "."); dot >= 0 {
		name = name[dot+1:]
	}
	return map[string]any{"$ref": "#/components/schemas/" + name}
}

func gppOpenAPISchemaForReflectType(typeOf reflect.Type, schemas map[string]any) map[string]any {
	if typeOf == nil {
		return map[string]any{}
	}
	for typeOf.Kind() == reflect.Pointer {
		typeOf = typeOf.Elem()
	}
	if typeOf == reflect.TypeOf((*any)(nil)).Elem() {
		return map[string]any{}
	}
	if typeOf.PkgPath() == "time" && typeOf.Name() == "Time" {
		return map[string]any{"type": "string", "format": "date-time"}
	}
	switch typeOf.Kind() {
	case reflect.String:
		return map[string]any{"type": "string"}
	case reflect.Bool:
		return map[string]any{"type": "boolean"}
	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
		return map[string]any{"type": "integer"}
	case reflect.Float32, reflect.Float64:
		return map[string]any{"type": "number"}
	case reflect.Slice:
		if typeOf.Elem().Kind() == reflect.Uint8 {
			return map[string]any{"type": "string", "format": "byte"}
		}
		return map[string]any{"type": "array", "items": gppOpenAPISchemaForReflectType(typeOf.Elem(), schemas)}
	case reflect.Map:
		if typeOf.Key().Kind() == reflect.String {
			return map[string]any{"type": "object", "additionalProperties": gppOpenAPISchemaForReflectType(typeOf.Elem(), schemas)}
		}
		return map[string]any{}
	case reflect.Interface:
		return map[string]any{}
	case reflect.Struct:
		name := typeOf.Name()
		if strings.HasPrefix(name, "__gpp_record_") {
			name = "Record"
		}
		if name == "" {
			name = "Anonymous"
		}
		if _, exists := schemas[name]; exists {
			return map[string]any{"$ref": "#/components/schemas/" + name}
		}
		schema := map[string]any{"type": "object", "properties": map[string]any{}}
		schemas[name] = schema
		properties := schema["properties"].(map[string]any)
		gppOpenAPIAddReflectProperties(typeOf, properties, schemas, map[reflect.Type]bool{})
		return map[string]any{"$ref": "#/components/schemas/" + name}
	default:
		return map[string]any{}
	}
}

func gppOpenAPIAddReflectProperties(typeOf reflect.Type, properties map[string]any, schemas map[string]any, active map[reflect.Type]bool) {
	if active[typeOf] {
		return
	}
	active[typeOf] = true
	defer delete(active, typeOf)
	for index := 0; index < typeOf.NumField(); index++ {
		field := typeOf.Field(index)
		if field.PkgPath != "" {
			continue
		}
		tag := field.Tag.Get("json")
		parts := strings.Split(tag, ",")
		fieldName := parts[0]
		if fieldName == "-" {
			continue
		}
		if field.Anonymous && fieldName == "" {
			embedded := field.Type
			for embedded.Kind() == reflect.Pointer {
				embedded = embedded.Elem()
			}
			if embedded.Kind() == reflect.Struct {
				gppOpenAPIAddReflectProperties(embedded, properties, schemas, active)
				continue
			}
		}
		if fieldName == "" {
			fieldName = field.Name
		}
		properties[fieldName] = gppOpenAPISchemaForReflectType(field.Type, schemas)
	}
}

type gppSwaggerAsset struct {
	Name        string
	ContentType string
}

var gppSwaggerAssetDefinitions = []gppSwaggerAsset{
	{Name: "swagger-ui.css", ContentType: "text/css; charset=utf-8"},
	{Name: "swagger-ui-bundle.js", ContentType: "text/javascript; charset=utf-8"},
	{Name: "swagger-ui-standalone-preset.js", ContentType: "text/javascript; charset=utf-8"},
	{Name: "favicon-16x16.png", ContentType: "image/png"},
	{Name: "favicon-32x32.png", ContentType: "image/png"},
}

func gppSwaggerPage(openAPIPath, swaggerPath string) []byte {
	root := strings.TrimRight(swaggerPath, "/")
	if root == "" {
		root = "/"
	}
	assetURL := func(name string) string {
		return strings.TrimRight(root, "/") + "/" + name
	}
	return []byte(fmt.Sprintf(
		gppSwaggerHTML,
		fmt.Sprintf("%q", assetURL("swagger-ui.css")),
		fmt.Sprintf("%q", assetURL("favicon-32x32.png")),
		fmt.Sprintf("%q", assetURL("swagger-ui-bundle.js")),
		fmt.Sprintf("%q", assetURL("swagger-ui-standalone-preset.js")),
		fmt.Sprintf("%q", openAPIPath),
	))
}

const gppSwaggerHTML = `<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Swagger UI</title><link rel="stylesheet" href=%s><link rel="icon" type="image/png" href=%s></head>
<body><div id="swagger-ui"></div>
<script src=%s></script><script src=%s></script>
<script>
window.onload=function() {
  window.ui=SwaggerUIBundle({
    url:%s,
    dom_id:"#swagger-ui",
    deepLinking:true,
    presets:[SwaggerUIBundle.presets.apis,SwaggerUIStandalonePreset],
    plugins:[SwaggerUIBundle.plugins.DownloadUrl],
    layout:"StandaloneLayout"
  });
};
</script></body></html>`
