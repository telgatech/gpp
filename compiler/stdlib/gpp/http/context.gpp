package gpp.http

import (
	"bytes"
	"encoding/json"
	"fmt"
	htmltemplate "html/template"
	"mime"
	stdhttp "net/http"
	"strconv"
	"strings"
	"golang.org/x/net/websocket"
	std "gpp/std"
	tpl "gpp/tpl"
)

// Context provides request data and response helpers to an HTTP handler.
class Context {
	Response stdhttp.ResponseWriter
	Request *stdhttp.Request
	Values map[string]any
	Data map[string]any
	Status int
	Written bool
	Conn *websocket.Conn
	SSE *SSEStream
	TemplateScope string
	Templates *htmltemplate.Template

	// Set stores a value for use by other handlers during the same request.
	func Set(name string, value any) {
		if this.Values == nil {
			this.Values = map[string]any{}
		}
		this.Values[name] = value
	}

	// Get returns a value previously stored on this request context.
	func Get(name string) any {
		return this.Values[name]
	}

	// Param returns the named wildcard path value for this request.
	func Param(name string) string {
		return this.Request.PathValue(name)
	}

	// Query returns the first URL query value with the given name.
	func Query(name string) string {
		return this.Request.URL.Query().Get(name)
	}

	// Bind decodes the request body according to its Content-Type.
	func Bind(target any) error {
		return gppBindRequest(this.Request, this.Response, target)
	}

	func BindQuery(target any) error {
		return gppBindValues(this.Request.URL.Query(), target, "query")
	}

	// BindJSON decodes a JSON request body into target.
	func BindJSON(target any) error {
		return gppBindJSON(this.Request, this.Response, target)
	}

	// BindForm decodes form fields into target.
	func BindForm(target any) error {
		return gppBindForm(this.Request, this.Response, target)
	}

	func commit(status int, contentType string, body []byte) error {
		if this.SSE != nil && this.SSE.Started {
			return fmt.Errorf("http: cannot replace an active SSE response")
		}
		if !this.Written {
			this.Response.Header().Set("Content-Type", contentType)
			this.Response.WriteHeader(status)
			this.Status = status
			this.Written = true
		}
		_, err := this.Response.Write(body)
		return err
	}

	// Text writes value as a plain-text response with status 200.
	func Text(value string) error {
		return this.commit(200, "text/plain; charset=utf-8", []byte(value))
	}

	func Text(status int, value string) error {
		return this.commit(status, "text/plain; charset=utf-8", []byte(value))
	}

	// JSON encodes value as a JSON response with status 200.
	func JSON(value any) error {
		return this.JSON(200, value)
	}

	func JSON(status int, value any) error {
		var body bytes.Buffer
		if err := json.NewEncoder(&body).Encode(value); err != nil {
			return err
		}
		return this.commit(status, "application/json", body.Bytes())
	}

	// Respond negotiates HTML or JSON from the request's Accept header. JSON is
	// the default when either format is acceptable; unsupported formats get 406.
	func Respond(status int, data any) error {
		gppHTTPVaryAccept(this.Response.Header())
		accept := this.Request.Header.Get("Accept")
		jsonPreference := gppHTTPAcceptPreferenceFor(accept, "application/json")
		htmlPreference := gppHTTPAcceptPreferenceFor(accept, "text/html")
		if !jsonPreference.accepted && !htmlPreference.accepted {
			return this.Text(stdhttp.StatusNotAcceptable, "not acceptable")
		}
		if htmlPreference.accepted && (!jsonPreference.accepted || htmlPreference.quality > jsonPreference.quality) {
			return this.HTML(status, data)
		}
		return this.JSON(status, data)
	}

	// Respond writes the context's data using the negotiated response format.
	// The server calls this automatically when a handler returns without writing.
	func Respond() error {
		status := this.Status
		if status == 0 {
			status = stdhttp.StatusOK
		}
		return this.Respond(status, this.Data)
	}

	// HTML renders a template as an HTML response. An empty key uses the request path.
	func HTML(status int = 200, data any = nil, key string = "") error {
		if key == "" {
			key = this.Request.URL.Path
		}
		return this.renderTemplate(status, key, data)
	}

	func Template(status int = 200, data any = nil, key string = "") error @{
		std.Deprecated("Use HTML(status, data, key) instead")
	} {
		return this.HTML(status, data, key)
	}

	func renderTemplate(status int, key string, args ...any) error {
		var body bytes.Buffer
		if this.Templates != nil {
			templateName := key
			if this.Templates.Lookup(templateName) == nil {
				var matched bool
				templateName, matched = gppHTTPTemplateNameForPath(this.Templates, key)
				if !matched {
					return fmt.Errorf("http: no template matches path %q", key)
				}
			}
			var data any
			if len(args) == 1 {
				data = args[0]
			} else {
				data = args
			}
			if err := this.Templates.ExecuteTemplate(&body, templateName, data); err != nil {
				return err
			}
			return this.commit(status, "text/html; charset=utf-8", body.Bytes())
		}
		if err := tpl.ExecuteIn(this.TemplateScope, &body, key, args...); err != nil {
			return err
		}
		return this.commit(status, "text/html; charset=utf-8", body.Bytes())
	}

	// Redirect sends the client to url using the supplied HTTP status code.
	func Redirect(url string, status int) {
		stdhttp.Redirect(this.Response, this.Request, url, status)
		if !this.Written {
			this.Status = status
			this.Written = true
		}
	}
}

func gppHTTPTemplateNameForPath(templates *htmltemplate.Template, path string) (string, bool) {
	value := gppHTTPNormalizeTemplatePath(path)
	selected := ""
	selectedStatic := -1
	for _, candidate := range templates.Templates() {
		name := candidate.Name()
		if !strings.Contains(name, "/") || !strings.HasPrefix(name, "/") {
			continue
		}
		static, ok := gppHTTPTemplatePathMatch(name, value)
		if ok && static > selectedStatic {
			selected = name
			selectedStatic = static
		}
	}
	return selected, selectedStatic >= 0
}

func gppHTTPNormalizeTemplatePath(path string) string {
	path = "/" + strings.Trim(path, "/")
	if path == "/" {
		return path
	}
	return strings.TrimSuffix(path, "/")
}

func gppHTTPTemplatePathMatch(pattern string, path string) (int, bool) {
	patternParts := strings.Split(strings.Trim(pattern, "/"), "/")
	pathParts := strings.Split(strings.Trim(path, "/"), "/")
	if len(patternParts) != len(pathParts) {
		return 0, false
	}
	static := 0
	for index, part := range patternParts {
		if strings.HasPrefix(part, "{") && strings.HasSuffix(part, "}") && len(part) > 2 {
			continue
		}
		if part != pathParts[index] {
			return 0, false
		}
		static++
	}
	return static, true
}

type gppHTTPAcceptPreference struct {
	quality     float64
	specificity int
	matched     bool
	accepted    bool
}

func gppHTTPAcceptPreferenceFor(accept string, representation string) gppHTTPAcceptPreference {
	if strings.TrimSpace(accept) == "" {
		if representation == "application/json" {
			return gppHTTPAcceptPreference{quality: 1, specificity: 0, matched: true, accepted: true}
		}
		return gppHTTPAcceptPreference{}
	}
	preference := gppHTTPAcceptPreference{}
	for _, item := range strings.Split(accept, ",") {
		mediaType, parameters, err := mime.ParseMediaType(strings.TrimSpace(item))
		if err != nil {
			continue
		}
		quality := 1.0
		if rawQuality, exists := parameters["q"]; exists {
			quality, err = strconv.ParseFloat(rawQuality, 64)
			if err != nil || quality < 0 || quality > 1 {
				continue
			}
		}
		specificity := -1
		if mediaType == representation {
			specificity = 2
		} else if mediaType == "*/*" {
			specificity = 0
		} else {
			majorType, _, hasSubtype := strings.Cut(representation, "/")
			if hasSubtype && mediaType == majorType+"/*" {
				specificity = 1
			}
		}
		if specificity < 0 {
			continue
		}
		if !preference.matched || specificity > preference.specificity || (specificity == preference.specificity && quality > preference.quality) {
			preference = gppHTTPAcceptPreference{quality: quality, specificity: specificity, matched: true, accepted: quality > 0}
		}
	}
	return preference
}

func gppHTTPVaryAccept(header stdhttp.Header) {
	for _, value := range header.Values("Vary") {
		for _, token := range strings.Split(value, ",") {
			if token == "*" || strings.EqualFold(strings.TrimSpace(token), "Accept") {
				return
			}
		}
	}
	header.Add("Vary", "Accept")
}

extend *Context {
	func Bind[T any]() (T, error) {
		return gppBindRequestAs[T](this.Request, this.Response)
	}
}

func gppNewContext(response stdhttp.ResponseWriter, request *stdhttp.Request) *Context {
	ctx := Context(Response: response, Request: request, Values: map[string]any{}, Data: map[string]any{})
	ctx.SSE = SSEStream(Context: ctx)
	return ctx
}
