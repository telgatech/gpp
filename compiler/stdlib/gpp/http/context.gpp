package gpp.http

import (
	"bytes"
	"encoding/json"
	"fmt"
	stdhttp "net/http"
	"golang.org/x/net/websocket"
	std "gpp/std"
	tpl "gpp/tpl"
)

// Context provides request data and response helpers to an HTTP handler.
class Context {
	Response stdhttp.ResponseWriter
	Request *stdhttp.Request
	Values map[string]any
	Status int
	Written bool
	Conn *websocket.Conn
	SSE *SSEStream
	TemplateScope string

	// Set stores a value for use by other handlers during the same request.
	func Set(name string, value any) {
		if this.Values == nil {
			this.Values = map[string]any{}
		}
		this.Values[name] = value
	}

	// Get returns a value previously stored on this request context.
	func Get(name string) any {
		return this.Values[name]
	}

	// Param returns the named wildcard path value for this request.
	func Param(name string) string {
		return this.Request.PathValue(name)
	}

	// Query returns the first URL query value with the given name.
	func Query(name string) string {
		return this.Request.URL.Query().Get(name)
	}

	// Bind decodes the request body according to its Content-Type.
	func Bind(target any) error {
		return gppBindRequest(this.Request, this.Response, target)
	}

	func BindQuery(target any) error {
		return gppBindValues(this.Request.URL.Query(), target, "query")
	}

	// BindJSON decodes a JSON request body into target.
	func BindJSON(target any) error {
		return gppBindJSON(this.Request, this.Response, target)
	}

	// BindForm decodes form fields into target.
	func BindForm(target any) error {
		return gppBindForm(this.Request, this.Response, target)
	}

	func commit(status int, contentType string, body []byte) error {
		if this.SSE != nil && this.SSE.Started {
			return fmt.Errorf("http: cannot replace an active SSE response")
		}
		if !this.Written {
			this.Response.Header().Set("Content-Type", contentType)
			this.Response.WriteHeader(status)
			this.Status = status
			this.Written = true
		}
		_, err := this.Response.Write(body)
		return err
	}

	// Text writes value as a plain-text response with status 200.
	func Text(value string) error {
		return this.commit(200, "text/plain; charset=utf-8", []byte(value))
	}

	func Text(status int, value string) error {
		return this.commit(status, "text/plain; charset=utf-8", []byte(value))
	}

	// JSON encodes value as a JSON response with status 200.
	func JSON(value any) error {
		return this.JSON(200, value)
	}

	func JSON(status int, value any) error {
		var body bytes.Buffer
		if err := json.NewEncoder(&body).Encode(value); err != nil {
			return err
		}
		return this.commit(status, "application/json", body.Bytes())
	}

	// HTML renders a template as an HTML response. An empty key uses the request path.
	func HTML(status int = 200, data any = nil, key string = "") error {
		if key == "" {
			key = this.Request.URL.Path
		}
		return this.renderTemplate(status, key, data)
	}

	func Template(status int = 200, data any = nil, key string = "") error @{
		std.Deprecated("Use HTML(status, data, key) instead")
	} {
		return this.HTML(status, data, key)
	}

	func renderTemplate(status int, key string, args ...any) error {
		var body bytes.Buffer
		if err := tpl.ExecuteIn(this.TemplateScope, &body, key, args...); err != nil {
			return err
		}
		return this.commit(status, "text/html; charset=utf-8", body.Bytes())
	}

	// Redirect sends the client to url using the supplied HTTP status code.
	func Redirect(url string, status int) {
		stdhttp.Redirect(this.Response, this.Request, url, status)
		if !this.Written {
			this.Status = status
			this.Written = true
		}
	}
}

extend *Context {
	func Bind[T any]() (T, error) {
		return gppBindRequestAs[T](this.Request, this.Response)
	}
}

func gppNewContext(response stdhttp.ResponseWriter, request *stdhttp.Request) *Context {
	ctx := Context(Response: response, Request: request, Values: map[string]any{})
	ctx.SSE = SSEStream(Context: ctx)
	return ctx
}
