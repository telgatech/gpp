package gpp.http

import (
	"compress/gzip"
	"context"
	"fmt"
	htmltemplate "html/template"
	"log"
	"mime"
	"net"
	"os"
	"os/signal"
	stdhttp "net/http"
	gppwebsocket "golang.org/x/net/websocket"
	"reflect"
	"sort"
	"strconv"
	"strings"
	"sync"
	"syscall"
	"time"
	std "gpp/std"
	tpl "gpp/tpl"
)

type gppReadyListener struct {
	net.Listener
	ready chan bool
	once sync.Once
}

func (listener *gppReadyListener) Accept() (net.Conn, error) {
	listener.once.Do(func() { close(listener.ready) })
	return listener.Listener.Accept()
}

func gppServe(server *stdhttp.Server, listener net.Listener, ready chan bool, done chan error) {
	done <- server.Serve(&gppReadyListener{Listener: listener, ready: ready})
}

type gppHTTPRequestContextKey struct{}

type gppHTTPProductionTemplateCacheEntry struct {
	Templates *htmltemplate.Template
	Err       error
}

var gppHTTPProductionTemplateCache sync.Map

type gppHTTPRequestState struct {
	Context     *Context
	FailureCode int
	Failure     error
	AfterHandled bool
}

type gppHTTPStatusResponseWriter struct {
	stdhttp.ResponseWriter
	Status       int
	Request      *stdhttp.Request
	CacheControl string
	gzipWriter   *gzip.Writer
}

func (writer *gppHTTPStatusResponseWriter) WriteHeader(status int) {
	if writer.Status != 0 {
		return
	}
	writer.Status = status
	header := writer.ResponseWriter.Header()
	if status == stdhttp.StatusOK || status == stdhttp.StatusPartialContent || status == stdhttp.StatusNotModified {
		cacheControl := writer.CacheControl
		if cacheControl == "" {
			cacheControl = "public, max-age=300"
		}
		if header.Get("Cache-Control") == "" {
			header.Set("Cache-Control", cacheControl)
		}
	}
	if !gppHTTPCompressibleContentType(header.Get("Content-Type")) {
		writer.ResponseWriter.WriteHeader(status)
		return
	}
	gppHTTPAppendVary(header, "Accept-Encoding")
	contentLength, lengthErr := strconv.ParseInt(header.Get("Content-Length"), 10, 64)
	if status == stdhttp.StatusOK && (lengthErr != nil || contentLength >= 512) && writer.Request != nil && writer.Request.Header.Get("Range") == "" && header.Get("Content-Encoding") == "" && gppHTTPAcceptsGzip(writer.Request.Header.Get("Accept-Encoding")) {
		header.Del("Content-Length")
		header.Set("Content-Encoding", "gzip")
		if writer.Request.Method != stdhttp.MethodHead {
			writer.gzipWriter = gzip.NewWriter(writer.ResponseWriter)
		}
	}
	writer.ResponseWriter.WriteHeader(status)
}

func (writer *gppHTTPStatusResponseWriter) Write(data []byte) (int, error) {
	if writer.Status == 0 {
		writer.WriteHeader(stdhttp.StatusOK)
	}
	if writer.gzipWriter != nil {
		return writer.gzipWriter.Write(data)
	}
	return writer.ResponseWriter.Write(data)
}

func (writer *gppHTTPStatusResponseWriter) Unwrap() stdhttp.ResponseWriter {
	return writer.ResponseWriter
}

func (writer *gppHTTPStatusResponseWriter) Close() error {
	if writer.gzipWriter != nil {
		return writer.gzipWriter.Close()
	}
	return nil
}

func gppHTTPCompressibleContentType(contentType string) bool {
	mediaType, _, err := mime.ParseMediaType(contentType)
	if err != nil {
		return false
	}
	mediaType = strings.ToLower(mediaType)
	return strings.HasPrefix(mediaType, "text/") || mediaType == "application/json" || mediaType == "application/javascript" || mediaType == "application/xml" || mediaType == "application/xhtml+xml" || mediaType == "application/wasm" || mediaType == "image/svg+xml"
}

func gppHTTPAcceptsGzip(header string) bool {
	gzipQuality := -1.0
	wildcardQuality := -1.0
	for _, item := range strings.Split(header, ",") {
		parts := strings.Split(item, ";")
		encoding := strings.ToLower(strings.TrimSpace(parts[0]))
		if encoding == "" {
			continue
		}
		quality := 1.0
		for _, parameter := range parts[1:] {
			name, value, found := strings.Cut(strings.TrimSpace(parameter), "=")
			if !found || !strings.EqualFold(strings.TrimSpace(name), "q") {
				continue
			}
			parsed, err := strconv.ParseFloat(strings.TrimSpace(value), 64)
			if err != nil || parsed < 0 || parsed > 1 {
				quality = 0
			} else {
				quality = parsed
			}
		}
		switch encoding {
		case "gzip":
			gzipQuality = quality
		case "*":
			wildcardQuality = quality
		}
	}
	if gzipQuality >= 0 {
		return gzipQuality > 0
	}
	return wildcardQuality > 0
}

func gppHTTPAppendVary(header stdhttp.Header, value string) {
	for _, existing := range header.Values("Vary") {
		for _, item := range strings.Split(existing, ",") {
			if strings.TrimSpace(item) == "*" || strings.EqualFold(strings.TrimSpace(item), value) {
				return
			}
		}
	}
	header.Add("Vary", value)
}

func gppHTTPRequestStateFor(request *stdhttp.Request) *gppHTTPRequestState {
	if request == nil {
		return nil
	}
	state, _ := request.Context().Value(gppHTTPRequestContextKey{}).(*gppHTTPRequestState)
	return state
}

func gppContextForRequest(response stdhttp.ResponseWriter, request *stdhttp.Request, router any) (*Context, *gppHTTPRequestState) {
	state := gppHTTPRequestStateFor(request)
	if state != nil && state.Context != nil {
		state.Context.Response = response
		state.Context.Request = request
		state.Context.TemplateScope = gppTemplateScope(router)
		if templates := gppHTTPTemplates(router); templates != nil {
			state.Context.Templates = templates
		}
		return state.Context, state
	}
	ctx := gppNewContext(response, request)
	ctx.TemplateScope = gppTemplateScope(router)
	ctx.Templates = gppHTTPTemplates(router)
	return ctx, nil
}

func gppCallHandle(app any, ctx *Context) error {
	handler := reflect.ValueOf(app).MethodByName("Handle")
	if !handler.IsValid() || handler.Type().NumIn() != 1 || handler.Type().In(0) != reflect.TypeOf((*Context)(nil)) || handler.Type().NumOut() != 1 || handler.Type().Out(0) != reflect.TypeOf((*error)(nil)).Elem() {
		return fmt.Errorf("http: Handle must have signature Handle(*http.Context) error")
	}
	result := handler.Call([]reflect.Value{reflect.ValueOf(ctx)})
	return gppErrorResult(result)
}

func gppDispatchRequests(app any, routes stdhttp.Handler) stdhttp.Handler {
	staticMounts := gppHTTPStaticMounts(app)
	staticCacheControl := gppHTTPStringField(app, "PublicCacheControl")
	return stdhttp.HandlerFunc(func(response stdhttp.ResponseWriter, request *stdhttp.Request) {
		ctx := gppNewContext(response, request)
		ctx.TemplateScope = gppTemplateScope(app)
		templates, templateErr := gppHTTPTemplatesForRequest(app)
		if templateErr != nil {
			gppCallError(app, ctx, stdhttp.StatusInternalServerError, templateErr)
			return
		}
		ctx.Templates = templates
		state := &gppHTTPRequestState{Context: ctx}
		if err := gppCallHook(app, "BeforeRequest", ctx); err != nil {
			gppCallError(app, ctx, stdhttp.StatusInternalServerError, err)
			return
		}

		if !ctx.Written && !gppServeStaticFiles(staticMounts, staticCacheControl, ctx) {
			handleErr := gppCallHandle(app, ctx)
			if handleErr != nil {
				state.FailureCode = stdhttp.StatusInternalServerError
				state.Failure = handleErr
			} else if !ctx.Written {
				routedRequest := ctx.Request
				if routedRequest == nil {
					routedRequest = request
				}
				requestContext := context.WithValue(routedRequest.Context(), gppHTTPRequestContextKey{}, state)
				routes.ServeHTTP(response, routedRequest.WithContext(requestContext))
			}
		}

		var afterErr error
		if !state.AfterHandled {
			afterErr = gppCallHook(app, "AfterRequest", ctx)
		}
		if state.FailureCode != 0 {
			gppCallError(app, ctx, state.FailureCode, state.Failure)
			return
		}
		if afterErr != nil {
			gppCallError(app, ctx, stdhttp.StatusInternalServerError, afterErr)
			return
		}
		if !ctx.Written {
			if err := ctx.Respond(); err != nil {
				gppCallError(app, ctx, stdhttp.StatusInternalServerError, err)
			}
		}
	})
}

func gppHTTPListenerURL(address net.Addr) string {
	tcpAddress, ok := address.(*net.TCPAddr)
	if !ok {
		return address.String()
	}
	host := tcpAddress.IP.String()
	if tcpAddress.IP == nil || tcpAddress.IP.IsUnspecified() {
		host = "localhost"
	}
	return "http://" + net.JoinHostPort(host, fmt.Sprint(tcpAddress.Port))
}

func gppHTTPPublicDir(app any) string {
	return gppHTTPStringField(app, "PublicDir")
}

func gppHTTPTemplates(app any) *htmltemplate.Template {
	value := reflect.ValueOf(app)
	if !value.IsValid() {
		return nil
	}
	for value.Kind() == reflect.Pointer {
		if value.IsNil() {
			return nil
		}
		value = value.Elem()
	}
	if value.Kind() != reflect.Struct {
		return nil
	}
	field := value.FieldByName("Templates")
	if !field.IsValid() || !field.CanInterface() {
		return nil
	}
	templates, _ := field.Interface().(*htmltemplate.Template)
	return templates
}

func gppHTTPTemplateFiles(app any) []string {
	value := reflect.ValueOf(app)
	if !value.IsValid() {
		return nil
	}
	for value.Kind() == reflect.Pointer {
		if value.IsNil() {
			return nil
		}
		value = value.Elem()
	}
	if value.Kind() != reflect.Struct {
		return nil
	}
	field := value.FieldByName("TemplateFiles")
	if !field.IsValid() || !field.CanInterface() || field.Kind() != reflect.Slice || field.Type().Elem().Kind() != reflect.String {
		return nil
	}
	files := make([]string, field.Len())
	for index := range files {
		files[index] = field.Index(index).String()
	}
	return files
}

func gppHTTPTemplatesForRequest(app any) (*htmltemplate.Template, error) {
	templates := gppHTTPTemplates(app)
	files := gppHTTPTemplateFiles(app)
	if templates != nil && len(files) > 0 {
		return nil, fmt.Errorf("http: configure either Templates or TemplateFiles, not both")
	}
	if templates != nil || len(files) == 0 {
		return templates, nil
	}
	if gppHTTPIsProduction() {
		workingDirectory, _ := os.Getwd()
		key := workingDirectory + "\x00" + strings.Join(files, "\x00")
		if cached, ok := gppHTTPProductionTemplateCache.Load(key); ok {
			entry := cached.(gppHTTPProductionTemplateCacheEntry)
			return entry.Templates, entry.Err
		}
		parsed, err := htmltemplate.ParseFiles(files...)
		cached, _ := gppHTTPProductionTemplateCache.LoadOrStore(key, gppHTTPProductionTemplateCacheEntry{Templates: parsed, Err: err})
		entry := cached.(gppHTTPProductionTemplateCacheEntry)
		return entry.Templates, entry.Err
	}
	return htmltemplate.ParseFiles(files...)
}

func gppHTTPIsProduction() bool {
	return strings.EqualFold(strings.TrimSpace(os.Getenv("ENV")), "production")
}

func gppHTTPValidateTemplateConfig(app any) error {
	if gppHTTPTemplates(app) != nil && len(gppHTTPTemplateFiles(app)) > 0 {
		return fmt.Errorf("http: configure either Templates or TemplateFiles, not both")
	}
	return nil
}

func gppHTTPServerLabel(app any) string {
	if name := strings.TrimSpace(gppHTTPStringField(app, "Name")); name != "" {
		return name
	}
	return "gpp/http"
}

func gppHTTPStringField(app any, name string) string {
	value := reflect.ValueOf(app)
	if !value.IsValid() {
		return ""
	}
	for value.Kind() == reflect.Pointer {
		if value.IsNil() {
			return ""
		}
		value = value.Elem()
	}
	if value.Kind() != reflect.Struct {
		return ""
	}
	field := value.FieldByName(name)
	if field.IsValid() && field.Kind() == reflect.String {
		return field.String()
	}
	return ""
}

func gppHTTPBoolField(app any, name string) bool {
	value := reflect.ValueOf(app)
	if !value.IsValid() {
		return false
	}
	for value.Kind() == reflect.Pointer {
		if value.IsNil() {
			return false
		}
		value = value.Elem()
	}
	if value.Kind() != reflect.Struct {
		return false
	}
	field := value.FieldByName(name)
	return field.IsValid() && field.Kind() == reflect.Bool && field.Bool()
}

type gppHTTPStaticMount struct {
	Path      string
	Directory string
	DirListing bool
}

func gppHTTPStaticMounts(app any) []gppHTTPStaticMount {
	mounts := []gppHTTPStaticMount{}
	descriptor := gppRuntimeClass(app)
	value := reflect.ValueOf(descriptor)
	if value.IsValid() && value.Kind() == reflect.Pointer && !value.IsNil() {
		value = value.Elem()
	}
	if value.IsValid() && value.Kind() == reflect.Struct {
		annotations := value.FieldByName("Annotations")
		if annotations.IsValid() && annotations.Kind() == reflect.Slice {
			for index := 0; index < annotations.Len(); index++ {
				annotation := gppReflectIndex(annotations, index)
				name := fmt.Sprint(annotation.FieldByName("Name").Interface())
				fullName := fmt.Sprint(annotation.FieldByName("FullName").Interface())
				if name != "Files" && fullName != "gpp.http.Files" {
					continue
				}
				arguments := annotation.FieldByName("Args")
				if !arguments.IsValid() || arguments.Kind() != reflect.Slice || arguments.Len() < 2 {
					continue
				}
				listing := false
				if arguments.Len() > 2 {
					listingValue := gppReflectIndex(arguments, 2)
					listing = listingValue.IsValid() && listingValue.Kind() == reflect.Bool && listingValue.Bool()
				}
				mounts = append(mounts, gppHTTPStaticMount{
					Path:       fmt.Sprint(gppReflectIndex(arguments, 0).Interface()),
					Directory:  fmt.Sprint(gppReflectIndex(arguments, 1).Interface()),
					DirListing: listing,
				})
			}
		}
	}
	if directory := gppHTTPPublicDir(app); directory != "" {
		mounts = append(mounts, gppHTTPStaticMount{Path: "/", Directory: directory, DirListing: gppHTTPBoolField(app, "DirListing")})
	}
	sort.SliceStable(mounts, func(left int, right int) bool {
		return len(mounts[left].Path) > len(mounts[right].Path)
	})
	return mounts
}

func gppServeStaticFiles(mounts []gppHTTPStaticMount, cacheControl string, ctx *Context) bool {
	if ctx == nil || ctx.Request == nil || (ctx.Request.Method != stdhttp.MethodGet && ctx.Request.Method != stdhttp.MethodHead) {
		return false
	}
	for _, mount := range mounts {
		if gppServeStaticMount(mount, cacheControl, ctx) {
			return true
		}
	}
	return false
}

func gppServeStaticMount(mount gppHTTPStaticMount, cacheControl string, ctx *Context) bool {
	if mount.Path == "" || mount.Directory == "" {
		return false
	}
	requestPath := ctx.Request.URL.Path
	filePath := requestPath
	if mount.Path != "/" {
		if strings.HasSuffix(mount.Path, "/") {
			if requestPath == strings.TrimSuffix(mount.Path, "/") {
				stdhttp.Redirect(ctx.Response, ctx.Request, mount.Path, stdhttp.StatusMovedPermanently)
				ctx.Status = stdhttp.StatusMovedPermanently
				ctx.Written = true
				return true
			}
			if !strings.HasPrefix(requestPath, mount.Path) {
				return false
			}
			filePath = strings.TrimPrefix(requestPath, mount.Path)
		} else {
			if requestPath != mount.Path {
				return false
			}
			filePath = "/"
		}
	}
	if filePath == "" {
		filePath = "/"
	}
	root := stdhttp.Dir(mount.Directory)
	file, err := root.Open(filePath)
	if err != nil {
		return false
	}
	fileInfo, err := file.Stat()
	_ = file.Close()
	if err != nil {
		return false
	}
	serveRequest := ctx.Request
	if fileInfo.IsDir() {
		indexHTML := strings.TrimRight(filePath, "/") + "/index.html"
		hasIndexHTML := gppHTTPStaticFileExists(root, indexHTML)
		indexHTM := strings.TrimRight(filePath, "/") + "/index.htm"
		hasIndexHTM := gppHTTPStaticFileExists(root, indexHTM)
		if !hasIndexHTML && !hasIndexHTM && !mount.DirListing {
			return false
		}
		useIndexHTM := strings.HasSuffix(requestPath, "/") || (mount.Path != "/" && !strings.HasSuffix(mount.Path, "/") && requestPath == mount.Path)
		if !hasIndexHTML && hasIndexHTM && useIndexHTM {
			clonedRequest := ctx.Request.Clone(ctx.Request.Context())
			clonedURL := *ctx.Request.URL
			if mount.Path == "/" {
				clonedURL.Path = indexHTM
			} else {
				prefix := mount.Path
				if !strings.HasSuffix(prefix, "/") {
					prefix += "/"
				}
				clonedURL.Path = prefix + strings.TrimLeft(indexHTM, "/")
			}
			clonedURL.RawPath = ""
			clonedRequest.URL = &clonedURL
			serveRequest = clonedRequest
		}
	}
	response := &gppHTTPStatusResponseWriter{
		ResponseWriter: ctx.Response,
		Request:        ctx.Request,
		CacheControl:   cacheControl,
	}
	fileServer := stdhttp.Handler(stdhttp.FileServer(root))
	if mount.Path != "/" {
		fileServer = stdhttp.StripPrefix(mount.Path, fileServer)
	}
	fileServer.ServeHTTP(response, serveRequest)
	_ = response.Close()
	ctx.Status = response.Status
	ctx.Written = response.Status != 0
	return true
}

func gppHTTPStaticFileExists(root stdhttp.Dir, name string) bool {
	file, err := root.Open(name)
	if err != nil {
		return false
	}
	info, err := file.Stat()
	_ = file.Close()
	return err == nil && !info.IsDir()
}

func gppErrorResult(result []reflect.Value) error {
	if len(result) == 0 || result[0].IsNil() {
		return nil
	}
	if err, ok := result[0].Interface().(error); ok {
		return err
	}
	return nil
}

func gppCallHook(app any, name string, ctx *Context) error {
	handler := reflect.ValueOf(app).MethodByName(name)
	if !handler.IsValid() {
		return nil
	}
	if ctx == nil {
		return gppErrorResult(handler.Call(nil))
	}
	return gppErrorResult(handler.Call([]reflect.Value{reflect.ValueOf(ctx)}))
}

func gppCallShutdown(app any, ctx context.Context) error {
	handler := reflect.ValueOf(app).MethodByName("Shutdown")
	if !handler.IsValid() {
		return nil
	}
	return gppErrorResult(handler.Call([]reflect.Value{reflect.ValueOf(ctx)}))
}

func gppWriteMinimalError(ctx *Context) {
	if ctx == nil || ctx.Written {
		return
	}
	ctx.Response.Header().Set("Content-Type", "text/plain; charset=utf-8")
	ctx.Response.WriteHeader(stdhttp.StatusInternalServerError)
	ctx.Status = stdhttp.StatusInternalServerError
	ctx.Written = true
	_, _ = ctx.Response.Write([]byte("500 Internal Server Error"))
}

func gppErrorTemplate(app any) string {
	if app == nil {
		return gppDefaultErrorTemplate
	}
	handler := reflect.ValueOf(app).MethodByName("ErrorTemplate")
	if !handler.IsValid() || handler.Type().NumIn() != 0 || handler.Type().NumOut() != 1 || handler.Type().Out(0).Kind() != reflect.String {
		return gppDefaultErrorTemplate
	}
	result := handler.Call(nil)
	if len(result) == 1 && result[0].IsValid() {
		return result[0].String()
	}
	return gppDefaultErrorTemplate
}

func gppCallError(app any, ctx *Context, code int, cause error) {
	if ctx != nil && ctx.SSE != nil && ctx.SSE.Started {
		if cause != nil {
			log.Printf("%s: handler error after SSE stream started: %v", gppHTTPServerLabel(app), cause)
		}
		return
	}
	handler := reflect.ValueOf(app).MethodByName("Error")
	if !handler.IsValid() || handler.Type().NumIn() != 3 {
		gppWriteMinimalError(ctx)
		return
	}
	causeValue := reflect.Zero(handler.Type().In(2))
	if cause != nil {
		causeValue = reflect.ValueOf(cause)
	}
	result := handler.Call([]reflect.Value{
		reflect.ValueOf(ctx),
		reflect.ValueOf(code),
		causeValue,
	})
	if err := gppErrorResult(result); err != nil && !ctx.Written {
		gppWriteMinimalError(ctx)
	}
}

func gppRouteHandler(router any, app any, methodName string, methodMetadata any, w stdhttp.ResponseWriter, r *stdhttp.Request) {
	handler := reflect.ValueOf(router).MethodByName(methodName)
	ctx, state := gppContextForRequest(w, r, router)
	if !handler.IsValid() {
		if state != nil {
			state.FailureCode = stdhttp.StatusInternalServerError
			state.Failure = fmt.Errorf("route handler not found")
			return
		}
		gppCallError(app, ctx, stdhttp.StatusInternalServerError, fmt.Errorf("route handler not found"))
		return
	}
	if state == nil {
		if err := gppCallHook(app, "BeforeRequest", ctx); err != nil {
			gppCallError(app, ctx, stdhttp.StatusInternalServerError, err)
			return
		}
	}
	arguments, err := gppRouteArguments(handler, methodMetadata, ctx)
	if err != nil {
		if state != nil {
			state.FailureCode = stdhttp.StatusBadRequest
			state.Failure = err
			return
		}
		gppCallError(app, ctx, stdhttp.StatusBadRequest, err)
		return
	}
	result := handler.Call(arguments)
	routeErr := gppErrorResult(result)
	if routeErr != nil {
		if state != nil {
			state.FailureCode = stdhttp.StatusInternalServerError
			state.Failure = routeErr
			return
		}
		_ = gppCallHook(app, "AfterRequest", ctx)
		gppCallError(app, ctx, stdhttp.StatusInternalServerError, routeErr)
		return
	}
	if state == nil {
		if afterErr := gppCallHook(app, "AfterRequest", ctx); afterErr != nil {
			gppCallError(app, ctx, stdhttp.StatusInternalServerError, afterErr)
		}
	}
}

func gppRouteArguments(handler reflect.Value, methodMetadata any, ctx *Context) ([]reflect.Value, error) {
	parameters := reflect.ValueOf(methodMetadata)
	if parameters.Kind() == reflect.Pointer {
		parameters = parameters.Elem()
	}
	if !parameters.IsValid() || parameters.Kind() != reflect.Struct {
		return nil, fmt.Errorf("http: route handler parameter metadata is unavailable")
	}
	parameters = parameters.FieldByName("Parameters")
	if !parameters.IsValid() || parameters.Len() != handler.Type().NumIn() {
		return nil, fmt.Errorf("http: route handler parameter metadata does not match its signature")
	}
	arguments := make([]reflect.Value, handler.Type().NumIn())
	arguments[0] = reflect.ValueOf(ctx)
	for index := 1; index < handler.Type().NumIn(); index++ {
		parameter := gppReflectIndex(parameters, index)
		parameterName := fmt.Sprint(parameter.FieldByName("Name").Interface())
		annotationNames := []string{"gpp.http.Path", "gpp.http.Query", "gpp.http.Body"}
		matched := ""
		for _, name := range annotationNames {
			if gppHasAnnotation(parameter.Interface(), name) {
				if matched != "" {
					return nil, fmt.Errorf("http: parameter %s has multiple request binding annotations", parameterName)
				}
				matched = name
			}
		}
		if matched == "" {
			return nil, fmt.Errorf("http: handler parameter %s requires http.Path, http.Query, or http.Body", parameterName)
		}
		argumentType := handler.Type().In(index)
		switch matched {
		case "gpp.http.Path", "gpp.http.Query":
			name := parameterName
			if annotationArguments := gppAnnotationArgs(parameter.Interface(), matched); len(annotationArguments) > 0 {
				if explicitName := strings.TrimSpace(fmt.Sprint(annotationArguments[0])); explicitName != "" {
					name = explicitName
				}
			}
			var value string
			var present bool
			var values []string
			if matched == "gpp.http.Path" {
				value = ctx.Request.PathValue(name)
				present = value != ""
				if present {
					values = []string{value}
				}
			} else {
				values, present = ctx.Request.URL.Query()[name]
				present = present && len(values) > 0
			}
			if matched == "gpp.http.Path" && !present {
				return nil, fmt.Errorf("http: route parameter %q is missing", name)
			}
			argument := reflect.New(argumentType).Elem()
			if present {
				if err := gppSetBindField(argument, values); err != nil {
					return nil, fmt.Errorf("http: bind parameter %s: %w", parameterName, err)
				}
			}
			arguments[index] = argument
		case "gpp.http.Body":
			var target reflect.Value
			if argumentType.Kind() == reflect.Pointer {
				target = reflect.New(argumentType.Elem())
				arguments[index] = target
			} else {
				target = reflect.New(argumentType)
				arguments[index] = target.Elem()
			}
			if err := gppBindRequest(ctx.Request, ctx.Response, target.Interface()); err != nil {
				return nil, fmt.Errorf("http: bind request body into parameter %s: %w", parameterName, err)
			}
		}
	}
	return arguments, nil
}

func gppValidateRouteSignature(handler reflect.Value, methodMetadata any) error {
	contextType := reflect.TypeOf((*Context)(nil))
	if !handler.IsValid() || handler.Type().NumIn() == 0 || handler.Type().In(0) != contextType {
		return fmt.Errorf("route handler must take *http.Context as its first parameter")
	}
	metadata := reflect.ValueOf(methodMetadata)
	if metadata.Kind() == reflect.Pointer {
		metadata = metadata.Elem()
	}
	if !metadata.IsValid() || metadata.Kind() != reflect.Struct {
		return fmt.Errorf("route handler parameter metadata is unavailable")
	}
	parameters := metadata.FieldByName("Parameters")
	if !parameters.IsValid() || parameters.Len() != handler.Type().NumIn() {
		return fmt.Errorf("route handler parameter metadata does not match its signature")
	}
	bodyCount := 0
	for index := 1; index < parameters.Len(); index++ {
		parameter := gppReflectIndex(parameters, index)
		name := fmt.Sprint(parameter.FieldByName("Name").Interface())
		matches := 0
		for _, annotation := range []string{"gpp.http.Path", "gpp.http.Query", "gpp.http.Body"} {
			if gppHasAnnotation(parameter.Interface(), annotation) {
				matches++
				if annotation == "gpp.http.Body" {
					bodyCount++
				}
			}
		}
		if matches != 1 {
			return fmt.Errorf("handler parameter %s must have exactly one of http.Path, http.Query, or http.Body", name)
		}
	}
	if bodyCount > 1 {
		return fmt.Errorf("route handler can have at most one http.Body parameter")
	}
	return nil
}

func gppWebSocketRouteHandler(router any, app any, methodName string, w stdhttp.ResponseWriter, r *stdhttp.Request) {
	ctx, state := gppContextForRequest(w, r, router)
	if state == nil {
		if err := gppCallHook(app, "BeforeRequest", ctx); err != nil {
			gppCallError(app, ctx, stdhttp.StatusInternalServerError, err)
			return
		}
	}
	wsHandler := gppwebsocket.Handler(func(connection *gppwebsocket.Conn) {
		defer connection.Close()
		ctx.Request = connection.Request()
		ctx.Conn = connection
		handler := reflect.ValueOf(router).MethodByName(methodName)
		if !handler.IsValid() {
			log.Printf("%s: websocket handler %s not found", gppHTTPServerLabel(app), methodName)
			_ = connection.Close()
			return
		}
		result := handler.Call([]reflect.Value{reflect.ValueOf(ctx)})
		routeErr := gppErrorResult(result)
		if state != nil {
			state.AfterHandled = true
		}
		afterErr := gppCallHook(app, "AfterRequest", ctx)
		if routeErr != nil {
			log.Printf("%s: websocket handler %s failed: %v", gppHTTPServerLabel(app), methodName, routeErr)
			if afterErr != nil {
				log.Printf("%s: after-request hook failed after websocket handler %s: %v", gppHTTPServerLabel(app), methodName, afterErr)
			}
			_ = connection.Close()
			return
		}
		if afterErr != nil {
			log.Printf("%s: after-request hook failed after websocket handler %s: %v", gppHTTPServerLabel(app), methodName, afterErr)
			_ = connection.Close()
		}
	})
	wsHandler.ServeHTTP(w, r)
}

func gppRuntimeClass(value any) any {
	method := reflect.ValueOf(value).MethodByName("GppRuntimeClass")
	if !method.IsValid() {
		return nil
	}
	result := method.Call(nil)
	if len(result) == 0 || !result[0].IsValid() || result[0].IsNil() {
		return nil
	}
	return result[0].Interface()
}

func gppTemplateScope(value any) string {
	class := gppRuntimeClass(value)
	if class == nil {
		return ""
	}
	metadata := reflect.ValueOf(class)
	if metadata.Kind() == reflect.Pointer {
		if metadata.IsNil() {
			return ""
		}
		metadata = metadata.Elem()
	}
	if !metadata.IsValid() || metadata.Kind() != reflect.Struct {
		return ""
	}
	scope := metadata.FieldByName("Package")
	if !scope.IsValid() || scope.Kind() != reflect.String {
		return ""
	}
	return scope.String()
}

func gppReflectIndex(value reflect.Value, index int) reflect.Value {
	return value.Index(index)
}

func gppAnnotationArgs(owner any, name string) []any {
	if owner == nil {
		return nil
	}
	value := reflect.ValueOf(owner)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	if !value.IsValid() {
		return nil
	}
	annotations := value.FieldByName("Annotations")
	if !annotations.IsValid() {
		return nil
	}
	for index := 0; index < annotations.Len(); index++ {
		annotation := gppReflectIndex(annotations, index)
		annotationName := fmt.Sprint(annotation.FieldByName("Name").Interface())
		fullName := fmt.Sprint(annotation.FieldByName("FullName").Interface())
		if annotationName == name || fullName == name {
			arguments := annotation.FieldByName("Args")
			result := make([]any, arguments.Len())
			for argIndex := 0; argIndex < arguments.Len(); argIndex++ {
				result[argIndex] = gppReflectIndex(arguments, argIndex).Interface()
			}
			return result
		}
	}
	return nil
}

func gppHasAnnotation(owner any, name string) bool {
	if owner == nil {
		return false
	}
	value := reflect.ValueOf(owner)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	if !value.IsValid() {
		return false
	}
	annotations := value.FieldByName("Annotations")
	if !annotations.IsValid() {
		return false
	}
	for index := 0; index < annotations.Len(); index++ {
		annotation := gppReflectIndex(annotations, index)
		annotationName := fmt.Sprint(annotation.FieldByName("Name").Interface())
		fullName := fmt.Sprint(annotation.FieldByName("FullName").Interface())
		if annotationName == name || fullName == name {
			return true
		}
	}
	return false
}

type gppHTTPMount struct {
	Router    any
	Addresses []string
}

func gppJoinHTTPPath(prefix string, route string) string {
	prefix = strings.TrimRight(strings.TrimSpace(prefix), "/")
	route = "/" + strings.TrimLeft(strings.TrimSpace(route), "/")
	if prefix == "" {
		return route
	}
	if route == "/" {
		return prefix
	}
	return prefix + route
}

func gppParseMountAddress(address string) (string, string, error) {
	address = strings.TrimSpace(address)
	if address == "" {
		return "", "", fmt.Errorf("http: mount address cannot be empty")
	}
	if strings.HasPrefix(address, "/") {
		return "", gppJoinHTTPPath("", address), nil
	}
	parts := strings.SplitN(address, "/", 2)
	host := parts[0]
	if strings.ContainsAny(host, " \t?#") || host == "" {
		return "", "", fmt.Errorf("http: invalid mount host %q", host)
	}
	if strings.Contains(host, ":") {
		if parsedHost, _, err := net.SplitHostPort(host); err == nil {
			host = parsedHost
		} else {
			return "", "", fmt.Errorf("http: mount hosts must be DNS names or IPv4 addresses without a port: %q", host)
		}
	}
	path := ""
	if len(parts) == 2 {
		path = gppJoinHTTPPath("", parts[1])
	}
	return host, path, nil
}

func gppMuxPattern(host string, path string) string {
	if path == "/" {
		if host != "" {
			return host + "/{$}"
		}
		return "/{$}"
	}
	if host != "" {
		return host + path
	}
	return path
}

func gppRegisterMuxHandler(mux *stdhttp.ServeMux, pattern string, handler func(stdhttp.ResponseWriter, *stdhttp.Request)) (err error) {
	defer func() {
		if recovered := recover(); recovered != nil {
			err = fmt.Errorf("http: cannot register route %q: %v", pattern, recovered)
		}
	}()
	mux.HandleFunc(pattern, handler)
	return nil
}

func gppRegisterRoutes(mux *stdhttp.ServeMux, router any, app any, descriptor any, prefix string, host string, fallback bool) error {
	if descriptor == nil {
		return nil
	}
	value := reflect.ValueOf(descriptor)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	rootHandlers := map[string]func(stdhttp.ResponseWriter, *stdhttp.Request){}
	routeHandlers := map[string]map[string]func(stdhttp.ResponseWriter, *stdhttp.Request){}
	methods := value.FieldByName("Methods")
	for index := 0; index < methods.Len(); index++ {
		method := gppReflectIndex(methods, index)
		methodName := fmt.Sprint(method.FieldByName("Name").Interface())
		register := func(routePath string, httpMethod string, websocketRoute bool) error {
			handlerMethod := reflect.ValueOf(router).MethodByName(methodName)
			if websocketRoute {
				if !handlerMethod.IsValid() || handlerMethod.Type().NumIn() != 1 || handlerMethod.Type().In(0) != reflect.TypeOf((*Context)(nil)) {
					return fmt.Errorf("http: WebSocket handler %s must take only *http.Context", methodName)
				}
			} else if err := gppValidateRouteSignature(handlerMethod, method.Interface()); err != nil {
				return fmt.Errorf("http: invalid route handler %s: %w", methodName, err)
			}
			path := gppJoinHTTPPath(prefix, routePath)
			handler := func(w stdhttp.ResponseWriter, r *stdhttp.Request) {
				if r.Method != httpMethod {
					w.Header().Set("Allow", httpMethod)
					w.WriteHeader(stdhttp.StatusMethodNotAllowed)
					return
				}
				if websocketRoute {
					gppWebSocketRouteHandler(router, app, methodName, w, r)
					return
				}
				gppRouteHandler(router, app, methodName, method.Interface(), w, r)
			}
			if path == "/" {
				if rootHandlers[httpMethod] != nil {
					return fmt.Errorf("duplicate HTTP route: %s %s", httpMethod, path)
				}
				rootHandlers[httpMethod] = handler
				return nil
			}
			if routeHandlers[path] == nil {
				routeHandlers[path] = map[string]func(stdhttp.ResponseWriter, *stdhttp.Request){}
			}
			if routeHandlers[path][httpMethod] != nil {
				return fmt.Errorf("duplicate HTTP route: %s %s", httpMethod, path)
			}
			routeHandlers[path][httpMethod] = handler
			return nil
		}
		for _, route := range []struct {
			annotation string
			method     string
		}{
			{annotation: "gpp.http.GET", method: "GET"},
			{annotation: "gpp.http.POST", method: "POST"},
			{annotation: "gpp.http.PUT", method: "PUT"},
			{annotation: "gpp.http.PATCH", method: "PATCH"},
			{annotation: "gpp.http.DELETE", method: "DELETE"},
		} {
			if arguments := gppAnnotationArgs(method.Interface(), route.annotation); len(arguments) > 0 {
				if err := register(fmt.Sprint(arguments[0]), route.method, false); err != nil {
					return err
				}
			}
		}
		if arguments := gppAnnotationArgs(method.Interface(), "gpp.http.WebSocket"); len(arguments) > 0 {
			if err := register(fmt.Sprint(arguments[0]), "GET", true); err != nil {
				return err
			}
		}
	}
	paths := make([]string, 0, len(routeHandlers))
	for path := range routeHandlers {
		paths = append(paths, path)
	}
	sort.Strings(paths)
	for _, path := range paths {
		handlers := routeHandlers[path]
		methods := make([]string, 0, len(handlers))
		for method := range handlers {
			methods = append(methods, method)
		}
		sort.Strings(methods)
		for _, method := range methods {
			pattern := method + " " + gppMuxPattern(host, path)
			if err := gppRegisterMuxHandler(mux, pattern, handlers[method]); err != nil {
				return err
			}
		}
	}
	rootMethods := make([]string, 0, len(rootHandlers))
	for method := range rootHandlers {
		rootMethods = append(rootMethods, method)
	}
	sort.Strings(rootMethods)
	for _, method := range rootMethods {
		pattern := method + " " + gppMuxPattern(host, "/")
		if err := gppRegisterMuxHandler(mux, pattern, rootHandlers[method]); err != nil {
			return err
		}
	}
	if fallback {
		return gppRegisterMuxHandler(mux, "/", func(w stdhttp.ResponseWriter, r *stdhttp.Request) {
			ctx, state := gppContextForRequest(w, r, app)
			if (r.Method == stdhttp.MethodGet || r.Method == stdhttp.MethodHead) && (len(ctx.Data) > 0 || gppHTTPTemplateMatchesPath(ctx.Templates, r.URL.Path)) {
				if state != nil {
					return
				}
				if err := ctx.Respond(); err != nil {
					gppCallError(app, ctx, stdhttp.StatusInternalServerError, err)
				}
				return
			}
			if state != nil {
				state.FailureCode = stdhttp.StatusNotFound
				return
			}
			gppCallError(app, ctx, stdhttp.StatusNotFound, nil)
		})
	}
	return nil
}

func gppHTTPTemplateMatchesPath(templates *htmltemplate.Template, path string) bool {
	if templates == nil {
		return false
	}
	_, matched := gppHTTPTemplateNameForPath(templates, path)
	return matched
}

type gppTemplateStamp struct {
	Exists  bool
	ModTime int64
	Size    int64
}

func gppTemplateStamps(paths []string) map[string]gppTemplateStamp {
	stamps := map[string]gppTemplateStamp{}
	for _, path := range paths {
		info, err := os.Stat(path)
		if err != nil {
			stamps[path] = gppTemplateStamp{}
			continue
		}
		stamps[path] = gppTemplateStamp{Exists: true, ModTime: info.ModTime().UnixNano(), Size: info.Size()}
	}
	return stamps
}

func gppTemplateStampsChanged(previous, current map[string]gppTemplateStamp) bool {
	if len(previous) != len(current) {
		return true
	}
	for path, stamp := range current {
		if previous[path] != stamp {
			return true
		}
	}
	return false
}

func gppWatchTemplates(stop <-chan struct{}, done chan<- struct{}) {
	defer close(done)
	previous := gppTemplateStamps(tpl.ManagedSourcePaths())
	ticker := time.NewTicker(200 * time.Millisecond)
	defer ticker.Stop()
	for {
		select {
		case <-stop:
			return
		case <-ticker.C:
			current := gppTemplateStamps(tpl.ManagedSourcePaths())
			if !gppTemplateStampsChanged(previous, current) {
				continue
			}
			if err := tpl.Reload(); err != nil {
				log.Printf("gpp template reload failed: %v", err)
			}
			previous = current
		}
	}
}

const gppDefaultErrorTemplate = `<!doctype html>
<html>
<head>
    <title>{{{{.Code}}}} {{{{.Message}}}}</title>
</head>
<body>
    {{{{if eq .Code 404}}}}
        <h1>Page not found</h1>
    {{{{else if eq .Code 403}}}}
        <h1>Forbidden</h1>
    {{{{else}}}}
        <h1>{{{{.Code}}}} {{{{.Message}}}}</h1>
    {{{{end}}}}
</body>
</html>`

type gppHTTPErrorData struct {
	Code    int
	Message string
	Path    string
}

// Server runs an HTTP application with annotated routes, middleware hooks, and mounted routers.
class Server {
	HTTPServer *stdhttp.Server
	// Name identifies this server in its logs. An empty name uses the default gpp/http label.
	Name string
	// Templates is the html/template set used by Context.HTML. Parse named views into it before serving.
	Templates *htmltemplate.Template
	// TemplateFiles are parsed on every request so edits appear without restarting the server. Use Templates to reuse a pre-parsed set.
	TemplateFiles []string
	PublicDir string
	DirListing bool
	PublicCacheControl string
	mounts []gppHTTPMount
	shutdownSetup *sync.Once
	shutdownLifecycle *sync.Once
	shutdownResult error
	templateWatchStop chan struct{}
	templateWatchDone chan struct{}
	templateWatchOnce *sync.Once

	// Mount registers a router class at one or more host and path addresses.
	func Mount(router any, addresses ...string) error {
		if this.HTTPServer != nil {
			return fmt.Errorf("http: mount routers before Serve or Listen")
		}
		if router == nil {
			return fmt.Errorf("http: cannot mount a nil router")
		}
		descriptor := gppRuntimeClass(router)
		if descriptor == nil {
			return fmt.Errorf("http: mounted value must be a GPP class")
		}
		if !gppHasAnnotation(descriptor, "gpp.http.Mountable") {
			return fmt.Errorf("http: mounted class must have the http.Mountable annotation")
		}
		if len(addresses) == 0 {
			return fmt.Errorf("http: Mount requires at least one address")
		}
		for _, address := range addresses {
			if _, _, err := gppParseMountAddress(address); err != nil {
				return err
			}
		}
		routerValue := reflect.ValueOf(router)
		if routerValue.Kind() != reflect.Pointer {
			routerPointer := reflect.New(routerValue.Type())
			routerPointer.Elem().Set(routerValue)
			router = routerPointer.Interface()
		}
		this.mounts = append(this.mounts, gppHTTPMount{
			Router: router,
			Addresses: append([]string{}, addresses...),
		})
		return nil
	}

	func SetupShutdownHandler() @{std.Hook} {
		app := any(this)
		if this.GppDynamicObject != nil {
			app = this.GppDynamicObject
		}
		if this.shutdownSetup == nil {
			this.shutdownSetup = &sync.Once{}
		}
		this.shutdownSetup.Do(func() {
			signals := make(chan os.Signal, 1)
			signal.Notify(signals, os.Interrupt, syscall.SIGTERM)
			go func() {
				<-signals
				signal.Stop(signals)
				ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
				defer cancel()
				gppCallShutdown(app, ctx)
			}()
		})
	}

	func BeforeListen() error @{std.Hook} {
		return nil
	}

	func AfterListen() error @{std.Hook} {
		return nil
	}

	func BeforeShutdown() error @{std.Hook} {
		return nil
	}

	func AfterShutdown() error @{std.Hook} {
		return nil
	}

	func BeforeRequest(ctx *Context) error @{std.Hook} {
		return nil
	}

	func Handle(ctx *Context) error @{std.Hook} {
		return nil
	}

	func AfterRequest(ctx *Context) error @{std.Hook} {
		return nil
	}

	func OAuthLogin(ctx *Context, identity *OAuthIdentity) @{std.Hook} {}

	func OAuthLogin(ctx *Context, identity *OAuthIdentity, token *OAuthToken) @{std.Hook} {}

	func OAuthError(ctx *Context, provider string, err error) @{std.Hook} {}

	func ErrorTemplate() string @{std.Hook} {
		return gppDefaultErrorTemplate
	}

	func Error(ctx *Context, code int, cause error) error @{std.Hook} {
		data := gppHTTPErrorData{
			Code: code,
			Message: stdhttp.StatusText(code),
			Path: ctx.Request.URL.Path,
		}
		app := any(this)
		if this.GppDynamicObject != nil {
			app = this.GppDynamicObject
		}
		if err := ctx.HTML(code, data, gppErrorTemplate(app)); err != nil {
			gppWriteMinimalError(ctx)
			return err
		}
		return nil
	}

	// Listen starts the server on the selected TCP port; port 0 asks the OS to choose one.
	func Listen(port int = 0) error {
		app := any(this)
		if this.GppDynamicObject != nil {
			app = this.GppDynamicObject
		}
		descriptor := gppRuntimeClass(app)
		network := "tcp"
		address := ":" + fmt.Sprint(port)
		if args := gppAnnotationArgs(descriptor, "gpp.http.Unix"); len(args) > 0 {
			network = "unix"
			address = fmt.Sprint(args[0])
		}
		if network == "unix" && port != 0 {
			return fmt.Errorf("http: cannot pass a port when using a Unix socket")
		}
		if network == "tcp" {
			if args := gppAnnotationArgs(descriptor, "gpp.http.IP"); len(args) > 0 {
				address = fmt.Sprint(args[0]) + address[strings.Index(address, ":"):]
			}
		}
		listener, err := net.Listen(network, address)
		if err != nil {
			return err
		}
		return this.Serve(listener)
	}

	// Serve runs the application using an existing listener.
	func Serve(listener net.Listener) error {
		app := any(this)
		if this.GppDynamicObject != nil {
			app = this.GppDynamicObject
		}
		if err := gppHTTPValidateTemplateConfig(app); err != nil {
			_ = listener.Close()
			return err
		}
		if gppHTTPIsProduction() && len(gppHTTPTemplateFiles(app)) > 0 {
			if _, err := gppHTTPTemplatesForRequest(app); err != nil {
				_ = listener.Close()
				return err
			}
		}
		descriptor := gppRuntimeClass(app)
		mux := stdhttp.NewServeMux()
		prefix := ""
		if args := gppAnnotationArgs(descriptor, "gpp.http.Prefix"); len(args) > 0 {
			prefix = fmt.Sprint(args[0])
		}
		oauthEngine, oauthErr := gppOAuthNewEngine(descriptor)
		if oauthErr != nil {
			_ = listener.Close()
			return oauthErr
		}
		if err := gppRegisterRoutes(mux, app, app, descriptor, prefix, "", true); err != nil {
			_ = listener.Close()
			return err
		}
		for _, mount := range this.mounts {
			mountDescriptor := gppRuntimeClass(mount.Router)
			if mountDescriptor == nil {
				_ = listener.Close()
				return fmt.Errorf("http: mounted router has no GPP class metadata")
			}
			routerPrefix := ""
			if args := gppAnnotationArgs(mountDescriptor, "gpp.http.Prefix"); len(args) > 0 {
				routerPrefix = fmt.Sprint(args[0])
			}
			for _, address := range mount.Addresses {
				host, mountPath, err := gppParseMountAddress(address)
				if err != nil {
					_ = listener.Close()
					return err
				}
				mountPrefix := gppJoinHTTPPath(gppJoinHTTPPath(prefix, mountPath), routerPrefix)
				if err := gppRegisterRoutes(mux, mount.Router, app, mountDescriptor, mountPrefix, host, false); err != nil {
					_ = listener.Close()
					return err
				}
			}
		}
		if err := gppRegisterOAuthRoutes(mux, app, descriptor, prefix, oauthEngine); err != nil {
			_ = listener.Close()
			return err
		}
		if err := gppRegisterOpenAPIRoutes(mux, app, descriptor, prefix); err != nil {
			_ = listener.Close()
			return err
		}
		this.HTTPServer = &stdhttp.Server{Handler: gppDispatchRequests(app, mux), Addr: listener.Addr().String()}
		if err := gppCallHook(app, "SetupShutdownHandler", nil); err != nil {
			_ = listener.Close()
			return err
		}
		if err := gppCallHook(app, "BeforeListen", nil); err != nil {
			_ = listener.Close()
			return err
		}
		ready := make(chan bool)
		done := make(chan error, 1)
		go gppServe(this.HTTPServer, listener, ready, done)
		<-ready
		if err := gppCallHook(app, "AfterListen", nil); err != nil {
			_ = this.Shutdown(context.Background())
			<-done
			return err
		}
		listenerURL := gppHTTPListenerURL(listener.Addr())
		if name := strings.TrimSpace(this.Name); name != "" {
			log.Printf("%s listening on %s", name, listenerURL)
		} else {
			log.Printf("gpp/http: listening on %s", listenerURL)
		}
		if len(tpl.ManagedSourcePaths()) > 0 {
			this.templateWatchStop = make(chan struct{})
			this.templateWatchDone = make(chan struct{})
			this.templateWatchOnce = &sync.Once{}
			go gppWatchTemplates(this.templateWatchStop, this.templateWatchDone)
		}
		serveErr := <-done
		this.stopTemplateWatcher()
		return serveErr
	}

	func stopTemplateWatcher() {
		if this.templateWatchOnce == nil {
			return
		}
		this.templateWatchOnce.Do(func() {
			close(this.templateWatchStop)
			<-this.templateWatchDone
		})
	}

	// Shutdown gracefully stops the server and runs its shutdown hooks.
	func Shutdown(ctx context.Context) error {
		app := any(this)
		if this.GppDynamicObject != nil {
			app = this.GppDynamicObject
		}
		if this.shutdownLifecycle == nil {
			this.shutdownLifecycle = &sync.Once{}
		}
		this.shutdownLifecycle.Do(func() {
			this.stopTemplateWatcher()
			beforeErr := gppCallHook(app, "BeforeShutdown", nil)
			shutdownErr := error(nil)
			if this.HTTPServer != nil {
				shutdownErr = this.HTTPServer.Shutdown(ctx)
			}
			afterErr := gppCallHook(app, "AfterShutdown", nil)
			this.shutdownResult = shutdownErr
			if this.shutdownResult == nil {
				this.shutdownResult = beforeErr
			}
			if this.shutdownResult == nil {
				this.shutdownResult = afterErr
			}
		})
		return this.shutdownResult
	}
}
