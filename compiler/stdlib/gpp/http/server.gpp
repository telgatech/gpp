package gpp.http

import (
	"context"
	"fmt"
	"log"
	"net"
	"os"
	"os/signal"
	stdhttp "net/http"
	"reflect"
	"strings"
	"sync"
	"syscall"
	"time"
	tpl "gpp/tpl"
)

type gppReadyListener struct {
	net.Listener
	ready chan bool
	once sync.Once
}

func (listener *gppReadyListener) Accept() (net.Conn, error) {
	listener.once.Do(func() { close(listener.ready) })
	return listener.Listener.Accept()
}

func gppServe(server *stdhttp.Server, listener net.Listener, ready chan bool, done chan error) {
	done <- server.Serve(&gppReadyListener{Listener: listener, ready: ready})
}

func gppErrorResult(result []reflect.Value) error {
	if len(result) == 0 || result[0].IsNil() {
		return nil
	}
	if err, ok := result[0].Interface().(error); ok {
		return err
	}
	return nil
}

func gppCallHook(app any, name string, ctx *Context) error {
	handler := reflect.ValueOf(app).MethodByName(name)
	if !handler.IsValid() {
		return nil
	}
	if ctx == nil {
		return gppErrorResult(handler.Call(nil))
	}
	return gppErrorResult(handler.Call([]reflect.Value{reflect.ValueOf(ctx)}))
}

func gppCallShutdown(app any, ctx context.Context) error {
	handler := reflect.ValueOf(app).MethodByName("Shutdown")
	if !handler.IsValid() {
		return nil
	}
	return gppErrorResult(handler.Call([]reflect.Value{reflect.ValueOf(ctx)}))
}

func gppWriteMinimalError(ctx *Context) {
	if ctx == nil || ctx.Written {
		return
	}
	ctx.Response.Header().Set("Content-Type", "text/plain; charset=utf-8")
	ctx.Response.WriteHeader(stdhttp.StatusInternalServerError)
	ctx.Status = stdhttp.StatusInternalServerError
	ctx.Written = true
	_, _ = ctx.Response.Write([]byte("500 Internal Server Error"))
}

func gppCallError(app any, ctx *Context, code int, cause error) {
	handler := reflect.ValueOf(app).MethodByName("Error")
	if !handler.IsValid() || handler.Type().NumIn() != 3 {
		gppWriteMinimalError(ctx)
		return
	}
	causeValue := reflect.Zero(handler.Type().In(2))
	if cause != nil {
		causeValue = reflect.ValueOf(cause)
	}
	result := handler.Call([]reflect.Value{
		reflect.ValueOf(ctx),
		reflect.ValueOf(code),
		causeValue,
	})
	if err := gppErrorResult(result); err != nil && !ctx.Written {
		gppWriteMinimalError(ctx)
	}
}

func gppRouteHandler(app any, methodName string, w stdhttp.ResponseWriter, r *stdhttp.Request) {
	handler := reflect.ValueOf(app).MethodByName(methodName)
	ctx := Context(Response: w, Request: r, Values: map[string]any{})
	if !handler.IsValid() {
		gppCallError(app, &ctx, stdhttp.StatusInternalServerError, fmt.Errorf("route handler not found"))
		return
	}
	if err := gppCallHook(app, "BeforeRequest", &ctx); err != nil {
		gppCallError(app, &ctx, stdhttp.StatusInternalServerError, err)
		return
	}
	result := handler.Call([]reflect.Value{reflect.ValueOf(&ctx)})
	routeErr := gppErrorResult(result)
	afterErr := gppCallHook(app, "AfterRequest", &ctx)
	if routeErr != nil {
		gppCallError(app, &ctx, stdhttp.StatusInternalServerError, routeErr)
		return
	}
	if afterErr != nil {
		gppCallError(app, &ctx, stdhttp.StatusInternalServerError, afterErr)
	}
}

func gppRuntimeClass(value any) any {
	method := reflect.ValueOf(value).MethodByName("GppRuntimeClass")
	if !method.IsValid() {
		return nil
	}
	result := method.Call(nil)
	if len(result) == 0 || !result[0].IsValid() || result[0].IsNil() {
		return nil
	}
	return result[0].Interface()
}

func gppReflectIndex(value reflect.Value, index int) reflect.Value {
	return value.Index(index)
}

func gppAnnotationArgs(owner any, name string) []any {
	if owner == nil {
		return nil
	}
	value := reflect.ValueOf(owner)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	if !value.IsValid() {
		return nil
	}
	annotations := value.FieldByName("Annotations")
	if !annotations.IsValid() {
		return nil
	}
	for index := 0; index < annotations.Len(); index++ {
		annotation := gppReflectIndex(annotations, index)
		annotationName := fmt.Sprint(annotation.FieldByName("Name").Interface())
		fullName := fmt.Sprint(annotation.FieldByName("FullName").Interface())
		if annotationName == name || fullName == name {
			arguments := annotation.FieldByName("Args")
			result := make([]any, arguments.Len())
			for argIndex := 0; argIndex < arguments.Len(); argIndex++ {
				result[argIndex] = gppReflectIndex(arguments, argIndex).Interface()
			}
			return result
		}
	}
	return nil
}

func gppRegisterRoutes(mux *stdhttp.ServeMux, app any, descriptor any, prefix string) {
	if descriptor == nil {
		return
	}
	value := reflect.ValueOf(descriptor)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	rootHandlers := map[string]func(stdhttp.ResponseWriter, *stdhttp.Request){}
	methods := value.FieldByName("Methods")
	for index := 0; index < methods.Len(); index++ {
		method := gppReflectIndex(methods, index)
		methodName := fmt.Sprint(method.FieldByName("Name").Interface())
		register := func(routePath string, httpMethod string) {
			path := routePath
			if prefix != "" {
				path = strings.TrimRight(prefix, "/") + "/" + strings.TrimLeft(path, "/")
			}
			handler := func(w stdhttp.ResponseWriter, r *stdhttp.Request) {
				if r.Method != httpMethod {
					w.WriteHeader(stdhttp.StatusMethodNotAllowed)
					return
				}
				gppRouteHandler(app, methodName, w, r)
			}
			if path == "/" {
				rootHandlers[httpMethod] = handler
				return
			}
			mux.HandleFunc(path, handler)
		}
		for _, route := range []struct {
			annotation string
			method     string
		}{
			{annotation: "gpp.http.GET", method: "GET"},
			{annotation: "gpp.http.POST", method: "POST"},
			{annotation: "gpp.http.PUT", method: "PUT"},
			{annotation: "gpp.http.PATCH", method: "PATCH"},
			{annotation: "gpp.http.DELETE", method: "DELETE"},
		} {
			if arguments := gppAnnotationArgs(method.Interface(), route.annotation); len(arguments) > 0 {
				register(fmt.Sprint(arguments[0]), route.method)
			}
		}
	}
	mux.HandleFunc("/", func(w stdhttp.ResponseWriter, r *stdhttp.Request) {
		if r.URL.Path == "/" {
			if handler := rootHandlers[r.Method]; handler != nil {
				handler(w, r)
				return
			}
		}
		ctx := Context(Response: w, Request: r, Values: map[string]any{})
		gppCallError(app, &ctx, stdhttp.StatusNotFound, nil)
	})
}

type gppTemplateStamp struct {
	Exists  bool
	ModTime int64
	Size    int64
}

func gppTemplateStamps(paths []string) map[string]gppTemplateStamp {
	stamps := map[string]gppTemplateStamp{}
	for _, path := range paths {
		info, err := os.Stat(path)
		if err != nil {
			stamps[path] = gppTemplateStamp{}
			continue
		}
		stamps[path] = gppTemplateStamp{Exists: true, ModTime: info.ModTime().UnixNano(), Size: info.Size()}
	}
	return stamps
}

func gppTemplateStampsChanged(previous, current map[string]gppTemplateStamp) bool {
	if len(previous) != len(current) {
		return true
	}
	for path, stamp := range current {
		if previous[path] != stamp {
			return true
		}
	}
	return false
}

func gppWatchTemplates(stop <-chan struct{}, done chan<- struct{}) {
	defer close(done)
	previous := gppTemplateStamps(tpl.ManagedSourcePaths())
	ticker := time.NewTicker(200 * time.Millisecond)
	defer ticker.Stop()
	for {
		select {
		case <-stop:
			return
		case <-ticker.C:
			current := gppTemplateStamps(tpl.ManagedSourcePaths())
			if !gppTemplateStampsChanged(previous, current) {
				continue
			}
			if err := tpl.Reload(); err != nil {
				log.Printf("gpp template reload failed: %v", err)
			}
			previous = current
		}
	}
}

const gppDefaultErrorTemplate = `<!doctype html>
<html>
<head>
    <title>{{.Code}} {{.Message}}</title>
</head>
<body>
    {{if eq .Code 404}}
        <h1>Page not found</h1>
    {{else if eq .Code 403}}
        <h1>Forbidden</h1>
    {{else}}
        <h1>{{.Code}} {{.Message}}</h1>
    {{end}}
</body>
</html>`

type gppHTTPErrorData struct {
	Code    int
	Message string
	Path    string
}

class Server {
	HTTPServer *stdhttp.Server
	ShutdownSetup *sync.Once
	ShutdownLifecycle *sync.Once
	ShutdownResult error
	TemplateWatchStop chan struct{}
	TemplateWatchDone chan struct{}
	TemplateWatchOnce *sync.Once

	func SetupShutdownHandler() {
		app := any(this)
		if this.GppDynamicObject != nil {
			app = this.GppDynamicObject
		}
		if this.ShutdownSetup == nil {
			this.ShutdownSetup = &sync.Once{}
		}
		this.ShutdownSetup.Do(func() {
			signals := make(chan os.Signal, 1)
			signal.Notify(signals, os.Interrupt, syscall.SIGTERM)
			go func() {
				<-signals
				signal.Stop(signals)
				ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
				defer cancel()
				gppCallShutdown(app, ctx)
			}()
		})
	}

	func BeforeListen() error {
		return nil
	}

	func AfterListen() error {
		return nil
	}

	func BeforeShutdown() error {
		return nil
	}

	func AfterShutdown() error {
		return nil
	}

	func BeforeRequest(ctx *Context) error {
		return nil
	}

	func AfterRequest(ctx *Context) error {
		return nil
	}

	func ErrorTemplate() string {
		return gppDefaultErrorTemplate
	}

	func Error(ctx *Context, code int, cause error) error {
		data := gppHTTPErrorData{
			Code: code,
			Message: stdhttp.StatusText(code),
			Path: ctx.Request.URL.Path,
		}
		if err := ctx.renderTemplate(code, this.ErrorTemplate(), data); err != nil {
			gppWriteMinimalError(ctx)
			return err
		}
		return nil
	}

	func Listen() error {
		app := any(this)
		if this.GppDynamicObject != nil {
			app = this.GppDynamicObject
		}
		descriptor := gppRuntimeClass(app)
		network := "tcp"
		address := ":0"
		if args := gppAnnotationArgs(descriptor, "gpp.http.Unix"); len(args) > 0 {
			network = "unix"
			address = fmt.Sprint(args[0])
		}
		if network == "tcp" {
			if args := gppAnnotationArgs(descriptor, "gpp.http.Port"); len(args) > 0 {
				address = ":" + fmt.Sprint(args[0])
			}
		}
		if network == "tcp" {
			if args := gppAnnotationArgs(descriptor, "gpp.http.IP"); len(args) > 0 {
				address = fmt.Sprint(args[0]) + address[strings.Index(address, ":"):]
			}
		}
		listener, err := net.Listen(network, address)
		if err != nil {
			return err
		}
		return this.Serve(listener)
	}

	func Serve(listener net.Listener) error {
		app := any(this)
		if this.GppDynamicObject != nil {
			app = this.GppDynamicObject
		}
		descriptor := gppRuntimeClass(app)
		mux := stdhttp.NewServeMux()
		prefix := ""
		if args := gppAnnotationArgs(descriptor, "gpp.http.Prefix"); len(args) > 0 {
			prefix = fmt.Sprint(args[0])
		}
		if args := gppAnnotationArgs(descriptor, "gpp.http.Files"); len(args) > 1 {
			path := fmt.Sprint(args[0])
			directory := fmt.Sprint(args[1])
			mux.Handle(path, stdhttp.StripPrefix(path, stdhttp.FileServer(stdhttp.Dir(directory))))
		}
		gppRegisterRoutes(mux, app, descriptor, prefix)
		this.HTTPServer = &stdhttp.Server{Handler: mux, Addr: listener.Addr().String()}
		if err := gppCallHook(app, "SetupShutdownHandler", nil); err != nil {
			_ = listener.Close()
			return err
		}
		if err := gppCallHook(app, "BeforeListen", nil); err != nil {
			_ = listener.Close()
			return err
		}
		ready := make(chan bool)
		done := make(chan error, 1)
		go gppServe(this.HTTPServer, listener, ready, done)
		<-ready
		if err := gppCallHook(app, "AfterListen", nil); err != nil {
			_ = this.Shutdown(context.Background())
			<-done
			return err
		}
		if len(tpl.ManagedSourcePaths()) > 0 {
			this.TemplateWatchStop = make(chan struct{})
			this.TemplateWatchDone = make(chan struct{})
			this.TemplateWatchOnce = &sync.Once{}
			go gppWatchTemplates(this.TemplateWatchStop, this.TemplateWatchDone)
		}
		serveErr := <-done
		this.StopTemplateWatcher()
		return serveErr
	}

	func StopTemplateWatcher() {
		if this.TemplateWatchOnce == nil {
			return
		}
		this.TemplateWatchOnce.Do(func() {
			close(this.TemplateWatchStop)
			<-this.TemplateWatchDone
		})
	}

	func Shutdown(ctx context.Context) error {
		app := any(this)
		if this.GppDynamicObject != nil {
			app = this.GppDynamicObject
		}
		if this.ShutdownLifecycle == nil {
			this.ShutdownLifecycle = &sync.Once{}
		}
		this.ShutdownLifecycle.Do(func() {
			this.StopTemplateWatcher()
			beforeErr := gppCallHook(app, "BeforeShutdown", nil)
			shutdownErr := error(nil)
			if this.HTTPServer != nil {
				shutdownErr = this.HTTPServer.Shutdown(ctx)
			}
			afterErr := gppCallHook(app, "AfterShutdown", nil)
			this.ShutdownResult = shutdownErr
			if this.ShutdownResult == nil {
				this.ShutdownResult = beforeErr
			}
			if this.ShutdownResult == nil {
				this.ShutdownResult = afterErr
			}
		})
		return this.ShutdownResult
	}
}
