package gpp.cron

import (
    "context"
    "errors"
    "fmt"
    "log"
    "strconv"
    "strings"
    "sync"
    "sync/atomic"
    "time"
)

type JobFunc func(context.Context) error

type registeredJob struct {
    name string
    expression string
    interval time.Duration
    every bool
    function JobFunc
}

type parsedSchedule struct {
    fields [5]cronField
    every time.Duration
}

type cronField struct {
    values map[int]bool
    star bool
}

type runningScheduler struct {
    cancel context.CancelFunc
    done chan struct{}
}

type schedulerState struct {
    sync.Mutex
    jobs []registeredJob
    running *runningScheduler
}

var cronState schedulerState

var ErrInvalidSchedule = errors.New("invalid cron schedule")

func registerJob(state *schedulerState, job registeredJob, allowExisting bool) error {
    if strings.TrimSpace(job.name) == "" {
        return errors.New("cron job name cannot be empty")
    }
    if job.function == nil {
        return fmt.Errorf("cron job %q has no function", job.name)
    }
    state.Lock()
    defer state.Unlock()
    if state.running != nil {
        if allowExisting {
            for _, existing := range state.jobs {
                if existing.name == job.name && existing.expression == job.expression && existing.interval == job.interval && existing.every == job.every {
                    return nil
                }
            }
        }
        return errors.New("cannot register cron jobs after Start")
    }
    for _, existing := range state.jobs {
        if existing.name == job.name {
            if allowExisting && existing.expression == job.expression && existing.interval == job.interval && existing.every == job.every {
                return nil
            }
            return fmt.Errorf("duplicate cron job %q", job.name)
        }
    }
    state.jobs = append(state.jobs, job)
    return nil
}

// Start validates all registered schedules and starts them in the background.
// It returns immediately; call Stop during application shutdown.
func Start() error {
	if err := registerAnnotatedFunctions(); err != nil {
		return err
	}
    return startScheduler(&cronState)
}

func registerAnnotatedFunctions() error {
	for _, function := range __gppRegisteredFunctions() {
		for _, annotation := range function.Annotations {
			if annotation.FullName != "gpp.cron.Cron" && annotation.FullName != "gpp.cron.Every" {
				continue
			}
			if function.Invoke == nil {
				return fmt.Errorf("cron function %s has no generated invoker", function.Name)
			}
			if len(function.Parameters) != 1 || function.Parameters[0].Type == nil || function.Parameters[0].Type.Name != "context.Context" || function.Result == nil || function.Result.Name != "error" {
				return fmt.Errorf("cron function %s must have signature func(context.Context) error", function.Name)
			}
			if len(annotation.Args) != 1 {
				return fmt.Errorf("cron annotation on %s requires one argument", function.Name)
			}
			job := registeredJob{name: function.Name}
			if annotation.FullName == "gpp.cron.Cron" {
				expression, ok := annotation.Args[0].(string)
				if !ok {
					return fmt.Errorf("cron expression on %s must be a string", function.Name)
				}
				job.expression = expression
			} else {
				interval, ok := annotation.Args[0].(time.Duration)
				if !ok {
					return fmt.Errorf("cron interval on %s must be a time.Duration", function.Name)
				}
				job.interval = interval
				job.every = true
			}
			job.function = func(ctx context.Context) error {
				results, err := function.Invoke([]any{ctx})
				if err != nil {
					return err
				}
				if len(results) != 1 || results[0] == nil {
					return nil
				}
				result, ok := results[0].(error)
				if !ok {
					return fmt.Errorf("cron function %s did not return error", function.Name)
				}
				return result
			}
			if err := registerJob(&cronState, job, true); err != nil {
				return err
			}
		}
	}
	return nil
}

func startScheduler(state *schedulerState) error {
    state.Lock()
    defer state.Unlock()
    if state.running != nil {
        return nil
    }
    jobs := append([]registeredJob(nil), state.jobs...)
    schedules := make([]parsedSchedule, len(jobs))
    for index, job := range jobs {
        if job.every {
            if job.interval <= 0 {
                return fmt.Errorf("%w: cron job %q interval must be positive", ErrInvalidSchedule, job.name)
            }
            schedules[index] = parsedSchedule{every: job.interval}
        } else {
            schedule, err := parseCronSchedule(job.expression)
            if err != nil {
                return fmt.Errorf("%w: cron job %q: %v", ErrInvalidSchedule, job.name, err)
            }
            schedules[index] = schedule
        }
    }

    ctx, cancel := context.WithCancel(context.Background())
    running := &runningScheduler{cancel: cancel, done: make(chan struct{})}
    state.running = running
    var workers sync.WaitGroup
    for index, job := range jobs {
        workers.Add(1)
        go runCronJob(ctx, job, schedules[index], &workers)
    }
    go func() {
        workers.Wait()
        close(running.done)
    }()
    return nil
}

// Stop cancels scheduled work and waits for running jobs to return or ctx to
// expire. A later Start call may start the registered jobs again.

func Stop() error {
	return stopScheduler(&cronState, context.Background())
}

func StopWithContext(ctx context.Context) error {
    return stopScheduler(&cronState, ctx)
}

func stopScheduler(state *schedulerState, ctx context.Context) error {
    if ctx == nil {
        ctx = context.Background()
    }
    state.Lock()
    running := state.running
    if running == nil {
        state.Unlock()
        return nil
    }
    running.cancel()
    state.Unlock()

    select {
    case <-running.done:
        state.Lock()
        if state.running == running {
            state.running = nil
        }
        state.Unlock()
        return nil
    case <-ctx.Done():
        return ctx.Err()
    }
}

func runCronJob(ctx context.Context, job registeredJob, schedule parsedSchedule, workers *sync.WaitGroup) {
    defer workers.Done()
    var running atomic.Bool
    run := func() {
        if ctx.Err() != nil {
            return
        }
        if !running.CompareAndSwap(false, true) {
            log.Printf("gpp/cron: skipped %s because its previous run is still active", job.name)
            return
        }
        workers.Add(1)
        go func() {
            defer workers.Done()
            defer running.Store(false)
            defer func() {
                if recovered := recover(); recovered != nil {
                    log.Printf("gpp/cron: job %s panicked: %v", job.name, recovered)
                }
            }()
            if err := job.function(ctx); err != nil {
                log.Printf("gpp/cron: job %s failed: %v", job.name, err)
            }
        }()
    }

    if schedule.every > 0 {
        ticker := time.NewTicker(schedule.every)
        defer ticker.Stop()
        for {
            select {
            case <-ctx.Done():
                return
            case <-ticker.C:
                run()
            }
        }
    }

    for {
        now := time.Now()
        next := now.Truncate(time.Minute).Add(time.Minute)
        timer := time.NewTimer(time.Until(next))
        select {
        case <-ctx.Done():
            timer.Stop()
            return
        case <-timer.C:
            if schedule.matches(next) {
                run()
            }
        }
    }
}

func (schedule parsedSchedule) matches(now time.Time) bool {
    values := [5]int{now.Minute(), now.Hour(), now.Day(), int(now.Month()), int(now.Weekday())}
    for _, index := range []int {0, 1, 3} {
        if !schedule.fields[index].values[values[index]] {
            return false
        }
    }
    dom := schedule.fields[2]
    dow := schedule.fields[4]
    if !dom.star && !dow.star {
        return dom.values[values[2]] || dow.values[values[4]]
    }
    return dom.values[values[2]] && dow.values[values[4]]
}

func parseCronSchedule(expression string) (parsedSchedule, error) {
    var result parsedSchedule
    expression = strings.TrimSpace(expression)
    parts := strings.Fields(expression)
    if len(parts) != 5 {
        return result, fmt.Errorf("expected five cron fields, got %q", expression)
    }
    ranges := [5][2]int{{0, 59}, {0, 23}, {1, 31}, {1, 12}, {0, 6}}
    for index, part := range parts {
        field, err := parseCronField(part, ranges[index][0], ranges[index][1])
        if err != nil {
            return result, fmt.Errorf("invalid field %d (%q): %w", index+1, part, err)
        }
        result.fields[index] = field
    }
    return result, nil
}

func parseCronField(source string, minimum int, maximum int) (cronField, error) {
    field := cronField{values: map[int]bool{}, star: source == "*"}
    for _, item := range strings.Split(source, ",") {
        base, stepText, hasStep := strings.Cut(item, "/")
        step := 1
        if hasStep {
            parsed, err := strconv.Atoi(stepText)
            if err != nil || parsed < 1 {
                return field, fmt.Errorf("step must be a positive integer")
            }
            step = parsed
        }
        start, end := minimum, maximum
        if base != "*" {
            if strings.Contains(base, "-") {
                bounds := strings.Split(base, "-")
                if len(bounds) != 2 {
                    return field, fmt.Errorf("invalid range %q", base)
                }
                var err error
                start, err = strconv.Atoi(bounds[0])
                if err != nil {
                    return field, fmt.Errorf("invalid range %q", base)
                }
                end, err = strconv.Atoi(bounds[1])
                if err != nil {
                    return field, fmt.Errorf("invalid range %q", base)
                }
            } else {
                value, err := strconv.Atoi(base)
                if err != nil {
                    return field, fmt.Errorf("expected a number, range, or wildcard")
                }
                start = value
                if !hasStep {
                    end = value
                }
            }
        }
        if start < minimum || end > maximum || start > end {
            return field, fmt.Errorf("value must be between %d and %d", minimum, maximum)
        }
        for value := start; value <= end; value += step {
            field.values[value] = true
        }
    }
    return field, nil
}
