package gpp.container

// Set is a map-backed set whose zero value is ready to use.
class Set[T comparable] {
	items map[T]bool

	func Add(value T) bool {
		if this.items == nil {
			this.items = make(map[T]bool)
		}
		if _, found := this.items[value]; found {
			return false
		}
		this.items[value] = true
		return true
	}

	func Remove(value T) bool {
		if _, found := this.items[value]; !found {
			return false
		}
		delete(this.items, value)
		return true
	}

	func Contains(value T) bool {
		_, found := this.items[value]
		return found
	}

	func Len() int {
		return len(this.items)
	}

	func IsEmpty() bool {
		return len(this.items) == 0
	}

	func Clear() {
		this.items = nil
	}

	func Values() []T {
		values := make([]T, 0, len(this.items))
		for value := range this.items {
			values = append(values, value)
		}
		return values
	}
}

// orderedMapEntry stores one insertion-ordered key/value pair.
class orderedMapEntry[K comparable, V any] {
	Key K
	Value V
	Active bool
}

// OrderedMapEntry is one key/value pair returned by OrderedMap.Entries.
class OrderedMapEntry[K comparable, V any] {
	Key K
	Value V
}

// OrderedMap maps keys to values while preserving insertion order. Its zero value is ready to use.
class OrderedMap[K comparable, V any] {
	entries []orderedMapEntry[K, V]
	indexes map[K]int
	size int

	func Set(key K, value V) {
		if index, found := this.indexes[key]; found {
			this.entries[index].Value = value
			return
		}
		if this.indexes == nil {
			this.indexes = make(map[K]int)
		}
		var entry orderedMapEntry[K, V]
		entry.Key = key
		entry.Value = value
		entry.Active = true
		this.indexes[key] = len(this.entries)
		this.entries = append(this.entries, entry)
		this.size++
	}

	func Get(key K) (V, bool) {
		index, found := this.indexes[key]
		if !found {
			var zero V
			return zero, false
		}
		return this.entries[index].Value, true
	}

	func Contains(key K) bool {
		_, found := this.indexes[key]
		return found
	}

	func Delete(key K) bool {
		index, found := this.indexes[key]
		if !found {
			return false
		}
		delete(this.indexes, key)
		var zeroKey K
		var zeroValue V
		this.entries[index].Key = zeroKey
		this.entries[index].Value = zeroValue
		this.entries[index].Active = false
		this.size--
		if this.size == 0 {
			this.entries = nil
			this.indexes = nil
			return true
		}
		if len(this.entries) >= 64 && len(this.entries) > this.size*2 {
			this.compact()
		}
		return true
	}

	func Len() int {
		return this.size
	}

	func IsEmpty() bool {
		return this.size == 0
	}

	func Clear() {
		this.entries = nil
		this.indexes = nil
		this.size = 0
	}

	func Keys() []K {
		keys := make([]K, 0, this.size)
		for _, entry := range this.entries {
			if entry.Active {
				keys = append(keys, entry.Key)
			}
		}
		return keys
	}

	func Values() []V {
		values := make([]V, 0, this.size)
		for _, entry := range this.entries {
			if entry.Active {
				values = append(values, entry.Value)
			}
		}
		return values
	}

	func Entries() []OrderedMapEntry[K, V] {
		entries := make([]OrderedMapEntry[K, V], 0, this.size)
		for _, entry := range this.entries {
			if entry.Active {
				var pair OrderedMapEntry[K, V]
				pair.Key = entry.Key
				pair.Value = entry.Value
				entries = append(entries, pair)
			}
		}
		return entries
	}

	func compact() {
		entries := make([]orderedMapEntry[K, V], 0, this.size)
		indexes := make(map[K]int, this.size)
		for _, entry := range this.entries {
			if !entry.Active {
				continue
			}
			indexes[entry.Key] = len(entries)
			entries = append(entries, entry)
		}
		this.entries = entries
		this.indexes = indexes
	}
}

// Stack is a last-in, first-out container. Its zero value is ready to use.
class Stack[T] {
	items []T

	func Push(value T) {
		this.items = append(this.items, value)
	}

	func Pop() (T, bool) {
		if len(this.items) == 0 {
			var zero T
			return zero, false
		}

		last := len(this.items) - 1
		value := this.items[last]
		var zero T
		this.items[last] = zero
		this.items = this.items[:last]
		return value, true
	}

	func Peek() (T, bool) {
		if len(this.items) == 0 {
			var zero T
			return zero, false
		}
		return this.items[len(this.items)-1], true
	}

	func Len() int {
		return len(this.items)
	}

	func IsEmpty() bool {
		return len(this.items) == 0
	}

	func Clear() {
		this.items = nil
	}
}

// Deque is a double-ended queue backed by a growable circular slice.
// Its zero value is ready to use.
class Deque[T] {
	items []T
	head int
	size int

	func grow() {
		capacity := len(this.items)
		newCapacity := 8
		if capacity > 0 {
			newCapacity = capacity * 2
		}

		items := make([]T, newCapacity)
		for index := 0; index < this.size; index++ {
			items[index] = this.items[(this.head+index)%capacity]
		}
		this.items = items
		this.head = 0
	}

	func PushFront(value T) {
		if this.size == len(this.items) {
			this.grow()
		}
		this.head = (this.head - 1 + len(this.items)) % len(this.items)
		this.items[this.head] = value
		this.size++
	}

	func PushBack(value T) {
		if this.size == len(this.items) {
			this.grow()
		}
		index := (this.head + this.size) % len(this.items)
		this.items[index] = value
		this.size++
	}

	func PopFront() (T, bool) {
		if this.size == 0 {
			var zero T
			return zero, false
		}

		value := this.items[this.head]
		var zero T
		this.items[this.head] = zero
		this.head = (this.head + 1) % len(this.items)
		this.size--
		if this.size == 0 {
			this.head = 0
		}
		return value, true
	}

	func PopBack() (T, bool) {
		if this.size == 0 {
			var zero T
			return zero, false
		}

		index := (this.head + this.size - 1) % len(this.items)
		value := this.items[index]
		var zero T
		this.items[index] = zero
		this.size--
		if this.size == 0 {
			this.head = 0
		}
		return value, true
	}

	func Front() (T, bool) {
		if this.size == 0 {
			var zero T
			return zero, false
		}
		return this.items[this.head], true
	}

	func Back() (T, bool) {
		if this.size == 0 {
			var zero T
			return zero, false
		}
		index := (this.head + this.size - 1) % len(this.items)
		return this.items[index], true
	}

	func Len() int {
		return this.size
	}

	func IsEmpty() bool {
		return this.size == 0
	}

	func Clear() {
		this.items = nil
		this.head = 0
		this.size = 0
	}
}

// Queue is a first-in, first-out container implemented using Deque.
// Its zero value is ready to use.
class Queue[T] {
	items Deque[T]

	func Enqueue(value T) {
		this.items.PushBack(value)
	}

	func Dequeue() (T, bool) {
		return this.items.PopFront()
	}

	func Peek() (T, bool) {
		return this.items.Front()
	}

	func Len() int {
		return this.items.Len()
	}

	func IsEmpty() bool {
		return this.items.IsEmpty()
	}

	func Clear() {
		this.items.Clear()
	}
}

// listNode is an internal typed node stored by List.
class listNode[T] {
	Value T
	Previous int
	Next int
}

// List is a doubly linked list with typed nodes. Its zero value is ready to use.
class List[T] {
	nodes []listNode[T]
	head int
	tail int
	freeHead int
	size int

	func allocate(value T, previous int, next int) int {
		var node listNode[T]
		node.Value = value
		node.Previous = previous
		node.Next = next

		if this.freeHead != 0 {
			index := this.freeHead
			this.freeHead = this.nodes[index].Next
			this.nodes[index] = node
			return index
		}

		if len(this.nodes) == 0 {
			var sentinel listNode[T]
			this.nodes = append(this.nodes, sentinel)
		}
		this.nodes = append(this.nodes, node)
		return len(this.nodes) - 1
	}

	func release(index int) T {
		value := this.nodes[index].Value
		var zero T
		this.nodes[index].Value = zero
		this.nodes[index].Previous = 0
		this.nodes[index].Next = this.freeHead
		this.freeHead = index
		this.size--
		return value
	}

	func PushFront(value T) {
		index := this.allocate(value, 0, this.head)
		if this.head == 0 {
			this.tail = index
		} else {
			this.nodes[this.head].Previous = index
		}
		this.head = index
		this.size++
	}

	func PushBack(value T) {
		index := this.allocate(value, this.tail, 0)
		if this.tail == 0 {
			this.head = index
		} else {
			this.nodes[this.tail].Next = index
		}
		this.tail = index
		this.size++
	}

	func PopFront() (T, bool) {
		if this.head == 0 {
			var zero T
			return zero, false
		}
		index := this.head
		next := this.nodes[index].Next
		this.head = next
		if next == 0 {
			this.tail = 0
		} else {
			this.nodes[next].Previous = 0
		}
		return this.release(index), true
	}

	func PopBack() (T, bool) {
		if this.tail == 0 {
			var zero T
			return zero, false
		}
		index := this.tail
		previous := this.nodes[index].Previous
		this.tail = previous
		if previous == 0 {
			this.head = 0
		} else {
			this.nodes[previous].Next = 0
		}
		return this.release(index), true
	}

	func Front() (T, bool) {
		if this.head == 0 {
			var zero T
			return zero, false
		}
		return this.nodes[this.head].Value, true
	}

	func Back() (T, bool) {
		if this.tail == 0 {
			var zero T
			return zero, false
		}
		return this.nodes[this.tail].Value, true
	}

	func Len() int {
		return this.size
	}

	func IsEmpty() bool {
		return this.size == 0
	}

	func Clear() {
		this.nodes = nil
		this.head = 0
		this.tail = 0
		this.freeHead = 0
		this.size = 0
	}

	func Values() []T {
		values := make([]T, 0, this.size)
		for index := this.head; index != 0; index = this.nodes[index].Next {
			values = append(values, this.nodes[index].Value)
		}
		return values
	}
}

// ringNode is an internal typed node stored by Ring.
class ringNode[T] {
	Value T
	Previous *ringNode[T]
	Next *ringNode[T]
}

// Ring stores values in a circular doubly linked sequence. Its zero value is ready to use.
class Ring[T] {
	first *ringNode[T]
	last *ringNode[T]
	current *ringNode[T]
	size int

	func PushFront(value T) {
		var node ringNode[T]
		node.Value = value
		if this.size == 0 {
			node.Previous = &node
			node.Next = &node
			this.first = &node
			this.last = &node
			this.current = &node
			this.size = 1
			return
		}

		node.Previous = this.last
		node.Next = this.first
		this.last.Next = &node
		this.first.Previous = &node
		this.first = &node
		this.size++
	}

	func PushBack(value T) {
		var node ringNode[T]
		node.Value = value
		if this.size == 0 {
			node.Previous = &node
			node.Next = &node
			this.first = &node
			this.last = &node
			this.current = &node
			this.size = 1
			return
		}

		node.Previous = this.last
		node.Next = this.first
		this.last.Next = &node
		this.first.Previous = &node
		this.last = &node
		this.size++
	}

	func Current() (T, bool) {
		if this.current == nil {
			var zero T
			return zero, false
		}
		return this.current.Value, true
	}

	func Next() (T, bool) {
		if this.current == nil {
			var zero T
			return zero, false
		}
		this.current = this.current.Next
		return this.current.Value, true
	}

	func Prev() (T, bool) {
		if this.current == nil {
			var zero T
			return zero, false
		}
		this.current = this.current.Previous
		return this.current.Value, true
	}

	func Move(steps int) (T, bool) {
		if this.current == nil {
			var zero T
			return zero, false
		}
		steps %= this.size
		for steps > 0 {
			this.current = this.current.Next
			steps--
		}
		for steps < 0 {
			this.current = this.current.Previous
			steps++
		}
		return this.current.Value, true
	}

	func RemoveCurrent() (T, bool) {
		if this.current == nil {
			var zero T
			return zero, false
		}

		node := this.current
		value := node.Value
		if this.size == 1 {
			this.first = nil
			this.last = nil
			this.current = nil
			this.size = 0
		} else {
			node.Previous.Next = node.Next
			node.Next.Previous = node.Previous
			if node == this.first {
				this.first = node.Next
			}
			if node == this.last {
				this.last = node.Previous
			}
			this.current = node.Next
			this.size--
		}
		var zero T
		node.Value = zero
		node.Previous = nil
		node.Next = nil
		return value, true
	}

	func Len() int {
		return this.size
	}

	func IsEmpty() bool {
		return this.size == 0
	}

	func Clear() {
		this.first = nil
		this.last = nil
		this.current = nil
		this.size = 0
	}

	func Values() []T {
		values := make([]T, 0, this.size)
		if this.first == nil {
			return values
		}
		node := this.first
		for index := 0; index < this.size; index++ {
			values = append(values, node.Value)
			node = node.Next
		}
		return values
	}
}

// PriorityQueue is a typed binary heap ordered by its less function.
// Construct it with NewPriorityQueue; its zero value is not usable.
class PriorityQueue[T] {
	items []T
	less func(T, T) bool

	static func New[U any](less func(U, U) bool) *PriorityQueue[U] {
		if less == nil {
			panic("gpp/container: priority queue comparator is nil")
		}
		var queue PriorityQueue[U]
		queue.items = []U{}
		queue.less = less
		return &queue
	}

	func Push(value T) {
		this.items = append(this.items, value)
		this.siftUp(len(this.items) - 1)
	}

	func Pop() (T, bool) {
		if len(this.items) == 0 {
			var zero T
			return zero, false
		}

		value := this.items[0]
		last := len(this.items) - 1
		lastValue := this.items[last]
		var zero T
		this.items[last] = zero
		this.items = this.items[:last]
		if len(this.items) > 0 {
			this.items[0] = lastValue
			this.siftDown(0)
		}
		return value, true
	}

	func Peek() (T, bool) {
		if len(this.items) == 0 {
			var zero T
			return zero, false
		}
		return this.items[0], true
	}

	func Len() int {
		return len(this.items)
	}

	func IsEmpty() bool {
		return len(this.items) == 0
	}

	func Clear() {
		this.items = nil
	}

	func siftUp(index int) {
		for index > 0 {
			parent := (index - 1) / 2
			if !this.less(this.items[index], this.items[parent]) {
				return
			}
			this.items[index], this.items[parent] = this.items[parent], this.items[index]
			index = parent
		}
	}

	func siftDown(index int) {
		for {
			left := index*2 + 1
			if left >= len(this.items) {
				return
			}
			higher := left
			right := left + 1
			if right < len(this.items) && this.less(this.items[right], this.items[left]) {
				higher = right
			}
			if !this.less(this.items[higher], this.items[index]) {
				return
			}
			this.items[index], this.items[higher] = this.items[higher], this.items[index]
			index = higher
		}
	}
}

func NewPriorityQueue[T](less func(T, T) bool) *PriorityQueue[T] {
	return PriorityQueue.New[T](less)
}
