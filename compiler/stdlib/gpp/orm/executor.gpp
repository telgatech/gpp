package gpp.orm

import sql "gpp/sql"

type SQLExecutor interface {
	sql.Executor
}

type gppORMHooks interface {
	Validate(exec SQLExecutor) error
	BeforeCreate(exec SQLExecutor) error
	AfterCreate(exec SQLExecutor) error
	BeforeUpdate(exec SQLExecutor) error
	AfterUpdate(exec SQLExecutor) error
	BeforeDelete(exec SQLExecutor) error
	AfterDelete(exec SQLExecutor) error
}
