package gpp.orm

import sql "gpp/sql"

type SQLExecutor interface {
	sql.Executor
}

type gppORMHooks interface {
	GppProtected_validate(exec SQLExecutor) error
	GppProtected_beforeCreate(exec SQLExecutor) error
	GppProtected_afterCreate(exec SQLExecutor) error
	GppProtected_beforeUpdate(exec SQLExecutor) error
	GppProtected_afterUpdate(exec SQLExecutor) error
	GppProtected_beforeDelete(exec SQLExecutor) error
	GppProtected_afterDelete(exec SQLExecutor) error
}
