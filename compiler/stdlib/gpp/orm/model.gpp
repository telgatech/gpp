package gpp.orm

import (
	"fmt"
	std "gpp/std"
)

class ValidationError {
	// Errors maps each invalid field name to its validation messages.
	Errors map[string][]string

	func Add(field string, message string) {
		if this.Errors == nil {
			this.Errors = map[string][]string{}
		}
		this.Errors[field] = append(this.Errors[field], message)
	}

	func IsEmpty() bool {
		return len(this.Errors) == 0
	}

	func Error() string {
		return fmt.Sprintf("orm: validation failed: %v", this.Errors)
	}
}

class Model {
	static func Get(exec SQLExecutor, where string, args ...any) (*self, error) {
		return gppORMGetModel[self](exec, where, args...)
	}

	static func Select(exec SQLExecutor, where string, args ...any) ([]*self, error) {
		return gppORMSelectModel[self](exec, where, args...)
	}

	static func All(exec SQLExecutor, sortBy string = "") ([]*self, error) {
		return AllModel[self](exec, sortBy)
	}

	static func Page(exec SQLExecutor, limit int = 50, afterID any = nil) ([]*self, error) {
		return PageModel[self](exec, limit, afterID)
	}

	static func Find(exec SQLExecutor, id any) (*self, error) {
		return FindModel[self](exec, id)
	}

	static func First(exec SQLExecutor, sortBy string = "") (*self, error) {
		return FirstModel[self](exec, sortBy)
	}

	static func Last(exec SQLExecutor, sortBy string = "") (*self, error) {
		return LastModel[self](exec, sortBy)
	}

	static func Truncate(exec SQLExecutor) error {
		return TruncateModel[self](exec)
	}

	func Destroy(exec SQLExecutor) error {
		entity := gppORMDynamicObject(this).(gppORMHooks)
		if err := entity.GppProtected_beforeDelete(exec); err != nil {
			return err
		}
		if err := gppORMDelete(exec, entity); err != nil {
			return err
		}
		return entity.GppProtected_afterDelete(exec)
	}

	func Insert(exec SQLExecutor) error {
		entity := gppORMDynamicObject(this).(gppORMHooks)
		if err := entity.GppProtected_validate(exec); err != nil {
			return err
		}
		if err := entity.GppProtected_beforeCreate(exec); err != nil {
			return err
		}
		if err := gppORMInsert(exec, entity); err != nil {
			return err
		}
		return entity.GppProtected_afterCreate(exec)
	}

	func Update(exec SQLExecutor) error {
		entity := gppORMDynamicObject(this).(gppORMHooks)
		if err := entity.GppProtected_validate(exec); err != nil {
			return err
		}
		if err := entity.GppProtected_beforeUpdate(exec); err != nil {
			return err
		}
		if err := gppORMUpdate(exec, entity); err != nil {
			return err
		}
		return entity.GppProtected_afterUpdate(exec)
	}

	func _validate(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func _beforeCreate(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func _afterCreate(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func _beforeUpdate(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func _afterUpdate(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func _beforeDelete(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func _afterDelete(exec SQLExecutor) error @{std.Hook} {
		return nil
	}
}
