package gpp.orm

class Model {
	func GppSQLGetQuery(where string) (string, error) {
		entity := gppORMDynamicObject(this)
		descriptor := gppORMRuntimeClass(entity)
		query, _, err := gppORMQuery(descriptor, where, "LIMIT 1")
		return query, err
	}

	func GppSQLSelectQuery(where string) (string, error) {
		entity := gppORMDynamicObject(this)
		descriptor := gppORMRuntimeClass(entity)
		query, _, err := gppORMQuery(descriptor, where, "")
		return query, err
	}

	func GppSQLScanTargets(columnNames []string) ([]any, error) {
		entity := gppORMDynamicObject(this)
		descriptor := gppORMRuntimeClass(entity)
		columns, err := gppORMColumns(descriptor)
		if err != nil {
			return nil, err
		}
		return gppORMModelScanTargets(entity, columnNames, columns)
	}

	static func Get(exec SQLExecutor, where string, args ...any) (*self, error) {
		return gppORMGetModel[self](exec, where, args...)
	}

	static func Select(exec SQLExecutor, where string, args ...any) ([]*self, error) {
		return gppORMSelectModel[self](exec, where, args...)
	}

	static func All(exec SQLExecutor, sortBy string = "") ([]*self, error) {
		return AllModel[self](exec, sortBy)
	}

	static func Page(exec SQLExecutor, limit int = 50, afterID any = nil) ([]*self, error) {
		return PageModel[self](exec, limit, afterID)
	}

	static func Find(exec SQLExecutor, id any) (*self, error) {
		return FindModel[self](exec, id)
	}

	static func First(exec SQLExecutor, sortBy string = "") (*self, error) {
		return FirstModel[self](exec, sortBy)
	}

	static func Last(exec SQLExecutor, sortBy string = "") (*self, error) {
		return LastModel[self](exec, sortBy)
	}

	static func Truncate(exec SQLExecutor) error {
		return TruncateModel[self](exec)
	}

	func Destroy(exec SQLExecutor) error {
		return gppORMDelete(exec, this)
	}

	func Insert(exec SQLExecutor) error {
		return gppORMInsert(exec, this)
	}

	func Update(exec SQLExecutor) error {
		return gppORMUpdate(exec, this)
	}

	func Validate(exec SQLExecutor) error {
		return nil
	}

	func BeforeCreate(exec SQLExecutor) error {
		return nil
	}

	func AfterCreate(exec SQLExecutor) error {
		return nil
	}

	func BeforeUpdate(exec SQLExecutor) error {
		return nil
	}

	func AfterUpdate(exec SQLExecutor) error {
		return nil
	}

	func BeforeDelete(exec SQLExecutor) error {
		return nil
	}

	func AfterDelete(exec SQLExecutor) error {
		return nil
	}
}
