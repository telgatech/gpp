package gpp.orm

import std "gpp/std"

class Model {
	static func Get(exec SQLExecutor, where string, args ...any) (*self, error) {
		return gppORMGetModel[self](exec, where, args...)
	}

	static func Select(exec SQLExecutor, where string, args ...any) ([]*self, error) {
		return gppORMSelectModel[self](exec, where, args...)
	}

	static func All(exec SQLExecutor, sortBy string = "") ([]*self, error) {
		return AllModel[self](exec, sortBy)
	}

	static func Page(exec SQLExecutor, limit int = 50, afterID any = nil) ([]*self, error) {
		return PageModel[self](exec, limit, afterID)
	}

	static func Find(exec SQLExecutor, id any) (*self, error) {
		return FindModel[self](exec, id)
	}

	static func First(exec SQLExecutor, sortBy string = "") (*self, error) {
		return FirstModel[self](exec, sortBy)
	}

	static func Last(exec SQLExecutor, sortBy string = "") (*self, error) {
		return LastModel[self](exec, sortBy)
	}

	static func Truncate(exec SQLExecutor) error {
		return TruncateModel[self](exec)
	}

	func Destroy(exec SQLExecutor) error {
		entity := gppORMDynamicObject(this).(gppORMHooks)
		if err := entity.BeforeDelete(exec); err != nil {
			return err
		}
		if err := gppORMDelete(exec, entity); err != nil {
			return err
		}
		return entity.AfterDelete(exec)
	}

	func Insert(exec SQLExecutor) error {
		entity := gppORMDynamicObject(this).(gppORMHooks)
		if err := entity.Validate(exec); err != nil {
			return err
		}
		if err := entity.BeforeCreate(exec); err != nil {
			return err
		}
		if err := gppORMInsert(exec, entity); err != nil {
			return err
		}
		return entity.AfterCreate(exec)
	}

	func Update(exec SQLExecutor) error {
		entity := gppORMDynamicObject(this).(gppORMHooks)
		if err := entity.Validate(exec); err != nil {
			return err
		}
		if err := entity.BeforeUpdate(exec); err != nil {
			return err
		}
		if err := gppORMUpdate(exec, entity); err != nil {
			return err
		}
		return entity.AfterUpdate(exec)
	}

	func Validate(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func BeforeCreate(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func AfterCreate(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func BeforeUpdate(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func AfterUpdate(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func BeforeDelete(exec SQLExecutor) error @{std.Hook} {
		return nil
	}

	func AfterDelete(exec SQLExecutor) error @{std.Hook} {
		return nil
	}
}
