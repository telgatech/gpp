package gpp.orm

import (
	"database/sql"
	"fmt"
	"reflect"
	"strings"
	std "gpp/std"
)

type gppORMColumn struct {
	Name string
	Field any
}

type gppORMRecordFieldProvider interface {
	GppORMRecordField(index int) any
}

func gppORMCanScanRecord(target any) bool {
	value := reflect.ValueOf(target)
	if !value.IsValid() || value.Kind() != reflect.Ptr || value.IsNil() || value.Elem().Kind() != reflect.Struct {
		return false
	}
	if _, ok := target.(gppORMRecordFieldProvider); ok {
		return true
	}
	typeOfRecord := value.Elem().Type()
	for index := 0; index < typeOfRecord.NumField(); index++ {
		if typeOfRecord.Field(index).PkgPath != "" {
			return false
		}
	}
	return true
}

func gppORMScalarScanTarget(target any) bool {
	if _, ok := target.(sql.Scanner); ok {
		return true
	}
	value := reflect.ValueOf(target)
	if !value.IsValid() || value.Kind() != reflect.Ptr || value.IsNil() {
		return false
	}
	return value.Elem().Kind() != reflect.Struct || !gppORMCanScanRecord(target)
}

func gppORMRecordScanTargets(target any, columnNames []string) ([]any, error) {
	value := reflect.ValueOf(target)
	if !value.IsValid() || value.Kind() != reflect.Ptr || value.IsNil() || value.Elem().Kind() != reflect.Struct {
		return nil, fmt.Errorf("orm: record target must be a non-nil pointer to a record")
	}
	provider, hasProvider := target.(gppORMRecordFieldProvider)
	typeOfRecord := value.Elem().Type()
	exactFields := make(map[string]int, typeOfRecord.NumField())
	normalizedFields := make(map[string]int, typeOfRecord.NumField())
	ambiguousFields := map[string]bool{}
	for index := 0; index < typeOfRecord.NumField(); index++ {
		name := typeOfRecord.Field(index).Name
		exactFields[name] = index
		normalized := gppORMNormalizeFieldName(name)
		if previous, exists := normalizedFields[normalized]; exists && previous != index {
			ambiguousFields[normalized] = true
		} else {
			normalizedFields[normalized] = index
		}
	}
	targets := make([]any, len(columnNames))
	usedFields := map[int]string{}
	for columnIndex, columnName := range columnNames {
		fieldIndex, exists := exactFields[columnName]
		if !exists {
			normalized := gppORMNormalizeFieldName(columnName)
			if ambiguousFields[normalized] {
				return nil, fmt.Errorf("orm: result column %q matches multiple fields; use an explicit SQL alias", columnName)
			}
			fieldIndex, exists = normalizedFields[normalized]
		}
		if !exists {
			targets[columnIndex] = new(any)
			continue
		}
		if previous, duplicate := usedFields[fieldIndex]; duplicate {
			return nil, fmt.Errorf("orm: result columns %q and %q both map to the same record field", previous, columnName)
		}
		var fieldTarget any
		if hasProvider {
			fieldTarget = provider.GppORMRecordField(fieldIndex)
		} else {
			field := value.Elem().Field(fieldIndex)
			if field.CanAddr() && field.CanInterface() {
				fieldTarget = field.Addr().Interface()
			}
		}
		if fieldTarget == nil {
			return nil, fmt.Errorf("orm: could not access record field %q", typeOfRecord.Field(fieldIndex).Name)
		}
		targets[columnIndex] = fieldTarget
		usedFields[fieldIndex] = columnName
	}
	return targets, nil
}

func gppORMModelScanTargets(target any, columnNames []string, columns []gppORMColumn) ([]any, error) {
	value := reflect.ValueOf(target)
	if !value.IsValid() || value.Kind() != reflect.Ptr || value.IsNil() || value.Elem().Kind() != reflect.Struct {
		return nil, fmt.Errorf("orm: model target must be a non-nil pointer to a model")
	}
	byName := map[string]gppORMColumn{}
	ambiguous := map[string]bool{}
	for _, column := range columns {
		name := gppORMNormalizeFieldName(column.Name)
		if _, exists := byName[name]; exists {
			ambiguous[name] = true
		}
		byName[name] = column
		field := reflect.ValueOf(column.Field)
		if field.Kind() == reflect.Pointer {
			field = field.Elem()
		}
		fieldName := gppORMNormalizeFieldName(fmt.Sprint(field.FieldByName("Name").Interface()))
		if fieldName != name {
			if _, exists := byName[fieldName]; exists {
				ambiguous[fieldName] = true
			}
			byName[fieldName] = column
		}
	}
	targets := make([]any, len(columnNames))
	used := map[string]string{}
	for index, name := range columnNames {
		normalized := gppORMNormalizeFieldName(name)
		column, exists := byName[normalized]
		if !exists {
			targets[index] = new(any)
			continue
		}
		if ambiguous[normalized] {
			return nil, fmt.Errorf("orm: result column %q matches multiple model columns", name)
		}
		if previous, duplicate := used[normalized]; duplicate {
			return nil, fmt.Errorf("orm: result columns %q and %q both map to the same model column", previous, name)
		}
		targets[index] = gppORMFieldAddr(column.Field, target)
		used[normalized] = name
	}
	return targets, nil
}

func gppORMNormalizeFieldName(value string) string {
	return strings.ToLower(strings.ReplaceAll(strings.ReplaceAll(value, "_", ""), "-", ""))
}

func gppORMIsSelectQuery(query string) bool {
	query = strings.ToUpper(strings.TrimSpace(query))
	for _, keyword := range []string{"SELECT", "WITH"} {
		if query == keyword || strings.HasPrefix(query, keyword+" ") || strings.HasPrefix(query, keyword+"\n") || strings.HasPrefix(query, keyword+"\t") {
			return true
		}
	}
	return false
}

func gppORMReflectIndex(value reflect.Value, index int) reflect.Value {
	return value.Index(index)
}

func gppORMRuntimeClass(value any) any {
	if value == nil {
		return nil
	}
	handler := reflect.ValueOf(value).MethodByName("GppRuntimeClass")
	if !handler.IsValid() {
		return nil
	}
	result := handler.Call(nil)
	if len(result) == 0 || !result[0].IsValid() || result[0].IsNil() {
		return nil
	}
	return result[0].Interface()
}

func gppORMDynamicObject(value any) any {
	reflected := reflect.ValueOf(value)
	if !reflected.IsValid() {
		return value
	}
	if reflected.Kind() == reflect.Pointer {
		if reflected.IsNil() {
			return value
		}
		reflected = reflected.Elem()
	}
	if reflected.Kind() != reflect.Struct {
		return value
	}
	dynamicObject := reflected.FieldByName("GppDynamicObject")
	if !dynamicObject.IsValid() || !dynamicObject.CanInterface() {
		return value
	}
	if dynamicObject.Kind() == reflect.Interface || dynamicObject.Kind() == reflect.Pointer {
		if dynamicObject.IsNil() {
			return value
		}
	}
	return dynamicObject.Interface()
}

func gppORMAnnotationArgs(owner any, name string) []any {
	if owner == nil {
		return nil
	}
	value := reflect.ValueOf(owner)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	if !value.IsValid() {
		return nil
	}
	annotations := value.FieldByName("Annotations")
	if !annotations.IsValid() {
		return nil
	}
	for index := 0; index < annotations.Len(); index++ {
		annotation := gppORMReflectIndex(annotations, index)
		annotationName := fmt.Sprint(annotation.FieldByName("Name").Interface())
		fullName := fmt.Sprint(annotation.FieldByName("FullName").Interface())
		if annotationName != name && fullName != name {
			continue
		}
		arguments := annotation.FieldByName("Args")
		result := make([]any, arguments.Len())
		for argIndex := 0; argIndex < arguments.Len(); argIndex++ {
			result[argIndex] = gppORMReflectIndex(arguments, argIndex).Interface()
		}
		return result
	}
	return nil
}

func gppORMFieldAnnotations(field any) any {
	value := reflect.ValueOf(field)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	return value.FieldByName("Annotations").Interface()
}

func gppORMColumns(descriptor any) ([]gppORMColumn, error) {
	if descriptor == nil {
		return nil, fmt.Errorf("orm: target has no Go++ runtime class")
	}
	value := reflect.ValueOf(descriptor)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	fields := value.FieldByName("Fields")
	columns := []gppORMColumn{}
	for index := 0; index < fields.Len(); index++ {
		field := gppORMReflectIndex(fields, index)
		args := gppORMAnnotationArgs(field.Interface(), "gpp.orm.Column")
		if len(args) == 0 {
			continue
		}
		columns = append(columns, gppORMColumn{Name: fmt.Sprint(args[0]), Field: field.Interface()})
	}
	if len(columns) == 0 {
		return nil, fmt.Errorf("orm: %s has no persisted columns", fmt.Sprint(value.FieldByName("Name").Interface()))
	}
	return columns, nil
}

func gppORMTable(descriptor any) (string, error) {
	args := gppORMAnnotationArgs(descriptor, "gpp.orm.Table")
	if len(args) == 0 {
		name := "model"
		if descriptor != nil {
			value := reflect.ValueOf(descriptor)
			if value.Kind() == reflect.Pointer {
				value = value.Elem()
			}
			if value.IsValid() {
				name = fmt.Sprint(value.FieldByName("Name").Interface())
			}
		}
		return "", fmt.Errorf("orm: %s has no Table annotation", name)
	}
	return fmt.Sprint(args[0]), nil
}

func gppORMFieldGet(field any, object any) any {
	value := reflect.ValueOf(field)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	getter := value.FieldByName("Get")
	return getter.Call([]reflect.Value{reflect.ValueOf(object)})[0].Interface()
}

func gppORMFieldAddr(field any, object any) any {
	value := reflect.ValueOf(field)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	addr := value.FieldByName("Addr")
	return addr.Call([]reflect.Value{reflect.ValueOf(object)})[0].Interface()
}

func gppORMHasPK(field any) bool {
	return gppORMHasAnnotation(gppORMFieldAnnotations(field), "gpp.orm.PK")
}

func gppORMHasAnnotation(owner any, name string) bool {
	if owner == nil {
		return false
	}
	value := reflect.ValueOf(owner)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	annotations := value
	for index := 0; index < annotations.Len(); index++ {
		annotation := gppORMReflectIndex(annotations, index)
		if fmt.Sprint(annotation.FieldByName("Name").Interface()) == name || fmt.Sprint(annotation.FieldByName("FullName").Interface()) == name {
			return true
		}
	}
	return false
}

func gppORMCallHook(entity any, name string, exec SQLExecutor) error {
	handler := reflect.ValueOf(entity).MethodByName(name)
	if !handler.IsValid() {
		return nil
	}
	result := handler.Call([]reflect.Value{reflect.ValueOf(exec)})
	if len(result) == 0 || result[0].IsNil() {
		return nil
	}
	return result[0].Interface().(error)
}

func gppORMQuery(descriptor any, where string, limit string) (string, []gppORMColumn, error) {
	table, err := gppORMTable(descriptor)
	if err != nil {
		return "", nil, err
	}
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return "", nil, err
	}
	names := []string{}
	for _, column := range columns {
		names = append(names, column.Name)
	}
	query := fmt.Sprintf("SELECT %s FROM %s", strings.Join(names, ", "), table)
	if strings.TrimSpace(where) != "" {
		query += " WHERE " + where
	}
	if limit != "" {
		query += " " + limit
	}
	return query, columns, nil
}

func gppORMInsert(exec SQLExecutor, entity any) error {
	entity = gppORMDynamicObject(entity)
	if err := gppORMCallHook(entity, "Validate", exec); err != nil {
		return err
	}
	if err := gppORMCallHook(entity, "BeforeCreate", exec); err != nil {
		return err
	}
	descriptor := gppORMRuntimeClass(entity)
	query, columns, err := gppORMQuery(descriptor, "", "")
	if err != nil {
		return err
	}
	names := []string{}
	values := []any{}
	for _, column := range columns {
		names = append(names, column.Name)
		values = append(values, gppORMFieldGet(column.Field, entity))
	}
	placeholders := []string{}
	for index := range names {
		placeholders = append(placeholders, "$"+fmt.Sprint(index+1))
	}
	table, _ := gppORMTable(descriptor)
	query = fmt.Sprintf("INSERT INTO %s (%s) VALUES (%s)", table, strings.Join(names, ", "), strings.Join(placeholders, ", "))
	if _, err := exec.Exec(query, values...); err != nil {
		return err
	}
	return gppORMCallHook(entity, "AfterCreate", exec)
}

func gppORMGetWhere(exec SQLExecutor, target any, where string, args ...any) error {
	targetValue := reflect.ValueOf(target)
	if !targetValue.IsValid() || targetValue.Kind() != reflect.Ptr || targetValue.IsNil() {
		return fmt.Errorf("Get target must be a non-nil pointer")
	}
	descriptor := gppORMRuntimeClass(target)
	if descriptor == nil {
		query := strings.TrimSpace(where)
		if !gppORMCanScanRecord(target) || gppORMScalarScanTarget(target) {
			if !gppORMIsSelectQuery(query) {
				return fmt.Errorf("orm: scalar Get requires a full SELECT query")
			}
			return exec.QueryRow(query, args...).Scan(target)
		}
		if !gppORMCanScanRecord(target) {
			return fmt.Errorf("orm: Get target must be a Go++ model or a record with accessible fields")
		}
		if !gppORMIsSelectQuery(query) {
			return fmt.Errorf("orm: record Get requires a full SELECT query")
		}
		rows, err := exec.Query(query, args...)
		if err != nil {
			return err
		}
		defer rows.Close()
		columnNames, err := rows.Columns()
		if err != nil {
			return err
		}
		if !rows.Next() {
			if err := rows.Err(); err != nil {
				return err
			}
			return sql.ErrNoRows
		}
		scanValues, err := gppORMRecordScanTargets(target, columnNames)
		if err != nil {
			return err
		}
		if err := rows.Scan(scanValues...); err != nil {
			return err
		}
		return rows.Err()
	}
	query, columns, err := gppORMQuery(descriptor, where, "LIMIT 1")
	if err != nil {
		return err
	}
	scanValues := []any{}
	for _, column := range columns {
		scanValues = append(scanValues, gppORMFieldAddr(column.Field, target))
	}
	return exec.QueryRow(query, args...).Scan(scanValues...)
}

func gppORMSelectWhere(exec SQLExecutor, target any, where string, args ...any) error {
	targetValue := reflect.ValueOf(target)
	if targetValue.Kind() != reflect.Ptr || targetValue.IsNil() || targetValue.Elem().Kind() != reflect.Slice {
		return fmt.Errorf("Select target must be a non-nil pointer to a model or record slice")
	}
	sliceElementType := targetValue.Elem().Type().Elem()
	elementType := sliceElementType
	elementIsPointer := elementType.Kind() == reflect.Ptr
	if elementIsPointer {
		elementType = elementType.Elem()
	}
	prototype := reflect.New(elementType).Interface()
	descriptor := gppORMRuntimeClass(prototype)
	if descriptor == nil {
		if gppORMScalarScanTarget(prototype) {
			query := strings.TrimSpace(where)
			if !gppORMIsSelectQuery(query) {
				return fmt.Errorf("orm: scalar Select requires a full SELECT query")
			}
			rows, err := exec.Query(query, args...)
			if err != nil {
				return err
			}
			defer rows.Close()
			for rows.Next() {
				itemValue := reflect.New(elementType)
				if err := rows.Scan(itemValue.Interface()); err != nil {
					return err
				}
				targetValue.Elem().Set(reflect.Append(targetValue.Elem(), itemValue.Elem()))
			}
			return rows.Err()
		}
		if elementType.Kind() != reflect.Struct {
			return fmt.Errorf("Select target slice must contain Go++ model, record, or scalar values")
		}
		if !gppORMCanScanRecord(prototype) {
			return fmt.Errorf("Select target slice must contain Go++ models or records with accessible fields")
		}
		query := strings.TrimSpace(where)
		if !gppORMIsSelectQuery(query) {
			return fmt.Errorf("orm: record Select requires a full SELECT query")
		}
		rows, err := exec.Query(query, args...)
		if err != nil {
			return err
		}
		defer rows.Close()
		columnNames, err := rows.Columns()
		if err != nil {
			return err
		}
		for rows.Next() {
			itemValue := reflect.New(elementType)
			item := itemValue.Interface()
			scanValues, err := gppORMRecordScanTargets(item, columnNames)
			if err != nil {
				return err
			}
			if err := rows.Scan(scanValues...); err != nil {
				return err
			}
			if elementIsPointer {
				targetValue.Elem().Set(reflect.Append(targetValue.Elem(), itemValue))
			} else {
				targetValue.Elem().Set(reflect.Append(targetValue.Elem(), itemValue.Elem()))
			}
		}
		return rows.Err()
	}
	query, columns, err := gppORMQuery(descriptor, where, "")
	if err != nil {
		return err
	}
	rows, err := exec.Query(query, args...)
	if err != nil {
		return err
	}
	defer rows.Close()
	for rows.Next() {
		itemValue := reflect.New(elementType)
		item := itemValue.Interface()
		scanValues := []any{}
		for _, column := range columns {
			scanValues = append(scanValues, gppORMFieldAddr(column.Field, item))
		}
		if err := rows.Scan(scanValues...); err != nil {
			return err
		}
		if elementIsPointer {
			targetValue.Elem().Set(reflect.Append(targetValue.Elem(), itemValue))
		} else {
			targetValue.Elem().Set(reflect.Append(targetValue.Elem(), itemValue.Elem()))
		}
	}
	return rows.Err()
}

func gppORMGetQuery(exec SQLExecutor, target any, query string, args ...any) error {
	targetValue := reflect.ValueOf(target)
	if !targetValue.IsValid() || targetValue.Kind() != reflect.Ptr || targetValue.IsNil() {
		return fmt.Errorf("Get target must be a non-nil pointer")
	}
	query = strings.TrimSpace(query)
	if !gppORMIsSelectQuery(query) {
		return fmt.Errorf("orm: Get requires a full SELECT query")
	}
	descriptor := gppORMRuntimeClass(target)
	if descriptor == nil && gppORMScalarScanTarget(target) {
		return exec.QueryRow(query, args...).Scan(target)
	}
	rows, err := exec.Query(query, args...)
	if err != nil {
		return err
	}
	defer rows.Close()
	columnNames, err := rows.Columns()
	if err != nil {
		return err
	}
	if !rows.Next() {
		if err := rows.Err(); err != nil {
			return err
		}
		return sql.ErrNoRows
	}
	var scanValues []any
	if descriptor != nil {
		columns, err := gppORMColumns(descriptor)
		if err != nil {
			return err
		}
		scanValues, err = gppORMModelScanTargets(target, columnNames, columns)
	} else {
		scanValues, err = gppORMRecordScanTargets(target, columnNames)
	}
	if err != nil {
		return err
	}
	if err := rows.Scan(scanValues...); err != nil {
		return err
	}
	return rows.Err()
}

func gppORMSelectQuery(exec SQLExecutor, target any, query string, args ...any) error {
	targetValue := reflect.ValueOf(target)
	if !targetValue.IsValid() || targetValue.Kind() != reflect.Ptr || targetValue.IsNil() || targetValue.Elem().Kind() != reflect.Slice {
		return fmt.Errorf("Select target must be a non-nil pointer to a result slice")
	}
	query = strings.TrimSpace(query)
	if !gppORMIsSelectQuery(query) {
		return fmt.Errorf("orm: Select requires a full SELECT query")
	}
	elementType := targetValue.Elem().Type().Elem()
	prototype := reflect.New(elementType).Interface()
	descriptor := gppORMRuntimeClass(prototype)
	if descriptor == nil && gppORMScalarScanTarget(prototype) {
		rows, err := exec.Query(query, args...)
		if err != nil {
			return err
		}
		defer rows.Close()
		for rows.Next() {
			item := reflect.New(elementType)
			if err := rows.Scan(item.Interface()); err != nil {
				return err
			}
			targetValue.Elem().Set(reflect.Append(targetValue.Elem(), item.Elem()))
		}
		return rows.Err()
	}
	if descriptor == nil && (elementType.Kind() != reflect.Struct || !gppORMCanScanRecord(prototype)) {
		return fmt.Errorf("Select target slice must contain models, records, or scalar values")
	}
	rows, err := exec.Query(query, args...)
	if err != nil {
		return err
	}
	defer rows.Close()
	columnNames, err := rows.Columns()
	if err != nil {
		return err
	}
	var columns []gppORMColumn
	if descriptor != nil {
		columns, err = gppORMColumns(descriptor)
		if err != nil {
			return err
		}
	}
	for rows.Next() {
		itemValue := reflect.New(elementType)
		item := itemValue.Interface()
		var scanValues []any
		if descriptor != nil {
			scanValues, err = gppORMModelScanTargets(item, columnNames, columns)
		} else {
			scanValues, err = gppORMRecordScanTargets(item, columnNames)
		}
		if err != nil {
			return err
		}
		if err := rows.Scan(scanValues...); err != nil {
			return err
		}
		targetValue.Elem().Set(reflect.Append(targetValue.Elem(), itemValue.Elem()))
	}
	return rows.Err()
}

func GetModel[T any](exec SQLExecutor, where string, args ...any) (*T, error) {
	target := new(T)
	if err := gppORMGetWhere(exec, target, where, args...); err != nil {
		return target, err
	}
	return target, nil
}

func SelectModel[T any](exec SQLExecutor, where string, args ...any) ([]*T, error) {
	var target []*T
	if err := gppORMSelectWhere(exec, &target, where, args...); err != nil {
		return target, err
	}
	return target, nil
}

func gppORMPrimaryKey(descriptor any) (string, error) {
	table, err := gppORMTable(descriptor)
	if err != nil {
		return "", err
	}
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return "", err
	}
	primaryKey := ""
	for _, column := range columns {
		if !gppORMHasPK(column.Field) {
			continue
		}
		if primaryKey != "" {
			return "", fmt.Errorf("orm: %s has multiple primary keys; composite keys are not supported", table)
		}
		primaryKey = column.Name
	}
	if primaryKey == "" {
		return "", fmt.Errorf("orm: %s has no primary key", table)
	}
	return primaryKey, nil
}

func gppORMOrderColumn(descriptor any, sortBy string) (string, error) {
	if strings.TrimSpace(sortBy) == "" {
		return gppORMPrimaryKey(descriptor)
	}
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return "", err
	}
	wanted := gppORMNormalizeFieldName(strings.TrimSpace(sortBy))
	matched := ""
	for _, column := range columns {
		field := reflect.ValueOf(column.Field)
		if field.Kind() == reflect.Pointer {
			field = field.Elem()
		}
		fieldName := fmt.Sprint(field.FieldByName("Name").Interface())
		if wanted != gppORMNormalizeFieldName(column.Name) && wanted != gppORMNormalizeFieldName(fieldName) {
			continue
		}
		if matched != "" {
			return "", fmt.Errorf("orm: sort field %q is ambiguous", sortBy)
		}
		matched = column.Name
	}
	if matched == "" {
		return "", fmt.Errorf("orm: sort field %q is not a persisted model field", sortBy)
	}
	return matched, nil
}

func FindModel[T any](exec SQLExecutor, id any) (*T, error) {
	target := new(T)
	descriptor := gppORMRuntimeClass(target)
	primaryKey, err := gppORMPrimaryKey(descriptor)
	if err != nil {
		return target, err
	}
	if err := gppORMGetWhere(exec, target, primaryKey+" = $1", id); err != nil {
		return target, err
	}
	return target, nil
}

func gppORMSelectModels[T any](exec SQLExecutor, query string, args ...any) ([]*T, error) {
	var values []T
	if err := gppORMSelectQuery(exec, &values, query, args...); err != nil {
		return nil, err
	}
	result := make([]*T, len(values))
	for index := range values {
		result[index] = &values[index]
	}
	return result, nil
}

func AllModel[T any](exec SQLExecutor, sortBy string) ([]*T, error) {
	descriptor := gppORMRuntimeClass(new(T))
	orderColumn, err := gppORMOrderColumn(descriptor, sortBy)
	if err != nil {
		return nil, err
	}
	query, _, err := gppORMQuery(descriptor, "", "ORDER BY "+orderColumn+" ASC")
	if err != nil {
		return nil, err
	}
	return gppORMSelectModels[T](exec, query)
}

func PageModel[T any](exec SQLExecutor, limit int, afterID any) ([]*T, error) {
	if limit <= 0 {
		return nil, fmt.Errorf("orm: page limit must be positive")
	}
	descriptor := gppORMRuntimeClass(new(T))
	primaryKey, err := gppORMPrimaryKey(descriptor)
	if err != nil {
		return nil, err
	}
	where := ""
	var args []any
	if afterID != nil {
		where = primaryKey + " > $1"
		args = append(args, afterID)
	}
	query, _, err := gppORMQuery(descriptor, where, fmt.Sprintf("ORDER BY %s ASC LIMIT %d", primaryKey, limit))
	if err != nil {
		return nil, err
	}
	return gppORMSelectModels[T](exec, query, args...)
}

func gppORMFirstOrLast[T any](exec SQLExecutor, sortBy string, direction string) (*T, error) {
	target := new(T)
	descriptor := gppORMRuntimeClass(target)
	orderColumn, err := gppORMOrderColumn(descriptor, sortBy)
	if err != nil {
		return target, err
	}
	query, columns, err := gppORMQuery(descriptor, "", "ORDER BY "+orderColumn+" "+direction+" LIMIT 1")
	if err != nil {
		return target, err
	}
	scanValues := make([]any, 0, len(columns))
	for _, column := range columns {
		scanValues = append(scanValues, gppORMFieldAddr(column.Field, target))
	}
	if err := exec.QueryRow(query).Scan(scanValues...); err != nil {
		return target, err
	}
	return target, nil
}

func FirstModel[T any](exec SQLExecutor, sortBy string) (*T, error) {
	return gppORMFirstOrLast[T](exec, sortBy, "ASC")
}

func LastModel[T any](exec SQLExecutor, sortBy string) (*T, error) {
	return gppORMFirstOrLast[T](exec, sortBy, "DESC")
}

func TruncateModel[T any](exec SQLExecutor) error {
	descriptor := gppORMRuntimeClass(new(T))
	table, err := gppORMTable(descriptor)
	if err != nil {
		return err
	}
	_, err = exec.Exec(fmt.Sprintf("DELETE FROM %s", table))
	return err
}

extend *sql.DB, *sql.Tx {
	func Get[T any](query string, args ...any) (T, error) {
		var target T
		if err := gppORMGetQuery(this, &target, query, args...); err != nil {
			return target, err
		}
		return target, nil
	}

	func Get(target any, where string, args ...any) error @{
		std.Deprecated("Use Get[T](query, args...) instead")
	} {
		return gppORMGetWhere(this, target, where, args...)
	}

	func Select[T any](query string, args ...any) ([]T, error) {
		var target []T
		if err := gppORMSelectQuery(this, &target, query, args...); err != nil {
			return target, err
		}
		return target, nil
	}

	func Select(target any, where string, args ...any) error @{
		std.Deprecated("Use Select[T](query, args...) instead")
	} {
		return gppORMSelectWhere(this, target, where, args...)
	}

}

func gppORMUpdate(exec SQLExecutor, entity any) error {
	entity = gppORMDynamicObject(entity)
	if err := gppORMCallHook(entity, "Validate", exec); err != nil {
		return err
	}
	if err := gppORMCallHook(entity, "BeforeUpdate", exec); err != nil {
		return err
	}
	descriptor := gppORMRuntimeClass(entity)
	table, err := gppORMTable(descriptor)
	if err != nil {
		return err
	}
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return err
	}
	primaryKey := ""
	var primaryValue any
	assignments := []string{}
	values := []any{}
	for _, column := range columns {
		if gppORMHasPK(column.Field) {
			if primaryKey != "" {
				return fmt.Errorf("orm: %s has multiple primary keys; composite keys are not supported", table)
			}
			primaryKey = column.Name
			primaryValue = gppORMFieldGet(column.Field, entity)
			continue
		}
		assignments = append(assignments, column.Name+" = $"+fmt.Sprint(len(values)+1))
		values = append(values, gppORMFieldGet(column.Field, entity))
	}
	if primaryKey == "" {
		return fmt.Errorf("orm: %s has no primary key", table)
	}
	values = append(values, primaryValue)
	query := fmt.Sprintf("UPDATE %s SET %s WHERE %s = $%d", table, strings.Join(assignments, ", "), primaryKey, len(values))
	if _, err := exec.Exec(query, values...); err != nil {
		return err
	}
	return gppORMCallHook(entity, "AfterUpdate", exec)
}

func gppORMDelete(exec SQLExecutor, entity any) error {
	entity = gppORMDynamicObject(entity)
	if err := gppORMCallHook(entity, "BeforeDelete", exec); err != nil {
		return err
	}
	descriptor := gppORMRuntimeClass(entity)
	table, err := gppORMTable(descriptor)
	if err != nil {
		return err
	}
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return err
	}
	primaryKey, err := gppORMPrimaryKey(descriptor)
	if err != nil {
		return err
	}
	var primaryValue any
	for _, column := range columns {
		if column.Name == primaryKey {
			primaryValue = gppORMFieldGet(column.Field, entity)
			break
		}
	}
	query := fmt.Sprintf("DELETE FROM %s WHERE %s = $1", table, primaryKey)
	if _, err := exec.Exec(query, primaryValue); err != nil {
		return err
	}
	return gppORMCallHook(entity, "AfterDelete", exec)
}
