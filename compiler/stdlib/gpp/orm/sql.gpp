package gpp.orm

import (
	"database/sql"
	"fmt"
	"reflect"
	"strings"
	"unicode"
)

type gppORMColumn struct {
	Name string
	Field any
}

func gppORMModelScanTargets(target any, columnNames []string, columns []gppORMColumn) ([]any, error) {
	value := reflect.ValueOf(target)
	if !value.IsValid() || value.Kind() != reflect.Ptr || value.IsNil() || value.Elem().Kind() != reflect.Struct {
		return nil, fmt.Errorf("orm: model target must be a non-nil pointer to a model")
	}
	byName := map[string]gppORMColumn{}
	ambiguous := map[string]bool{}
	for _, column := range columns {
		name := gppORMNormalizeFieldName(column.Name)
		if _, exists := byName[name]; exists {
			ambiguous[name] = true
		}
		byName[name] = column
		field := reflect.ValueOf(column.Field)
		if field.Kind() == reflect.Pointer {
			field = field.Elem()
		}
		fieldName := gppORMNormalizeFieldName(fmt.Sprint(field.FieldByName("Name").Interface()))
		if fieldName != name {
			if _, exists := byName[fieldName]; exists {
				ambiguous[fieldName] = true
			}
			byName[fieldName] = column
		}
	}
	targets := make([]any, len(columnNames))
	used := map[string]string{}
	for index, name := range columnNames {
		normalized := gppORMNormalizeFieldName(name)
		column, exists := byName[normalized]
		if !exists {
			targets[index] = new(any)
			continue
		}
		if ambiguous[normalized] {
			return nil, fmt.Errorf("orm: result column %q matches multiple model columns", name)
		}
		if previous, duplicate := used[normalized]; duplicate {
			return nil, fmt.Errorf("orm: result columns %q and %q both map to the same model column", previous, name)
		}
		targets[index] = gppORMFieldAddr(column.Field, target)
		used[normalized] = name
	}
	return targets, nil
}

func gppORMNormalizeFieldName(value string) string {
	return strings.ToLower(strings.ReplaceAll(strings.ReplaceAll(value, "_", ""), "-", ""))
}

func gppORMSnakeCase(value string) string {
	runes := []rune(value)
	var result strings.Builder
	for index, current := range runes {
		if index > 0 && unicode.IsUpper(current) {
			previous := runes[index-1]
			nextIsLower := index+1 < len(runes) && unicode.IsLower(runes[index+1])
			if unicode.IsLower(previous) || unicode.IsDigit(previous) || (unicode.IsUpper(previous) && nextIsLower) {
				result.WriteByte('_')
			}
		}
		result.WriteRune(unicode.ToLower(current))
	}
	return result.String()
}

func gppORMReflectIndex(value reflect.Value, index int) reflect.Value {
	return value.Index(index)
}

func gppORMRuntimeClass(value any) any {
	if value == nil {
		return nil
	}
	handler := reflect.ValueOf(value).MethodByName("GppRuntimeClass")
	if !handler.IsValid() {
		return nil
	}
	result := handler.Call(nil)
	if len(result) == 0 || !result[0].IsValid() || result[0].IsNil() {
		return nil
	}
	return result[0].Interface()
}

func gppORMDynamicObject(value any) any {
	reflected := reflect.ValueOf(value)
	if !reflected.IsValid() {
		return value
	}
	if reflected.Kind() == reflect.Pointer {
		if reflected.IsNil() {
			return value
		}
		reflected = reflected.Elem()
	}
	if reflected.Kind() != reflect.Struct {
		return value
	}
	dynamicObject := reflected.FieldByName("GppDynamicObject")
	if !dynamicObject.IsValid() || !dynamicObject.CanInterface() {
		return value
	}
	if dynamicObject.Kind() == reflect.Interface || dynamicObject.Kind() == reflect.Pointer {
		if dynamicObject.IsNil() {
			return value
		}
	}
	return dynamicObject.Interface()
}

func gppORMAnnotationArgs(owner any, name string) []any {
	if owner == nil {
		return nil
	}
	value := reflect.ValueOf(owner)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	if !value.IsValid() {
		return nil
	}
	annotations := value.FieldByName("Annotations")
	if !annotations.IsValid() {
		return nil
	}
	for index := 0; index < annotations.Len(); index++ {
		annotation := gppORMReflectIndex(annotations, index)
		annotationName := fmt.Sprint(annotation.FieldByName("Name").Interface())
		fullName := fmt.Sprint(annotation.FieldByName("FullName").Interface())
		if annotationName != name && fullName != name {
			continue
		}
		arguments := annotation.FieldByName("Args")
		result := make([]any, arguments.Len())
		for argIndex := 0; argIndex < arguments.Len(); argIndex++ {
			result[argIndex] = gppORMReflectIndex(arguments, argIndex).Interface()
		}
		return result
	}
	return nil
}

func gppORMFieldAnnotations(field any) any {
	value := reflect.ValueOf(field)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	return value.FieldByName("Annotations").Interface()
}

func gppORMColumns(descriptor any) ([]gppORMColumn, error) {
	if descriptor == nil {
		return nil, fmt.Errorf("orm: target has no Go++ runtime class")
	}
	value := reflect.ValueOf(descriptor)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	fields := value.FieldByName("Fields")
	columns := []gppORMColumn{}
	for index := 0; index < fields.Len(); index++ {
		field := gppORMReflectIndex(fields, index)
		if gppORMHasAnnotation(gppORMFieldAnnotations(field.Interface()), "gpp.orm.Ignore") {
			continue
		}
		args := gppORMAnnotationArgs(field.Interface(), "gpp.orm.Column")
		name := ""
		if len(args) > 0 {
			name = fmt.Sprint(args[0])
		} else {
			name = gppORMSnakeCase(fmt.Sprint(field.FieldByName("Name").Interface()))
		}
		columns = append(columns, gppORMColumn{Name: name, Field: field.Interface()})
	}
	if len(columns) == 0 {
		return nil, fmt.Errorf("orm: %s has no persisted columns", fmt.Sprint(value.FieldByName("Name").Interface()))
	}
	return columns, nil
}

func gppORMTable(descriptor any) (string, error) {
	args := gppORMAnnotationArgs(descriptor, "gpp.orm.Table")
	if len(args) > 0 {
		return fmt.Sprint(args[0]), nil
	}
	if descriptor == nil {
		return "", fmt.Errorf("orm: target has no Go++ runtime class")
	}
	value := reflect.ValueOf(descriptor)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	if !value.IsValid() || !value.FieldByName("Name").IsValid() {
		return "", fmt.Errorf("orm: target has no Go++ runtime class name")
	}
	return gppORMSnakeCase(fmt.Sprint(value.FieldByName("Name").Interface())), nil
}

func gppORMFieldGet(field any, object any) any {
	value := reflect.ValueOf(field)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	getter := value.FieldByName("Get")
	return getter.Call([]reflect.Value{reflect.ValueOf(object)})[0].Interface()
}

func gppORMFieldAddr(field any, object any) any {
	value := reflect.ValueOf(field)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	addr := value.FieldByName("Addr")
	return addr.Call([]reflect.Value{reflect.ValueOf(object)})[0].Interface()
}

func gppORMHasPK(field any) bool {
	return gppORMHasAnnotation(gppORMFieldAnnotations(field), "gpp.orm.PK")
}

func gppORMHasAnnotation(owner any, name string) bool {
	if owner == nil {
		return false
	}
	value := reflect.ValueOf(owner)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	annotations := value
	for index := 0; index < annotations.Len(); index++ {
		annotation := gppORMReflectIndex(annotations, index)
		if fmt.Sprint(annotation.FieldByName("Name").Interface()) == name || fmt.Sprint(annotation.FieldByName("FullName").Interface()) == name {
			return true
		}
	}
	return false
}

func gppORMQuery(descriptor any, where string, limit string) (string, []gppORMColumn, error) {
	table, err := gppORMTable(descriptor)
	if err != nil {
		return "", nil, err
	}
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return "", nil, err
	}
	names := []string{}
	for _, column := range columns {
		names = append(names, column.Name)
	}
	query := fmt.Sprintf("SELECT %s FROM %s", strings.Join(names, ", "), table)
	if strings.TrimSpace(where) != "" {
		query += " WHERE " + where
	}
	if limit != "" {
		query += " " + limit
	}
	return query, columns, nil
}

func gppORMInsert(exec SQLExecutor, entity any) error {
	entity = gppORMDynamicObject(entity)
	descriptor := gppORMRuntimeClass(entity)
	query, columns, err := gppORMQuery(descriptor, "", "")
	if err != nil {
		return err
	}
	names := []string{}
	values := []any{}
	for _, column := range columns {
		names = append(names, column.Name)
		values = append(values, gppORMFieldGet(column.Field, entity))
	}
	placeholders := []string{}
	for index := range names {
		placeholders = append(placeholders, "$"+fmt.Sprint(index+1))
	}
	table, _ := gppORMTable(descriptor)
	query = fmt.Sprintf("INSERT INTO %s (%s) VALUES (%s)", table, strings.Join(names, ", "), strings.Join(placeholders, ", "))
	if _, err := exec.Exec(query, values...); err != nil {
		return err
	}
	return nil
}

func gppORMGetWhere(exec SQLExecutor, target any, where string, args ...any) error {
	descriptor := gppORMRuntimeClass(target)
	if descriptor == nil {
		return fmt.Errorf("orm: Get target must be an ORM model")
	}
	query, columns, err := gppORMQuery(descriptor, where, "LIMIT 1")
	if err != nil {
		return err
	}
	scanValues := make([]any, 0, len(columns))
	for _, column := range columns {
		scanValues = append(scanValues, gppORMFieldAddr(column.Field, target))
	}
	return exec.QueryRow(query, args...).Scan(scanValues...)
}

func gppORMSelectWhere(exec SQLExecutor, target any, where string, args ...any) error {
	targetValue := reflect.ValueOf(target)
	if !targetValue.IsValid() || targetValue.Kind() != reflect.Ptr || targetValue.IsNil() || targetValue.Elem().Kind() != reflect.Slice {
		return fmt.Errorf("orm: Select target must be a non-nil pointer to a model slice")
	}
	elementType := targetValue.Elem().Type().Elem()
	elementIsPointer := elementType.Kind() == reflect.Ptr
	if elementIsPointer {
		elementType = elementType.Elem()
	}
	prototype := reflect.New(elementType).Interface()
	descriptor := gppORMRuntimeClass(prototype)
	if descriptor == nil {
		return fmt.Errorf("orm: Select target slice must contain ORM models")
	}
	query, columns, err := gppORMQuery(descriptor, where, "")
	if err != nil {
		return err
	}
	rows, err := exec.Query(query, args...)
	if err != nil {
		return err
	}
	defer rows.Close()
	for rows.Next() {
		itemValue := reflect.New(elementType)
		item := itemValue.Interface()
		scanValues := make([]any, 0, len(columns))
		for _, column := range columns {
			scanValues = append(scanValues, gppORMFieldAddr(column.Field, item))
		}
		if err := rows.Scan(scanValues...); err != nil {
			return err
		}
		if elementIsPointer {
			targetValue.Elem().Set(reflect.Append(targetValue.Elem(), itemValue))
		} else {
			targetValue.Elem().Set(reflect.Append(targetValue.Elem(), itemValue.Elem()))
		}
	}
	return rows.Err()
}

func gppORMGetModel[T any](exec SQLExecutor, where string, args ...any) (*T, error) {
	target := new(T)
	if err := gppORMGetWhere(exec, target, where, args...); err != nil {
		return target, err
	}
	return target, nil
}

func gppORMSelectModel[T any](exec SQLExecutor, where string, args ...any) ([]*T, error) {
	var target []*T
	if err := gppORMSelectWhere(exec, &target, where, args...); err != nil {
		return target, err
	}
	return target, nil
}

func gppORMIsSelectQuery(query string) bool {
	query = strings.ToUpper(strings.TrimSpace(query))
	for _, keyword := range []string{"SELECT", "WITH"} {
		if query == keyword || strings.HasPrefix(query, keyword+" ") || strings.HasPrefix(query, keyword+"\n") || strings.HasPrefix(query, keyword+"\t") {
			return true
		}
	}
	return false
}

func Get[T any](exec SQLExecutor, query string, args ...any) (*T, error) {
	target := new(T)
	if err := gppORMGetSQL(exec, target, query, args...); err != nil {
		return nil, err
	}
	return target, nil
}

func Select[T any](exec SQLExecutor, query string, args ...any) ([]*T, error) {
	var targets []*T
	if err := gppORMSelectSQL(exec, &targets, query, args...); err != nil {
		return targets, err
	}
	return targets, nil
}

func gppORMGetSQL(exec SQLExecutor, target any, query string, args ...any) error {
	if !gppORMIsSelectQuery(query) {
		return fmt.Errorf("orm: Get requires a full SELECT query")
	}
	value := reflect.ValueOf(target)
	if !value.IsValid() || value.Kind() != reflect.Ptr || value.IsNil() || value.Elem().Kind() != reflect.Struct {
		return fmt.Errorf("orm: Get target must be a non-nil pointer to a model")
	}
	descriptor := gppORMRuntimeClass(target)
	if descriptor == nil {
		return fmt.Errorf("orm: Get target must be an ORM model")
	}
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return err
	}
	rows, err := exec.Query(query, args...)
	if err != nil {
		return err
	}
	defer rows.Close()
	columnNames, err := rows.Columns()
	if err != nil {
		return err
	}
	if !rows.Next() {
		if err := rows.Err(); err != nil {
			return err
		}
		return sql.ErrNoRows
	}
	scanTargets, err := gppORMModelScanTargets(target, columnNames, columns)
	if err != nil {
		return err
	}
	if err := rows.Scan(scanTargets...); err != nil {
		return err
	}
	return rows.Err()
}

func gppORMSelectSQL(exec SQLExecutor, target any, query string, args ...any) error {
	if !gppORMIsSelectQuery(query) {
		return fmt.Errorf("orm: Select requires a full SELECT query")
	}
	targetValue := reflect.ValueOf(target)
	if !targetValue.IsValid() || targetValue.Kind() != reflect.Ptr || targetValue.IsNil() || targetValue.Elem().Kind() != reflect.Slice {
		return fmt.Errorf("orm: Select target must be a non-nil pointer to a model slice")
	}
	elementType := targetValue.Elem().Type().Elem()
	if elementType.Kind() == reflect.Ptr {
		elementType = elementType.Elem()
	}
	prototype := reflect.New(elementType).Interface()
	descriptor := gppORMRuntimeClass(prototype)
	if descriptor == nil {
		return fmt.Errorf("orm: Select target slice must contain ORM models")
	}
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return err
	}
	rows, err := exec.Query(query, args...)
	if err != nil {
		return err
	}
	defer rows.Close()
	columnNames, err := rows.Columns()
	if err != nil {
		return err
	}
	for rows.Next() {
		itemValue := reflect.New(elementType)
		item := itemValue.Interface()
		scanTargets, err := gppORMModelScanTargets(item, columnNames, columns)
		if err != nil {
			return err
		}
		if err := rows.Scan(scanTargets...); err != nil {
			return err
		}
		if targetValue.Elem().Type().Elem().Kind() == reflect.Ptr {
			targetValue.Elem().Set(reflect.Append(targetValue.Elem(), itemValue))
		} else {
			targetValue.Elem().Set(reflect.Append(targetValue.Elem(), itemValue.Elem()))
		}
	}
	return rows.Err()
}

func gppORMPrimaryKey(descriptor any) (string, error) {
	column, err := gppORMPrimaryKeyColumn(descriptor)
	if err != nil {
		return "", err
	}
	return column.Name, nil
}

func gppORMPrimaryKeyColumn(descriptor any) (gppORMColumn, error) {
	table, err := gppORMTable(descriptor)
	if err != nil {
		return gppORMColumn{}, err
	}
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return gppORMColumn{}, err
	}
	explicit := []gppORMColumn{}
	for _, column := range columns {
		if gppORMHasPK(column.Field) {
			explicit = append(explicit, column)
		}
	}
	if len(explicit) > 1 {
		return gppORMColumn{}, fmt.Errorf("orm: %s has multiple primary keys; composite keys are not supported", table)
	}
	if len(explicit) == 1 {
		return explicit[0], nil
	}

	conventional := []gppORMColumn{}
	for _, column := range columns {
		name := gppORMFieldName(column.Field)
		if name == "Id" || name == "ID" {
			conventional = append(conventional, column)
		}
	}
	if len(conventional) > 1 {
		return gppORMColumn{}, fmt.Errorf("orm: %s has both Id and ID fields; mark the primary key with orm.PK", table)
	}
	if len(conventional) == 1 {
		return conventional[0], nil
	}
	return gppORMColumn{}, fmt.Errorf("orm: %s has no primary key", table)
}

func gppORMFieldName(field any) string {
	value := reflect.ValueOf(field)
	if value.Kind() == reflect.Pointer {
		value = value.Elem()
	}
	return fmt.Sprint(value.FieldByName("Name").Interface())
}

func gppORMOrderColumn(descriptor any, sortBy string) (string, error) {
	if strings.TrimSpace(sortBy) == "" {
		return gppORMPrimaryKey(descriptor)
	}
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return "", err
	}
	wanted := gppORMNormalizeFieldName(strings.TrimSpace(sortBy))
	matched := ""
	for _, column := range columns {
		fieldName := gppORMFieldName(column.Field)
		if wanted != gppORMNormalizeFieldName(column.Name) && wanted != gppORMNormalizeFieldName(fieldName) {
			continue
		}
		if matched != "" {
			return "", fmt.Errorf("orm: sort field %q is ambiguous", sortBy)
		}
		matched = column.Name
	}
	if matched == "" {
		return "", fmt.Errorf("orm: sort field %q is not a persisted model field", sortBy)
	}
	return matched, nil
}

func FindModel[T any](exec SQLExecutor, id any) (*T, error) {
	target := new(T)
	descriptor := gppORMRuntimeClass(target)
	primaryKey, err := gppORMPrimaryKey(descriptor)
	if err != nil {
		return target, err
	}
	if err := gppORMGetWhere(exec, target, primaryKey+" = $1", id); err != nil {
		return target, err
	}
	return target, nil
}

func gppORMSelectModels[T any](exec SQLExecutor, query string, args ...any) ([]*T, error) {
	descriptor := gppORMRuntimeClass(new(T))
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return nil, err
	}
	rows, err := exec.Query(query, args...)
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	columnNames, err := rows.Columns()
	if err != nil {
		return nil, err
	}
	result := []*T{}
	for rows.Next() {
		item := new(T)
		scanValues, err := gppORMModelScanTargets(item, columnNames, columns)
		if err != nil {
			return nil, err
		}
		if err := rows.Scan(scanValues...); err != nil {
			return nil, err
		}
		result = append(result, item)
	}
	if err := rows.Err(); err != nil {
		return nil, err
	}
	return result, nil
}

func AllModel[T any](exec SQLExecutor, sortBy string) ([]*T, error) {
	descriptor := gppORMRuntimeClass(new(T))
	orderColumn, err := gppORMOrderColumn(descriptor, sortBy)
	if err != nil {
		return nil, err
	}
	query, _, err := gppORMQuery(descriptor, "", "ORDER BY "+orderColumn+" ASC")
	if err != nil {
		return nil, err
	}
	return gppORMSelectModels[T](exec, query)
}

func PageModel[T any](exec SQLExecutor, limit int, afterID any) ([]*T, error) {
	if limit <= 0 {
		return nil, fmt.Errorf("orm: page limit must be positive")
	}
	descriptor := gppORMRuntimeClass(new(T))
	primaryKey, err := gppORMPrimaryKey(descriptor)
	if err != nil {
		return nil, err
	}
	where := ""
	var args []any
	if afterID != nil {
		where = primaryKey + " > $1"
		args = append(args, afterID)
	}
	query, _, err := gppORMQuery(descriptor, where, fmt.Sprintf("ORDER BY %s ASC LIMIT %d", primaryKey, limit))
	if err != nil {
		return nil, err
	}
	return gppORMSelectModels[T](exec, query, args...)
}

func gppORMFirstOrLast[T any](exec SQLExecutor, sortBy string, direction string) (*T, error) {
	target := new(T)
	descriptor := gppORMRuntimeClass(target)
	orderColumn, err := gppORMOrderColumn(descriptor, sortBy)
	if err != nil {
		return target, err
	}
	query, columns, err := gppORMQuery(descriptor, "", "ORDER BY "+orderColumn+" "+direction+" LIMIT 1")
	if err != nil {
		return target, err
	}
	scanValues := make([]any, 0, len(columns))
	for _, column := range columns {
		scanValues = append(scanValues, gppORMFieldAddr(column.Field, target))
	}
	if err := exec.QueryRow(query).Scan(scanValues...); err != nil {
		return target, err
	}
	return target, nil
}

func FirstModel[T any](exec SQLExecutor, sortBy string) (*T, error) {
	return gppORMFirstOrLast[T](exec, sortBy, "ASC")
}

func LastModel[T any](exec SQLExecutor, sortBy string) (*T, error) {
	return gppORMFirstOrLast[T](exec, sortBy, "DESC")
}

func TruncateModel[T any](exec SQLExecutor) error {
	descriptor := gppORMRuntimeClass(new(T))
	table, err := gppORMTable(descriptor)
	if err != nil {
		return err
	}
	_, err = exec.Exec(fmt.Sprintf("DELETE FROM %s", table))
	return err
}

func gppORMUpdate(exec SQLExecutor, entity any) error {
	entity = gppORMDynamicObject(entity)
	descriptor := gppORMRuntimeClass(entity)
	table, err := gppORMTable(descriptor)
	if err != nil {
		return err
	}
	primaryColumn, err := gppORMPrimaryKeyColumn(descriptor)
	if err != nil {
		return err
	}
	primaryValue := gppORMFieldGet(primaryColumn.Field, entity)
	columns, err := gppORMColumns(descriptor)
	if err != nil {
		return err
	}
	assignments := []string{}
	values := []any{}
	for _, column := range columns {
		if gppORMFieldName(column.Field) == gppORMFieldName(primaryColumn.Field) {
			continue
		}
		assignments = append(assignments, column.Name+" = $"+fmt.Sprint(len(values)+1))
		values = append(values, gppORMFieldGet(column.Field, entity))
	}
	values = append(values, primaryValue)
	query := fmt.Sprintf("UPDATE %s SET %s WHERE %s = $%d", table, strings.Join(assignments, ", "), primaryColumn.Name, len(values))
	if _, err := exec.Exec(query, values...); err != nil {
		return err
	}
	return nil
}

func gppORMDelete(exec SQLExecutor, entity any) error {
	entity = gppORMDynamicObject(entity)
	descriptor := gppORMRuntimeClass(entity)
	table, err := gppORMTable(descriptor)
	if err != nil {
		return err
	}
	primaryColumn, err := gppORMPrimaryKeyColumn(descriptor)
	if err != nil {
		return err
	}
	primaryValue := gppORMFieldGet(primaryColumn.Field, entity)
	query := fmt.Sprintf("DELETE FROM %s WHERE %s = $1", table, primaryColumn.Name)
	if _, err := exec.Exec(query, primaryValue); err != nil {
		return err
	}
	return nil
}
