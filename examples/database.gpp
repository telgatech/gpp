package main

import (
	"database/sql"
	"fmt"
	"strings"
	_ "modernc.org/sqlite"
)

annotation (
	Table(name string) on class
	Column(name string) on field
	PK on field
)

class Model {
}

extend *sql.DB {
	func Insert(entity Model) error {
		table := entity.class.annotations.get(Table)
		columns := []string{}
		values := []any{}
		for field := range entity.class.fields {
			column := field.annotations.get(Column)
			if column == nil {
				continue
			}
			columns = append(columns, fmt.Sprint(column.args[0]))
			values = append(values, field.get(any(entity)))
		}
		placeholders := []string{}
		for range columns {
			placeholders = append(placeholders, "?")
		}
		query := fmt.Sprintf(
			"INSERT INTO %s (%s) VALUES (%s)",
			fmt.Sprint(table.args[0]), strings.Join(columns, ", "), strings.Join(placeholders, ", "),
		)
		_, err := this.Exec(query, values...)
		return err
	}

	func Update(entity Model) error {
		table := entity.class.annotations.get(Table)
		primaryKey := ""
		var primaryValue any
		assignments := []string{}
		values := []any{}
		for field := range entity.class.fields {
			column := field.annotations.get(Column)
			if column == nil || field.annotations.has(PK) {
				if column != nil && field.annotations.has(PK) {
					primaryKey = fmt.Sprint(column.args[0])
					primaryValue = field.get(any(entity))
				}
				continue
			}
			assignments = append(assignments, fmt.Sprint(column.args[0])+" = ?")
			values = append(values, field.get(any(entity)))
		}
		values = append(values, primaryValue)
		query := fmt.Sprintf(
			"UPDATE %s SET %s WHERE %s = ?",
			fmt.Sprint(table.args[0]), strings.Join(assignments, ", "), primaryKey,
		)
		_, err := this.Exec(query, values...)
		return err
	}

	func Find(entity Model, id int64) error {
		table := entity.class.annotations.get(Table)
		columns := []string{}
		scanValues := []any{}
		for field := range entity.class.fields {
			column := field.annotations.get(Column)
			if column == nil {
				continue
			}
			columns = append(columns, fmt.Sprint(column.args[0]))
			scanValues = append(scanValues, field.addr(any(entity)))
		}
		primaryKey := ""
		for field := range entity.class.fields {
			column := field.annotations.get(Column)
			if column != nil && field.annotations.has(PK) {
				primaryKey = fmt.Sprint(column.args[0])
			}
		}
		query := fmt.Sprintf(
			"SELECT %s FROM %s WHERE %s = ?",
			strings.Join(columns, ", "), fmt.Sprint(table.args[0]), primaryKey,
		)
		return this.QueryRow(query, id).Scan(scanValues...)
	}

	func Delete(entity Model) error {
		table := entity.class.annotations.get(Table)
		primaryKey := ""
		var primaryValue any
		for field := range entity.class.fields {
			column := field.annotations.get(Column)
			if column != nil && field.annotations.has(PK) {
				primaryKey = fmt.Sprint(column.args[0])
				primaryValue = field.get(any(entity))
			}
		}
		query := fmt.Sprintf("DELETE FROM %s WHERE %s = ?", fmt.Sprint(table.args[0]), primaryKey)
		_, err := this.Exec(query, primaryValue)
		return err
	}
}

class Employee : Model @{Table("employees")} {
	Id int64 @{Column("id"), PK}
	Name string @{Column("name")}
	Email string @{Column("email")}
}

func main() {
	var db *sql.DB
	var err error
	db, err = sql.Open("sqlite", ":memory:")
	if err != nil {
		panic(err)
	}
	defer db.Close()

	_, err = db.Exec(`
		CREATE TABLE employees (
			id INTEGER PRIMARY KEY,
			name TEXT NOT NULL,
			email TEXT NOT NULL
		)
	`)
	if err != nil {
		panic(err)
	}

	employee := Employee(1, "Ada Lovelace", "ada@example.com")
	if err := db.Insert(employee); err != nil {
		panic(err)
	}
	employee.Email = "ada@analytical.example"
	if err := db.Update(employee); err != nil {
		panic(err)
	}
	loaded := Employee()
	if err := db.Find(&loaded, employee.Id); err != nil {
		panic(err)
	}
	if err := db.Delete(loaded); err != nil {
		panic(err)
	}
	deleted := db.Find(&loaded, employee.Id) == sql.ErrNoRows

	fmt.Println("loaded after update:", loaded.Name, loaded.Email)
	fmt.Println("deleted:", deleted)
}
