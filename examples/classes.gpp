package main

import "fmt"

class Greeting {
    Name string

    func init(name string) {
        this.Name = name
    }

    func Message() string {
        return this._message() + ", " + this.Name
    }

    func _message() string {
        return "Hello"
    }
}

class PersonalizedGreeting : Greeting {
    Prefix string

    func init(name string, prefix string) {
        super(name)
        this.Prefix = prefix
    }

    func _message() string {
        return this.Prefix
    }
}

class Locale {
    Language string

    func init(language string) {
        this.Language = language
    }
}

class LocalizedGreeting : PersonalizedGreeting, Locale {
    func init(name, prefix, language string) {
        super[PersonalizedGreeting](name, prefix)
        super[Locale](language)
    }

    func Description() string {
        return this.Message() + " (" + this.Language + ")"
    }
}

func main() {
    greeting := Greeting("Ada")
    personalized := PersonalizedGreeting("Ada", "Welcome")
    localized := LocalizedGreeting("Ada", "Welcome", "en")

    fmt.Println(greeting.Message())
    fmt.Println(personalized.Message())
    fmt.Println(localized.Description())
}
