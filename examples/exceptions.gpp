package main

import (
    "errors"
    "fmt"
    "os"
)

class ValidationError {
    Field string
    Message string

    func Error() string {
        return this.Field + ": " + this.Message
    }
}

class PermissionError {
    Message string

    func Error() string {
        return this.Message
    }
}

func ReadConfig(path string) []byte {
    return os.ReadFile(path) //all trailing errors are automatically promoted to exceptions unless you handle it explicitly
}

func foo() error {
    return errors.New("foo unavailable")
}

func quux(fail bool=false) (int, int, error) {
    if fail {
        return 640, 480, errors.New("quux unavailable")
    } else {
        return 640, 480, nil
    }
}

func main() {
    try {
        data := ReadConfig("missing-config.json")
        fmt.Println(len(data))
    } catch os.PathError e {
        fmt.Println("path error:", e.Path)
    } catch e {
        fmt.Println("load error:", e)
    } finally {
        fmt.Println("load finished")
    }

    try {
        throw ValidationError(Field: "email", Message: "invalid")
    } catch ValidationError e {
        fmt.Println(e.Error())
    }

    try {
        throw PermissionError(Message: "permission denied")
    } catch ValidationError, PermissionError e {
        fmt.Println("client error:", e.Error())
    }

    // Single return value example
    // Handle foo error locally
    if err := foo();err!=nil {
        fmt.Println("explicit foo error:", err)
    }

    _ = foo() //handle foo error explicitly but discard it
    fmt.Println("dicard foo error and don't raise an exception")

    // Handle foo as an exception
    try {
        foo()
    } catch err {
        fmt.Println("foo failed:", err)
    }

    // Uncomment to let foo's non-nil error propagate out of main:
    // foo()

    // Multi return values example
    quux() // No exception, discard return values

    try {
        quux(true) // The int results are discarded; the trailing error still throws.
    } catch e {
        fmt.Println("quux failed:", e)
    }

    // Handle quux error explicitly
    width, height, quuxErr := quux(true)
    fmt.Println("explicit quux error:", width, height, quuxErr != nil)

    _, err := os.ReadFile("missing-config.json")
    fmt.Println("explicit error:", err != nil)
}
