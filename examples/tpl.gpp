import (
    "bytes"
    "fmt"
    "gpp/tpl"
	"strings"
)

class Post {
    ID int
    Title string
}

template PostCard(post Post) @{tpl.Path("/posts/{id}")} {
    <article data-id="{{param "id"}}">
        <h1>{{.Title}}</h1>
    </article>
}

template Layout() {
    <!doctype html>
    <html>
    <head><title>Go++ templates</title></head>
    <body>
        <header><a href="/">Go++ templates</a></header>
        <main>{{body}}</main>
    </body>
    </html>
}

template Page(post Post): Layout {
    <h1>{{.Title}}</h1>
    {{PostCard .}}
}

func main() {
    post := Post(ID: 42, Title: "Embedded templates")

    var output bytes.Buffer
    tpl.PostCard(&output, post)
    fmt.Print(output.String())

    output.Reset()
    tpl.Execute(&output, "/posts/42", post)
    fmt.Print(output.String())

    tpl.Funcs.Add("upper", strings.ToUpper)
    output.Reset()
    tpl.Page(&output, post)
    fmt.Print(output.String())

    output.Reset()
	 tpl.Execute(&output, "<strong>{{{{upper .}}}}</strong>", "ad-hoc template")
    fmt.Print(output.String())
}
