import "fmt"

class Person {
    Name string
    Manager *Person

    func Speak() string {
        return "Hello " + this.Name
    }
}

func main() {
    var person *Person

    // Safe access returns the member's zero value when person is nil.
    fmt.Println(person?.Name)
    fmt.Println(person?.Speak())

    // combine with fallback
    fmt.Println(person?.Name ?? "Unknown")
    fmt.Println(person?.Speak() ?? "Hello, stranger")

    person = &Person{Name: "Ada"}
    fmt.Println(person?.Name ?? "Unknown")
    fmt.Println(person?.Manager?.Name ?? "No manager")
}
