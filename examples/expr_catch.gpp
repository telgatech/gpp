package main

import "fmt"

var fallbackCalls int
var nilFallbackCalls int

func ParsePort(value string) (int, error) {
    if value == "" {
        return 0, fmt.Errorf("empty port")
    }
    return 8080, nil
}

func Fallback() int {
    fallbackCalls++
    return 42
}

func Broken() int {
    throw fmt.Errorf("broken")
    return 0
}

func NilPointer() *int {
    return nil
}

func FallbackPointer() *int {
    nilFallbackCalls++
    value := 1
    return &value
}

func main() {
    port := ParsePort("") ?? 8080
    configured := ParsePort("configured") ?? 8080
    offset := ParsePort("configured") + 1 ?? 9000
    chained := ParsePort("") ?? ParsePort("") ?? 3000
    recovered := Broken() ?? Fallback()
    pointer := NilPointer() ?? FallbackPointer() // nil is success, so this fallback is not called
    fmt.Println(port, configured, offset, chained, recovered, fallbackCalls)
    fmt.Println(pointer == nil, nilFallbackCalls)
}
