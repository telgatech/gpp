import "fmt"

func getUser() record {
    return record(
        name: fmt.Sprintf("%s", "Bob"),
        age: 42,
        profile: record(active: true),
    )
}

func userName(user record) string {
    return user.name
}

func main() {
    let user = getUser()
	users := []record{
		record(name: "Alice", age: 30, profile: record(active: false)),
	}
	byName := map[string]record{
		"bob": record(name: "Bob", age: 42, profile: record(active: true)),
	}

    fmt.Println(user.name, user.age, user.profile.active)
    fmt.Println(users[0].name, byName["bob"].age)
    fmt.Println(userName(user))
}
