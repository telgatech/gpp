import "fmt"

func getUser() record {
    return record(
        Name: fmt.Sprintf("%s", "Bob"),
        Age: 42,
        internal: "loaded from the database",
        Profile: record(Active: true),
    )
}

func userName(user record) string {
    return user.Name
}

func main() {
    let user = getUser()
	users := []record{
		record(Name: "Alice", Age: 30, internal: "list item", Profile: record(Active: false)),
	}
	byName := map[string]record{
		"bob": record(Name: "Bob", Age: 42, internal: "map item", Profile: record(Active: true)),
	}

    fmt.Println(user.Name, user.Age, user.internal, user.Profile.Active)
    fmt.Println(users[0].Name, byName["bob"].Age)
    fmt.Println(userName(user))
}
