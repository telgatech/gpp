import (
	"fmt"
	"regexp"
)

func main() {
	username := "ada"
	usernamePattern := "^[a-z]+$"
	compiledUsernamePattern := usernamePattern.CompileRegex()
	fmt.Println("valid username:", compiledUsernamePattern.MatchString(username))

	if "^[0-9]+$".CompileRegex().MatchString("12345") {
		fmt.Println("numeric value matched")
	}

	try {
		invalid := "[".CompileRegex()
		fmt.Println(invalid)
	} catch err {
		fmt.Println("invalid pattern:", err)
	}

	pattern := `^/users/[0-9]+$`
	re := regexp(pattern)
	fmt.Println("matches user path:", re.MatchString("/users/42"))

	path := "/users/42"
	switch path {
	case "/", regexp(pattern):
		fmt.Println("matched home or user path")
	case regexp(`^/health$`):
		fmt.Println("matched health path")
	default:
		fmt.Println("no path matched")
	}

	switch path {
	case regexp(`^/users/(?P<userID>[0-9]+)$`):
		fmt.Println("named capture:", match.userID)
		fmt.Println("full match:", match.Items[0])
		fmt.Println("first capture:", match.Items[1])
	}

	path = "/files/docs/readme"
	switch path {
	case regexp(`^/files/([^/]+)/([^/]+)$`):
		fmt.Println("unnamed captures:", match.Items[1], match.Items[2])
	}

	path = "/members/73"
	switch path {
	case regexp(`^/members/(?P<userID>[0-9]+)$`), regexp(`^/people/(?P<userID>[0-9]+)$`):
		fmt.Println("alternative capture:", match.userID, match.Items[1])
	}

	// The builtin call and the standard library package selector coexist.
	compiled, err := regexp.Compile(pattern)
	if err != nil {
		panic(err)
	}
	fmt.Println("stdlib selector:", compiled.MatchString("/users/42"))
}
