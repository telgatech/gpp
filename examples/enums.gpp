package main

import (
    "encoding/json"
    "fmt"
)

enum Status int {
    Pending
    Active = 7
    Disabled
}

enum Role string {
    User
    Admin = "administrator"
}

enum (
    Level uint8 {
        Low
        High
    }
)

func main() {
    try {
        status := Status.Active
        fmt.Println(status == Status.Active, status.name, status.value)
        autoStatus := Status.From(7)
        fmt.Println(autoStatus.name)
        for _, item := range Status.values {
            fmt.Println(item.name, item.value)
        }

        role := Role.From("administrator")
        fmt.Println(role.name, role.value)

        encoded := json.Marshal(Role.Admin)
        var decoded Role
        json.Unmarshal(encoded, &decoded)
        fmt.Println(Level.High.value, string(encoded), decoded.name)
    } catch err {
        fmt.Println("enum example:", err)
    }
}
