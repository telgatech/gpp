package main

import (
    "encoding/json"
    "fmt"
)

enum Status int {
    Pending
    Active = 7
    Disabled
}

enum Role string {
    User
    Admin = "administrator"
}

enum Level uint8 {
    Low
    High
}

// Every Status member must be handled here, or the switch needs a default case.
func printStatus(status Status) {
    switch status {
    case Status.Pending:
        fmt.Println("pending")
    case Status.Active:
        fmt.Println("active")
    case Status.Disabled:
        fmt.Println("disabled")
    }
}

func main() {
    try {
        status := Status.Active
        printStatus(status)
        fmt.Println(status == Status.Active, status.Name, status.Value)
        autoStatus := Status.From(7)
        fmt.Println(autoStatus.Name)
        for _, item := range Status.Values {
            fmt.Println(item.Name, item.Value)
        }

        role := Role.From("administrator")
        fmt.Println(role.Name, role.Value)

        encoded := json.Marshal(Role.Admin)
        var decoded Role
        json.Unmarshal(encoded, &decoded)
        fmt.Println(Level.High.Value, string(encoded), decoded.Name)
    } catch err {
        fmt.Println("enum example:", err)
    }
}
