package main

import (
    "fmt"
    htmltemplate "html/template"
    stdhttp "net/http"
    http "gpp/http"
)

func exampleTemplates() *htmltemplate.Template {
    views := htmltemplate.New("views")
    if _, err := views.Parse(`
{{define "Page"}}<h1>{{.}}</h1>{{end}}
{{define "ErrorPage"}}<h1>custom {{.Code}} {{.Message}}</h1><p>{{.Path}}</p>{{end}}
{{define "/api/users/{id}"}}<h1>User: {{.Name}}</h1>{{end}}
`); err != nil {
        panic(err)
    }
    return views
}

class HealthStatus {
    OK bool
}

class CreateUserRequest {
    Name string
    Email string
}

class AdminRoutes @{http.Mountable, http.Prefix("/v1")} {
    func Status(ctx *http.Context) error @{http.GET("/status")} {
        return ctx.JSON(struct(Area: "admin"))
    }
}

class App : http.Server @{http.IP("127.0.0.1"), http.Prefix("/api"), http.OpenAPI, http.Swagger} {
    func ErrorTemplate() string {
        return "ErrorPage"
    }

    func BeforeRequest(ctx *http.Context) error {
        ctx.Set("request-source", "GPP")
        return nil
    }

    func Home(ctx *http.Context, name string @{http.Path}) error @{
        http.GET("/hello/{name}"),
        http.Summary("Greet someone by name"),
        http.Description("Returns a plain-text greeting for the name in the URL."),
        http.Tags("Greetings")
    } {
        return ctx.Text(fmt.Sprintf("%s says hello to %s", ctx.Get("request-source"), name))
    }

    func Health(ctx *http.Context) error @{
        http.GET("/health"),
        http.Summary("Check service health"),
        http.Description("Reports whether the service is available."),
        http.Tags("Health"),
        http.ResponseBody(200, "Service is healthy", "application/json", HealthStatus{OK: true})
    } {
        return ctx.JSON(struct(OK: true))
    }

    func SearchUsers(ctx *http.Context, name string @{http.Query}, active bool @{http.Query}) error @{http.GET("/users")} {
        return ctx.JSON(200, struct(Name: name, Active: active))
    }

    func UserProfile(ctx *http.Context, id string @{http.Path}) error @{http.GET("/users/{id}")} {
        return ctx.HTML(200, struct(Name: id))
    }

    func CreateUser(ctx *http.Context, input *CreateUserRequest @{http.Body}) error @{http.POST("/users")} {
        return ctx.JSON(201, input)
    }

    func CreateUserFromRecord(ctx *http.Context) error @{http.POST("/users/record")} {
        input := ctx.Bind[struct(Name: string, Email: string)]()
        return ctx.JSON(201, input)
    }

    func Echo(ctx *http.Context) error @{http.WebSocket("/ws/echo")} {
        for {
            var message string
            if err := ctx.Conn.Read(&message); err != nil {
                return nil
            }
            if err := ctx.Conn.Write("echo: " + message); err != nil {
                return err
            }
        }
    }

    func Created(ctx *http.Context) error @{
        http.POST("/created"),
        http.Summary("Create a sample resource"),
        http.Description("Demonstrates a successful creation response."),
        http.Tags("Resources"),
        http.ResponseBody(201, "Resource created", "application/json", HealthStatus{OK: true})
    } {
        return ctx.JSON(201, struct(OK: true))
    }

    func Preview(ctx *http.Context) error @{
        http.GET("/preview"),
        http.Summary("Render the template preview"),
        http.Description("Returns a small HTML page rendered from html/template."),
        http.Tags("Templates")
    } {
        return ctx.HTML(200, "GPP HTTP", "Page")
    }

    func AfterRequest(ctx *http.Context) error {
        return nil
    }

    func BeforeShutdown() error {
        fmt.Println("server shutting down")
        return nil
    }

    func AfterShutdown() error {
        fmt.Println("server stopped")
        return nil
    }
}

func main() {
    try {
        app := App(Templates: exampleTemplates())
        app.Mount(AdminRoutes(), "/admin", "admin.localhost")
        app.Listen(0)
    } catch err {
        if err != stdhttp.ErrServerClosed {
            fmt.Println("HTTP example:", err)
        }
    }
}
