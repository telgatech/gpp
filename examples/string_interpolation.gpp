import "fmt"

func main() {
	name := "Ada"
	quantity := 3.0
	price := 12.5

	fmt.Println("Hello {{name}}")
	fmt.Println("Total: {{quantity * price:%.2f}}")

	message := fmt.Sprintf(`
Order for %s
Quantity: %v
Url: /users/%s
Path: C:\users\%s
`, name, quantity, name, name)
	fmt.Print(message)

	// Raw strings preserve html/template actions literally.
	templateSource := `<h1>{{.Name}}</h1>`
	fmt.Println(templateSource)
}
