import (
    "fmt"
    "io/fs"
)

embed (
    StaticFiles "examples/embed_assets/"
    Schema "examples/embed_schema.sql"
)

func main() {
    try {
        index := fs.ReadFile(StaticFiles, "index.html")
        fmt.Println(string(index))
        fmt.Println(string(Schema))
    } catch err {
        fmt.Println("embed example:", err)
    }
}
