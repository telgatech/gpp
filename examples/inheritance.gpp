import "fmt"

class Named {
    Name string
}

class Salaried {
    Salary int
}

class Employee: Named, Salaried {
    Role string

    func Summary() string {
        return "{{Name}} is a {{Role}} earning {{Salary}}"
    }
}

func main() {
    employee := Employee("Bob", 100000, "engineer")
    fmt.Println(employee.Summary())
}
