package main

import (
	"database/sql"
	"fmt"
	"reflect"
	"strings"
	_ "modernc.org/sqlite"
)

annotation (
	Table(name string) on class
	Column(name string) on field
	PK on field
)

class Model {
	func Validate() error {
		return nil
	}

	func BeforeCreate() error {
		return nil
	}

	func AfterCreate() error {
		return nil
	}

	func BeforeUpdate() error {
		return nil
	}

	func AfterUpdate() error {
		return nil
	}

	func BeforeDelete() error {
		return nil
	}

	func AfterDelete() error {
		return nil
	}
}

extend *sql.DB {
	func Get(target any, where string, args ...any) error {
		entity, ok := target.(interface {
			GppRuntimeClass() *GppClass
		})
		if !ok {
			return fmt.Errorf("Get target must be a Go++ model pointer")
		}
		descriptor := entity.GppRuntimeClass()
		table := descriptor.annotations.get(Table)
		columns := []string{}
		scanValues := []any{}
		for field := range descriptor.fields {
			column := field.annotations.get(Column)
			if column != nil {
				columns = append(columns, fmt.Sprint(column.args[0]))
				scanValues = append(scanValues, field.addr(any(entity)))
			}
		}
		query := fmt.Sprintf("SELECT %s FROM %s", strings.Join(columns, ", "), fmt.Sprint(table.args[0]))
		if strings.TrimSpace(where) != "" {
			query += " WHERE " + where
		}
		query += " LIMIT 1"
		return this.QueryRow(query, args...).Scan(scanValues...)
	}

	func Select(target any, where string, args ...any) error {
		targetValue := reflect.ValueOf(target)
		if targetValue.Kind() != reflect.Ptr || targetValue.IsNil() || targetValue.Elem().Kind() != reflect.Slice {
			return fmt.Errorf("Select target must be a non-nil pointer to a model slice")
		}

		elementType := targetValue.Elem().Type().Elem()
		if elementType.Kind() != reflect.Struct {
			return fmt.Errorf("Select target slice must contain Go++ model values")
		}
		prototypeValue := reflect.New(elementType)
		prototype, ok := prototypeValue.Interface().(interface {
			GppRuntimeClass() *GppClass
		})
		if !ok {
			return fmt.Errorf("Select target slice must contain a Go++ class")
		}
		descriptor := prototype.GppRuntimeClass()
		table := descriptor.annotations.get(Table)
		columns := []string{}
		for field := range descriptor.fields {
			column := field.annotations.get(Column)
			if column != nil {
				columns = append(columns, fmt.Sprint(column.args[0]))
			}
		}
		query := fmt.Sprintf("SELECT %s FROM %s", strings.Join(columns, ", "), fmt.Sprint(table.args[0]))
		if strings.TrimSpace(where) != "" {
			query += " WHERE " + where
		}
		rows, err := this.Query(query, args...)
		if err != nil {
			return err
		}
		defer rows.Close()

		for rows.Next() {
			itemValue := reflect.New(elementType)
			item, ok := itemValue.Interface().(interface {
				GppRuntimeClass() *GppClass
			})
			if !ok {
				return fmt.Errorf("Select target slice must contain a Go++ class")
			}
			scanValues := []any{}
			for field := range descriptor.fields {
				if field.annotations.get(Column) != nil {
					scanValues = append(scanValues, field.addr(any(item)))
				}
			}
			if err := rows.Scan(scanValues...); err != nil {
				return err
			}
			targetValue.Elem().Set(reflect.Append(targetValue.Elem(), itemValue.Elem()))
		}
		return rows.Err()
	}

	func Insert(entity Model) error {
		if err := entity.Validate(); err != nil {
			return err
		}
		if err := entity.BeforeCreate(); err != nil {
			return err
		}
		table := entity.class.annotations.get(Table)
		columns := []string{}
		values := []any{}
		for field := range entity.class.fields {
			column := field.annotations.get(Column)
			if column == nil {
				continue
			}
			columns = append(columns, fmt.Sprint(column.args[0]))
			values = append(values, field.get(any(entity)))
		}
		placeholders := []string{}
		for index := range columns {
			placeholders = append(placeholders, "$"+fmt.Sprint(index+1))
		}
		query := fmt.Sprintf(
			"INSERT INTO %s (%s) VALUES (%s)",
			fmt.Sprint(table.args[0]), strings.Join(columns, ", "), strings.Join(placeholders, ", "),
		)
		if _, err := this.Exec(query, values...); err != nil {
			return err
		}
		return entity.AfterCreate()
	}

	func Update(entity Model) error {
		if err := entity.Validate(); err != nil {
			return err
		}
		if err := entity.BeforeUpdate(); err != nil {
			return err
		}
		table := entity.class.annotations.get(Table)
		primaryKey := ""
		var primaryValue any
		assignments := []string{}
		values := []any{}
		for field := range entity.class.fields {
			column := field.annotations.get(Column)
			if column == nil || field.annotations.has(PK) {
				if column != nil && field.annotations.has(PK) {
					primaryKey = fmt.Sprint(column.args[0])
					primaryValue = field.get(any(entity))
				}
				continue
			}
			assignments = append(assignments, fmt.Sprint(column.args[0])+" = $"+fmt.Sprint(len(values)+1))
			values = append(values, field.get(any(entity)))
		}
		values = append(values, primaryValue)
		query := fmt.Sprintf(
			"UPDATE %s SET %s WHERE %s = $%d",
			fmt.Sprint(table.args[0]), strings.Join(assignments, ", "), primaryKey, len(values),
		)
		if _, err := this.Exec(query, values...); err != nil {
			return err
		}
		return entity.AfterUpdate()
	}

	func Delete(entity Model) error {
		if err := entity.BeforeDelete(); err != nil {
			return err
		}
		table := entity.class.annotations.get(Table)
		primaryKey := ""
		var primaryValue any
		for field := range entity.class.fields {
			column := field.annotations.get(Column)
			if column != nil && field.annotations.has(PK) {
				primaryKey = fmt.Sprint(column.args[0])
				primaryValue = field.get(any(entity))
			}
		}
		query := fmt.Sprintf("DELETE FROM %s WHERE %s = $1", fmt.Sprint(table.args[0]), primaryKey)
		if _, err := this.Exec(query, primaryValue); err != nil {
			return err
		}
		return entity.AfterDelete()
	}
}

class Employee : Model @{Table("employees")} {
	Id int64 @{Column("id"), PK}
	Name string @{Column("name")}
	Email string @{Column("email")}

	func Validate() error {
		if strings.TrimSpace(this.Name) == "" {
			return fmt.Errorf("employee name is required")
		}
		if strings.TrimSpace(this.Email) == "" {
			return fmt.Errorf("employee email is required")
		}
		return nil
	}

	func BeforeCreate() error {
		this.Email = strings.ToLower(strings.TrimSpace(this.Email))
		return nil
	}

	func BeforeUpdate() error {
		this.Email = strings.ToLower(strings.TrimSpace(this.Email))
		return nil
	}

	func AfterCreate() error {
		fmt.Println("created:", this.Name)
		return nil
	}

	func AfterUpdate() error {
		fmt.Println("updated:", this.Name)
		return nil
	}

	func AfterDelete() error {
		fmt.Println("deleted employee:", this.Name)
		return nil
	}
}

func main() {
	var db *sql.DB
	var err error
	db, err = sql.Open("sqlite", ":memory:")
	if err != nil {
		panic(err)
	}
	defer db.Close()

	_, err = db.Exec(`
		CREATE TABLE employees (
			id INTEGER PRIMARY KEY,
			name TEXT NOT NULL,
			email TEXT NOT NULL
		)
	`)
	if err != nil {
		panic(err)
	}

	invalid := Employee(2, "", "invalid@example.com")
	if err := db.Insert(&invalid); err != nil {
		fmt.Println("validation:", err)
	}

	employee := Employee(1, "Ada Lovelace", "ada@example.com")
	if err := db.Insert(&employee); err != nil {
		panic(err)
	}
	second := Employee(2, "Grace Hopper", "grace@example.com")
	if err := db.Insert(&second); err != nil {
		panic(err)
	}
	employee.Email = " ADA@ANALYTICAL.EXAMPLE "
	if err := db.Update(&employee); err != nil {
		panic(err)
	}
	employees := []Employee{}
	if err := db.Select(&employees, "email LIKE $1", "%example.com"); err != nil {
		panic(err)
	}
	target := Employee()
	if err := db.Get(&target, "name = $1", "Ada Lovelace"); err != nil {
		panic(err)
	}
	fmt.Println("selected:", len(employees), "get:", target.Name)
	loaded := Employee()
	if err := db.Get(&loaded, "id = $1", employee.Id); err != nil {
		panic(err)
	}
	if err := db.Delete(&loaded); err != nil {
		panic(err)
	}
	deleted := db.Get(&loaded, "id = $1", employee.Id) == sql.ErrNoRows

	fmt.Println("loaded after update:", loaded.Name, loaded.Email)
	fmt.Println("deleted:", deleted)
}
