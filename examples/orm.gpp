package main

import (
	"database/sql"
	"fmt"
	_ "modernc.org/sqlite"
	orm "gpp/orm"
)

class Event : orm.Model @{orm.Table("employee_events")} {
	EmployeeId int64 @{orm.Column("employee_id")}
	Action     string @{orm.Column("event")}
}

class Employee : orm.Model @{orm.Table("employees")} {
	Id int64 @{orm.Column("id"), orm.PK}
	Name string @{orm.Column("name")}
	Email string @{orm.Column("email")}

	func RecordEvent(exec orm.SQLExecutor, action string) error {
		event := Event(this.Id, action)
		return orm.Insert(exec, event)
	}

	func Validate(exec orm.SQLExecutor) error {
		if this.Name.IsBlank() {
			return fmt.Errorf("employee name is required")
		}
		if this.Email.IsBlank() {
			return fmt.Errorf("employee email is required")
		}
		return nil
	}

	func BeforeCreate(exec orm.SQLExecutor) error {
		this.Email = this.Email.TrimSpace().ToLower()
		return this.RecordEvent(exec, "before_create")
	}

	func BeforeUpdate(exec orm.SQLExecutor) error {
		this.Email = this.Email.TrimSpace().ToLower()
		return this.RecordEvent(exec, "before_update")
	}

	func AfterCreate(exec orm.SQLExecutor) error {
		fmt.Println("created:", this.Name)
		return this.RecordEvent(exec, "after_create")
	}

	func AfterUpdate(exec orm.SQLExecutor) error {
		fmt.Println("updated:", this.Name)
		return this.RecordEvent(exec, "after_update")
	}

	func AfterDelete(exec orm.SQLExecutor) error {
		fmt.Println("deleted employee:", this.Name)
		return this.RecordEvent(exec, "after_delete")
	}

	func BeforeDelete(exec orm.SQLExecutor) error {
		return this.RecordEvent(exec, "before_delete")
	}
}

func main() {
	try {
		db := sql.Open("sqlite", ":memory:")
		defer db.Close()

		db.Exec(`
		CREATE TABLE employees (
			id INTEGER PRIMARY KEY,
			name TEXT NOT NULL,
			email TEXT NOT NULL
		)
	`)
		db.Exec(`
		CREATE TABLE employee_events (
			employee_id INTEGER NOT NULL,
			event TEXT NOT NULL
		)
	`)

		employee := Employee(1, "Ada Lovelace", "ada@example.com")
		db.Insert(employee)

		second := Employee(2, "Grace Hopper", "grace@example.com")
		tx := db.Begin()
		defer tx.Rollback()
		tx.Insert(second)
		employee.Email = " ADA@ANALYTICAL.EXAMPLE "
		tx.Update(employee)
		employees := Employee.Select(tx, "email LIKE $1", "%example.com")
		target := Employee.Get(tx, "name = $1", "Ada Lovelace")
		tx.Commit()
		fmt.Println("transaction:", len(employees), "selected, get:", target.Name)

		loaded := Employee.Get(db, "id = $1", employee.Id)
		tx = db.Begin()
		defer tx.Rollback()
		tx.Delete(loaded)
		tx.Commit()
		deleted := len(Employee.Select(db, "id = $1", employee.Id)) == 0

		fmt.Println("loaded after update:", loaded.Name, loaded.Email)
		fmt.Println("deleted:", deleted)

		db.Exec("INSERT INTO employee_events (employee_id, event) VALUES ($1, $2)", int64(99), "record_scan")
		events, err := db.Select[record(employee_id: int64, event: string)]("SELECT employee_id, event, 'discarded' AS ignored FROM employee_events WHERE employee_id = $1", int64(99))
		if err != nil {
			panic(err)
		}
		if len(events) != 1 || events[0].employee_id != 99 || events[0].event != "record_scan" {
			panic("record Select did not scan query results")
		}
		fmt.Println("record select:", events[0].employee_id, events[0].event)
		event, err := db.Get[record(employee_id: int64, event: string)]("SELECT employee_id, event, 'discarded' AS ignored FROM employee_events WHERE employee_id = $1", int64(99))
		if err != nil {
			panic(err)
		}
		if event.employee_id != 99 || event.event != "record_scan" {
			panic("record Get did not scan query result")
		}
		eventName, err := db.Get[string]("SELECT event FROM employee_events WHERE employee_id = $1", int64(99))
		if err != nil {
			panic(err)
		}
		if eventName != "record_scan" {
			panic("scalar Get did not scan one column")
		}
		eventNames, err := db.Select[string]("SELECT event FROM employee_events WHERE employee_id = $1", int64(99))
		if err != nil {
			panic(err)
		}
		if len(eventNames) != 1 || eventNames[0] != "record_scan" {
			panic("scalar Select did not scan one column per row")
		}
	} catch err {
		fmt.Println("ORM example:", err)
	}
}
