package main

import (
    "database/sql"
    "fmt"
    _ "modernc.org/sqlite"
    orm "gpp/orm"
)

class Employee : orm.Model {
    Id int64
    Name string
    Email string
    DepartmentId int64
    DisplayLabel string @{orm.Ignore}
}

class Department : orm.Model {
    Id int64
    Name string
}

func main() {
    try {
        db := sql.Open("sqlite", ":memory:")
        defer db.Close()
        db.Exec(`CREATE TABLE department (id INTEGER PRIMARY KEY, name TEXT NOT NULL)`)
        db.Exec(`CREATE TABLE employee (id INTEGER PRIMARY KEY, name TEXT NOT NULL, email TEXT NOT NULL, department_id INTEGER NOT NULL)`)

        engineering := Department(Id: 1, Name: "Engineering")
        research := Department(Id: 2, Name: "Research")
        engineering.Insert(db)
        research.Insert(db)

        ada := Employee(Id: 1, Name: "Ada Lovelace", Email: "ada@example.com", DepartmentId: engineering.Id, DisplayLabel: "Ada")
        grace := Employee(Id: 2, Name: "Grace Hopper", Email: "grace@example.com", DepartmentId: research.Id, DisplayLabel: "Grace")
        ada.Insert(db)
        grace.Insert(db)

        ada.Email = "ada@analytical.example"
        ada.Update(db)

        // Model queries use conditions while SQL is built from model metadata.
        employees := Employee.Select(db, "name LIKE $1", "A%")
        target := Employee.Get(db, "id = $1", ada.Id)
        found := Employee.Find(db, ada.Id)
        fmt.Println("model queries:", len(employees), "selected, get:", target.Name)
        fmt.Println("inferred primary key:", found.Name)

        first := Employee.First(db)
        last := Employee.Last(db)
        var page []*Employee = Employee.Page(db, 1)
        fmt.Println("first/last:", first.Name, last.Name)
        if page.NotEmpty() {
            nextPage := Employee.Page(db, 1, page.Last().Id)
            fmt.Println("next page:", len(nextPage))
        }

        // A join filters ORM models by related data, beyond a model condition fragment.
        employee := orm.Get[Employee](db, `
            SELECT e.id, e.name, e.email, e.department_id
            FROM employee e
            JOIN department d ON d.id = e.department_id
            WHERE d.name = $1 AND e.id = $2`, "Research", int64(2))
        departmentEmployees := orm.Select[Employee](db, `
            SELECT e.id, e.name, e.email, e.department_id
            FROM employee e
            JOIN department d ON d.id = e.department_id
            WHERE d.name = $1
            ORDER BY e.name`, "Engineering")
        fmt.Println("full SQL model queries:", employee.Name, len(departmentEmployees))

        // Delete through the model so the ORM builds the statement from its metadata.
        target.Destroy(db)
    } catch err {
        fmt.Println("ORM example:", err)
    }
}
