// Run with `gpp run examples/todo-app.gpp`.
// The app listens on 127.0.0.1:8080, stores data in in-memory SQLite, and
// serves the web app at / and Swagger UI at /api/swagger with its OpenAPI
// document at /api/openapi.json. Todos reset when the process stops. The cron
// job removes completed todos older than 30 days and stops with the HTTP server.
package main

import (
    "context"
    "database/sql"
    "fmt"
    "log"
    stdhttp "net/http"
    "strconv"
    "time"
    _ "modernc.org/sqlite"
    cron "gpp/cron"
    http "gpp/http"
    orm "gpp/orm"
    tpl "gpp/tpl"
)

var db *sql.DB

// The ORM derives table "todo" and snake_case columns by default. The commented
// annotations show how to override those defaults.
class Todo : orm.Model /* @{orm.Table("todos")} */ {
    Id int64 /*@{orm.Column("id"), orm.PK} */
    Title string /*@{orm.Column("title")} */
    Completed bool /*@{orm.Column("completed")} */
    CreatedAt int64 /*@{orm.Column("created_at")} */
    CompletedAt int64 /*@{orm.Column("completed_at")} */

    // orm.Model hook _validate runs before inserts and updates. Collect
    // field errors here to reject invalid state before the ORM writes it.
    func _validate(exec orm.SQLExecutor) error {
        validation := orm.ValidationError()
        if this.Title.IsBlank() {
            validation.Add("title", "is required")
        }
        return validation.IsEmpty() ? nil : validation
    }

    // orm.Model hook _beforeCreate runs after validation and before the INSERT. Normalize
    // fields or set defaults here. See docs for other supported hooks.
    func _beforeCreate(exec orm.SQLExecutor) error {
        this.Title = this.Title.TrimSpace()
        return nil
    }

    func Complete(exec orm.SQLExecutor) error {
        if this.Completed {
            return nil
        }
        this.Completed = true
        this.CompletedAt = time.Now().Unix()
        return this.Update(exec)
    }

    func Activate(exec orm.SQLExecutor) error {
        this.Completed = false
        this.CompletedAt = 0
        return this.Update(exec)
    }
}

template TodoHome(todos []*Todo) @{tpl.Path("/")} {
    <!doctype html>
    <html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>GPP Todo</title>
        <style>
            body { max-width: 42rem; margin: 3rem auto; padding: 0 1rem; font: 1rem/1.5 system-ui, sans-serif; color: #20242a; }
            h1 { margin-bottom: .25rem; }
            form { display: flex; gap: .5rem; margin: 1.5rem 0; }
            input { flex: 1; padding: .65rem; font: inherit; }
            button { padding: .55rem .8rem; font: inherit; cursor: pointer; }
            li { display: flex; align-items: center; gap: .5rem; padding: .65rem 0; border-bottom: 1px solid #ddd; }
            .actions { display: flex; gap: .5rem; margin-left: auto; }
            .actions form { margin: 0; }
            .done { color: #667; text-decoration: line-through; }
            footer { margin-top: 2rem; color: #667; }
        </style>
    </head>
    <body>
        <h1>GPP Todo</h1>
        <p>A server-rendered todo list backed by SQLite.</p>
        <form method="post" action="/todos">
            <input name="title" placeholder="What needs doing?" required>
            <button type="submit">Add todo</button>
        </form>
        <ul>
            {{range .}}
            <li>
                <span class="{{if .Completed}}done{{end}}">{{.Title}}</span>
                <div class="actions">
                    {{if .Completed}}
                    <form method="post" action="/todos/{{.Id}}/reopen">
                        <button type="submit">Reopen</button>
                    </form>
                    {{else}}
                    <form method="post" action="/todos/{{.Id}}/complete">
                        <button type="submit">Complete</button>
                    </form>
                    {{end}}
                    <form method="post" action="/todos/{{.Id}}/delete">
                        <button type="submit">Remove</button>
                    </form>
                </div>
            </li>
            {{else}}
            <li>Your list is empty. Add a todo above.</li>
            {{end}}
        </ul>
        <footer>JSON API and interactive docs: <a href="/api/swagger">Swagger UI</a></footer>
    </body>
    </html>
}

extend *sql.DB, *sql.Tx {
    func Todos() ([]*Todo, error) {
        return Todo.All(this)
    }

    func CompletedTodos() ([]*Todo, error) {
        return Todo.Select(this, "completed = $1", true)
    }

    func FindTodo(id int64) (*Todo, error) {
        return Todo.Get(this, "id = $1", id)
    }

    func CreateTodo(todo *Todo) error {
        return todo.Insert(this)
    }
}

func PruneCompletedTodos(ctx context.Context) error @{cron.Every(time.Minute)} {
    if ctx.Err() != nil {
        return ctx.Err()
    }
    if db == nil {
        return nil
    }
    cutoff := time.Now().Add(-30 * 24 * time.Hour).Unix()
    todos := Todo.Select(db, "completed = $1 AND completed_at < $2 AND completed_at > 0", true, cutoff)

    todos.Each(todo => todo.Destroy(db))
    if todos.Any() {
        log.Printf("todo-app: pruned %d completed todos", len(todos))
    }
    return nil
}

class TodoApp : http.Server @{
    http.IP("127.0.0.1"),
    http.OpenAPI("/api/openapi.json"),
    http.Swagger("/api/swagger")
} {
    func Home(ctx *http.Context) error @{ http.GET("/")} {
        todos := db.Todos()
        return ctx.HTML(200, todos)
    }

    func CreateTodoFromForm(ctx *http.Context) error @{
        http.POST("/todos")
    } {
        ctx.Request.ParseForm()
        title := ctx.Request.FormValue("title")
        todo := Todo(Id: time.Now().UnixNano(), Title: title, Completed: false, CreatedAt: time.Now().Unix())
        try {
            db.CreateTodo(todo)
        } catch orm.ValidationError err {
            log.Printf("todo-app: reject todo: %v", err)
            ctx.Redirect("/", 303)
            return nil
        }
        ctx.Redirect("/", 303)
        return nil
    }

    func CompleteTodoFromForm(ctx *http.Context) error @{
        http.POST("/todos/{id}/complete")
    } {
        try {
            id := ctx.Param("id").ToInt64()
            todo := db.FindTodo(id)
            todo.Complete(db)
        } catch strconv.NumError, sql.ErrNoRows {
            ctx.Redirect("/", 303)
            return nil
        }
        ctx.Redirect("/", 303)
        return nil
    }

    func DeleteTodoFromForm(ctx *http.Context) error @{
        http.POST("/todos/{id}/delete")
    } {
        try {
            id := ctx.Param("id").ToInt64()
            todo := db.FindTodo(id)
            todo.Destroy(db)
        } catch strconv.NumError, sql.ErrNoRows {
            ctx.Redirect("/", 303)
            return nil
        }
        ctx.Redirect("/", 303)
        return nil
    }

    func ReopenTodoFromForm(ctx *http.Context) error @{
        http.POST("/todos/{id}/reopen")
    } {
        try {
            id := ctx.Param("id").ToInt64()
            todo := db.FindTodo(id)
            todo.Activate(db)
        } catch strconv.NumError, sql.ErrNoRows {
            ctx.Redirect("/", 303)
            return nil
        }
        ctx.Redirect("/", 303)
        return nil
    }

    func ListTodos(ctx *http.Context) error @{
        http.GET("/api/todos"),
        http.Summary("List todos"),
        http.Description("Returns every todo, including its completion state and timestamps."),
        http.Tags("Todos"),
        http.ResponseBody(200, "Todo list", "application/json", struct(Items: []Todo{}))
    } {
        todos := db.Todos()
        return ctx.JSON(struct(Items: todos))
    }

    func CompletedTodos(ctx *http.Context) error @{
        http.GET("/api/todos/completed"),
        http.Summary("List completed todos"),
        http.Description("Returns todos that have been marked complete."),
        http.Tags("Todos"),
        http.ResponseBody(200, "Completed todo list", "application/json", struct(Items: []*Todo{Todo(Id: 1, Title: "Write the next GPP example", Completed: true, CreatedAt: 1735689600, CompletedAt: 1735689700)}))
    } {
        todos := db.CompletedTodos()
        return ctx.JSON(struct(Items: todos))
    }

    func CreateTodo(ctx *http.Context) error @{
        http.POST("/api/todos"),
        http.Summary("Create a todo"),
        http.Description("Creates a todo from a JSON title and returns the stored record."),
        http.Tags("Todos"),
        http.RequestBody("application/json", "The todo title to create", struct(Title: "Write the next GPP example")),
        http.ResponseBody(201, "Todo created", "application/json", struct(Id: 1, Title: "Write the next GPP example", Completed: false, CreatedAt: 1735689600, CompletedAt: 0)),
        http.ResponseBody(400, "The request body is invalid or validation failed", "application/json", struct(Error: "validation failed", FieldErrors: map[string][]string{})),
        http.ResponseBody(500, "The todo could not be saved", "application/json", struct(Error: "could not save todo"))
    } {
        try {
            request := ctx.Bind[struct{ Title string }]()
            todo := Todo(Id: time.Now().UnixNano(), Title: request.Title, Completed: false, CreatedAt: time.Now().Unix())
            db.CreateTodo(todo)
            return ctx.JSON(201, todo)
        } catch orm.ValidationError err {
            var fieldErrors map[string][]string
            fieldErrors = err.Errors
            return ctx.JSON(400, struct(Error: "validation failed", FieldErrors: fieldErrors))
        } catch http.BindError err {
            log.Printf("todo-app: bind create todo: %v", err)
            return ctx.JSON(400, struct(Error: "invalid JSON request body"))
        } catch err {
            log.Printf("todo-app: save todo: %v", err)
            return ctx.JSON(500, struct(Error: "could not save todo"))
        }
    }

    func GetTodo(ctx *http.Context) error @{
        http.GET("/api/todos/{id}"),
        http.Summary("Get a todo"),
        http.Description("Returns one todo by its numeric ID."),
        http.Tags("Todos"),
        http.ResponseBody(200, "Todo found", "application/json", struct(Id: 1, Title: "Write the next GPP example", Completed: false, CreatedAt: 1735689600, CompletedAt: 0)),
        http.ResponseBody(400, "The ID is not a number", "application/json", struct(Error: "invalid todo ID")),
        http.ResponseBody(404, "No todo has this ID", "application/json", struct(Error: "todo not found"))
    } {
        try {
            id := ctx.Param("id").ToInt64()
            todo := db.FindTodo(id)
            return ctx.JSON(todo)
        } catch strconv.NumError {
            return ctx.JSON(400, struct(Error: "invalid todo ID"))
        } catch sql.ErrNoRows {
            return ctx.JSON(404, struct(Error: "todo not found"))
        }
    }

    func CompleteTodo(ctx *http.Context) error @{
        http.PUT("/api/todos/{id}/complete"),
        http.Summary("Complete a todo"),
        http.Description("Marks a todo complete and records when it was completed."),
        http.Tags("Todos"),
        http.ResponseBody(200, "Todo completed", "application/json", struct(Id: 1, Title: "Write the next GPP example", Completed: true, CreatedAt: 1735689600, CompletedAt: 1735689700)),
        http.ResponseBody(400, "The ID is not a number", "application/json", struct(Error: "invalid todo ID")),
        http.ResponseBody(404, "No todo has this ID", "application/json", struct(Error: "todo not found"))
    } {
        try {
            id := ctx.Param("id").ToInt64()
            todo := db.FindTodo(id)
            todo.Complete(db)
            return ctx.JSON(todo)
        } catch strconv.NumError {
            return ctx.JSON(400, struct(Error: "invalid todo ID"))
        } catch sql.ErrNoRows {
            return ctx.JSON(404, struct(Error: "todo not found"))
        }
    }

    func ReopenTodo(ctx *http.Context) error @{
        http.DELETE("/api/todos/{id}/complete"),
        http.Summary("Reopen a todo"),
        http.Description("Clears a todo's completion state and completion timestamp."),
        http.Tags("Todos"),
        http.ResponseBody(200, "Todo reopened", "application/json", struct(Id: 1, Title: "Write the next GPP example", Completed: false, CreatedAt: 1735689600, CompletedAt: 0)),
        http.ResponseBody(400, "The ID is not a number", "application/json", struct(Error: "invalid todo ID")),
        http.ResponseBody(404, "No todo has this ID", "application/json", struct(Error: "todo not found"))
    } {
        try {
            id := ctx.Param("id").ToInt64()
            todo := db.FindTodo(id)
            todo.Activate(db)
            return ctx.JSON(todo)
        } catch strconv.NumError {
            return ctx.JSON(400, struct(Error: "invalid todo ID"))
        } catch sql.ErrNoRows {
            return ctx.JSON(404, struct(Error: "todo not found"))
        }
    }

    func DeleteTodo(ctx *http.Context) error @{
        http.DELETE("/api/todos/{id}"),
        http.Summary("Delete a todo"),
        http.Description("Permanently removes a todo by its numeric ID."),
        http.Tags("Todos"),
        http.ResponseBody(204, "Todo deleted", "", nil),
        http.ResponseBody(400, "The ID is not a number", "application/json", struct(Error: "invalid todo ID")),
        http.ResponseBody(404, "No todo has this ID", "application/json", struct(Error: "todo not found"))
    } {
        try {
            id := ctx.Param("id").ToInt64()
            todo := db.FindTodo(id)
            todo.Destroy(db)
        } catch strconv.NumError {
            return ctx.JSON(400, struct(Error: "invalid todo ID"))
        } catch sql.ErrNoRows {
            return ctx.JSON(404, struct(Error: "todo not found"))
        }
        return ctx.Text(204, "")
    }

    func _beforeShutdown() error {
        ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
        defer cancel()
        try {
            cron.StopWithContext(ctx)
        } catch err {
            log.Println("todo-app: stop cron:", err)
        }
        if db != nil {
            try {
                db.Close()
            } catch err {
                log.Println("todo-app: close database:", err)
            }
        }
        return nil
    }
}

func main() {
    try {
        db = sql.Open("sqlite", ":memory:")
        db.SetMaxOpenConns(1)
        db.SetMaxIdleConns(1)
        db.Exec(`
			CREATE TABLE IF NOT EXISTS todo (
				id INTEGER PRIMARY KEY,
				title TEXT NOT NULL,
				completed BOOLEAN NOT NULL DEFAULT FALSE,
				created_at INTEGER NOT NULL DEFAULT 0,
				completed_at INTEGER NOT NULL DEFAULT 0
			)
        `)
        cron.Start()
        log.Println("todo-app: cleanup job scheduled")
        app := TodoApp()
        app.Listen(8080)
    } catch err {
        fmt.Println("todo app:", err)
    }
}
