// Run with `gpp run examples/sql.gpp`.
// This example uses full-SQL queries directly through gpp/sql, without ORM models.
package main

import (
    "context"
    "database/sql"
    "fmt"
    _ "modernc.org/sqlite"
    gppsql "gpp/sql"
)

struct Person {
    Id int64
    Name string
}

func addPerson(exec gppsql.Executor, person Person) {
    exec.Exec("INSERT INTO people (id, name) VALUES ($1, $2)", person.Id, person.Name)
}

func main() {
    try {
        db := sql.Open("sqlite", ":memory:")
        defer db.Close()
        db.Exec("CREATE TABLE people (id INTEGER PRIMARY KEY, name TEXT NOT NULL)")

        addPerson(db, Person(Id: 1, Name: "Ada"))
        tx := db.BeginTx(context.Background(), nil)
        defer tx.Rollback()
        addPerson(tx, Person(Id: 2, Name: "Grace"))
        tx.Commit()

        ada := db.Get[Person]("SELECT id, name FROM people WHERE id = $1", int64(1))
        fmt.Printf("person: %d %s\n", ada.Id, ada.Name)

        people := db.Select[Person]("SELECT id, name FROM people ORDER BY id")
        fmt.Println("people:")
        people.Each(person => { fmt.Printf("  %d %s\n", person.Id, person.Name) })

        peopleWithDate := db.Select[struct(Id: int64, Name: string, CreatedAt: string)](
            "SELECT id, name, date('now') AS created_at FROM people ORDER BY id",
        )
        fmt.Println("people with query date:")
        peopleWithDate.Each(person => {
                fmt.Printf("  ID=%d, Name=%s, CreatedAt=%s\n", person.Id, person.Name, person.CreatedAt)
        })

        count := db.Get[int64]("SELECT COUNT(*) FROM people")
        fmt.Println("rows:", count)
    } catch err {
        fmt.Println("SQL example:", err)
    }
}
